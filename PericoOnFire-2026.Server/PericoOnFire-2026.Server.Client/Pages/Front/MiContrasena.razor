@* "Mi contraseña": cualquier usuario logueado puede ver su contraseña actual y cambiarla. *@
@using PericoOnFire_2026.Servicio.ServicioHttp
@using PericoOnFire_2026.Shared.DTOs
@inject IHttpServicio http

<section class="mi-clave" aria-label="Mi contraseña">
    <h3>Mi contraseña</h3>

    <div class="mi-clave-tarjeta">
        <label>Contraseña actual</label>
        <div class="mi-clave-actual">
            <span class="mi-clave-valor">
                @if (visible && valorActual != null)
                {
                    @valorActual
                }
                else
                {
                    <text>••••••••</text>
                }
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@cargandoVer"
                    @onclick="AlternarVisible">
                <i class="bi @(visible ? "bi-eye-slash" : "bi-eye")"></i>
                @(visible ? "Ocultar" : "Ver")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(avisoVer))
        {
            <small class="text-muted" role="status">@avisoVer</small>
        }
    </div>

    <div class="mi-clave-tarjeta">
        <label>Cambiar contraseña</label>

        <input type="@tipoCampo" class="form-control" autocomplete="current-password"
               placeholder="Contraseña actual" @bind="actual" @bind:event="oninput" />
        <input type="@tipoCampo" class="form-control" autocomplete="new-password"
               placeholder="Contraseña nueva" @bind="nueva" @bind:event="oninput" />
        <input type="@tipoCampo" class="form-control" autocomplete="new-password"
               placeholder="Repetir contraseña nueva" @bind="repetir" @bind:event="oninput" />

        <label class="mi-clave-mostrar">
            <input type="checkbox" @bind="mostrarCampos" /> Mostrar lo que escribo
        </label>

        <button type="button" class="btn btn-danger" disabled="@guardando" @onclick="Cambiar">
            @(guardando ? "Guardando…" : "Cambiar contraseña")
        </button>

        @if (!string.IsNullOrEmpty(exito))
        {
            <div class="alert alert-success mb-0 py-2" role="status">@exito</div>
        }
        @if (errores.Count > 0)
        {
            <div class="alert alert-danger mb-0 py-2" role="alert">
                <ul class="mb-0 ps-3">
                    @foreach (var e in errores)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }
    </div>
</section>

<style>
    .mi-clave {
        padding: 1.2rem;
        background: #fff;
        border-radius: 12px;
        max-width: 750px;
        margin: 1rem auto;
        display: flex;
        flex-direction: column;
        gap: .9rem;
    }

        .mi-clave h3 {
            font-weight: 800;
            margin: 0;
        }

    .mi-clave-tarjeta {
        display: flex;
        flex-direction: column;
        gap: .6rem;
        padding: 1rem;
        background: #f7f8fa;
        border: 1px solid #ddd;
        border-radius: 10px;
    }

        .mi-clave-tarjeta > label {
            font-weight: 600;
        }

        .mi-clave-tarjeta .btn {
            align-self: flex-start;
        }

    .mi-clave-actual {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .mi-clave-valor {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 1.05rem;
        word-break: break-all;
    }

    .mi-clave-tarjeta .mi-clave-mostrar {
        font-weight: 400;
        font-size: .9rem;
        color: #555;
    }
</style>

@code {
    private bool visible;
    private bool cargandoVer;
    private string? valorActual;
    private string avisoVer = "";

    private string actual = "";
    private string nueva = "";
    private string repetir = "";
    private bool mostrarCampos;
    private bool guardando;
    private string exito = "";
    private List<string> errores = new();

    private string tipoCampo => mostrarCampos ? "text" : "password";

    private async Task AlternarVisible()
    {
        avisoVer = "";
        if (visible) { visible = false; return; }

        // Se pide al servidor solo cuando el usuario lo quiere ver
        if (valorActual == null)
        {
            cargandoVer = true;
            var resp = await http.Get<ContrasenaVisibleDTO>("api/seguridad/mi-contrasena");
            cargandoVer = false;

            if (resp.Error || resp.Respuesta == null)
            {
                avisoVer = resp.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "Tu contraseña todavía no está guardada para mostrarla. Cambiala una vez y la vas a poder ver acá."
                    : resp.ObtenerError();
                return;
            }
            valorActual = resp.Respuesta.Contrasena;
        }
        visible = true;
    }

    private async Task Cambiar()
    {
        exito = "";
        errores = new();

        if (string.IsNullOrWhiteSpace(actual)) errores.Add("Ingresá tu contraseña actual.");
        if (string.IsNullOrWhiteSpace(nueva) || nueva.Length < 6) errores.Add("La contraseña nueva debe tener al menos 6 caracteres.");
        if (nueva != repetir) errores.Add("La contraseña nueva y su repetición no coinciden.");
        if (errores.Count > 0) return;

        guardando = true;
        var dto = new CambiarMiContrasenaDTO { ContrasenaActual = actual, ContrasenaNueva = nueva };
        var resp = await http.Post<CambiarMiContrasenaDTO>("api/seguridad/cambiar-mi-contrasena", dto);
        guardando = false;

        if (resp.Error)
        {
            errores = await LeerErrores(resp.HttpResponseMessage, resp.ObtenerError());
            return;
        }

        exito = "Contraseña cambiada correctamente.";
        valorActual = nueva;
        avisoVer = "";
        actual = nueva = repetir = "";
    }

    private async Task<List<string>> LeerErrores(HttpResponseMessage respuesta, string porDefecto)
    {
        try
        {
            var crudo = await http.ObtenerMensajeError(respuesta);
            var obj = System.Text.Json.JsonSerializer.Deserialize<ErroresResponse>(
                crudo, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (obj?.Errores != null && obj.Errores.Count > 0)
                return obj.Errores;
            return new List<string> { string.IsNullOrWhiteSpace(crudo) ? porDefecto : crudo };
        }
        catch
        {
            return new List<string> { porDefecto };
        }
    }

    private class ErroresResponse
    {
        public List<string> Errores { get; set; } = new();
    }
}
