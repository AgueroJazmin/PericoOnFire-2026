                await EnviarPedidoAdicional();
        }
        catch (System.Net.Http.HttpRequestException) { MensajeModal = "No se pudo confirmar el envío. Revisá los pedidos de la mesa antes de volver a enviar."; }
        finally
        {
            enviandoPedido = false;
        }
    }

    private async Task ConfirmarNuevaComanda()
    {
        if (mesaSeleccionada == null || idUsuarioActual == null) return;

        var numeroMesa = mesaSeleccionada.NumeroMesa;
        var dto = new ConfirmarComandaDTO
        {
            IdMesa = mesaSeleccionada.Id,
            IdUsuario = idUsuarioActual.Value,
            CantidadComensales = cantidadComensales,
            Items = carrito
        };

        var respuesta = await http.Post<ConfirmarComandaDTO, ComandaConfirmadaDTO>("api/Comanda/Confirmar", dto);
        if (respuesta.Error || respuesta.Respuesta == null)
        {
            MensajeModal = respuesta.ObtenerError();
            return;
        }

        mostrarModalPedido = false;
        carrito = new();
        await CargarMesas();
        var mesaActualizada = mesas.FirstOrDefault(m => m.NumeroMesa == numeroMesa);
        if (mesaActualizada != null)
            await SeleccionarMesa(mesaActualizada);

        Mensaje = $"Comanda {respuesta.Respuesta.NumeroComanda} enviada correctamente a cocina/barra.";
    }

    private async Task EnviarPedidoAdicional()
    {
        if (comandaActual == null || !carrito.Any()) return;

        var dto = new CargarPedidoDTO
        {
            IdComanda = comandaActual.Id,
            Items = carrito
        };

        var respuesta = await http.Post<CargarPedidoDTO, List<int>>("api/Pedido/CargarItems", dto);
        if (respuesta.Error)
        {
            MensajeModal = respuesta.ObtenerError();
            return;
        }

        mostrarModalPedido = false;
        carrito = new();
        await CargarPedidos();
        Mensaje = $"Pedido agregado a la comanda {comandaActual.NumeroComanda}.";
    }

    private void PedirCancelarMesa()
    {
        tituloConfirmacion = "Cancelar mesa";
        mensajeConfirmacion = $"¿Cancelar la apertura de la mesa {mesaSeleccionada?.NumeroMesa}? Todavía no se cargó ningún pedido.";
        accionConfirmada = CancelarMesa;
        confirmacion?.Ver();
    }

    private void PedirCerrarMesa()
    {
        tituloConfirmacion = "Cerrar mesa";
        mensajeConfirmacion = $"¿Cerrar la mesa {mesaSeleccionada?.NumeroMesa}? Pasa a pendiente de cobro y no se van a poder agregar más pedidos.";
        accionConfirmada = CerrarMesa;
        confirmacion?.Ver();
    }

    private async Task EjecutarConfirmacion()
    {
        confirmacion?.Ocultar();
        if (accionConfirmada != null)
            await accionConfirmada();
    }

    private async Task CancelarMesa()
    {
        if (comandaActual == null) return;

        var resp = await http.Put($"api/Comanda/{comandaActual.Id}/Cancelar", new { });
        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            return;
        }

        await CargarMesas();
        CerrarPanel();
    }

    private async Task CerrarMesa()
    {
        if (comandaActual == null) return;

        var resp = await http.Put($"api/Comanda/{comandaActual.Id}/Cerrar", new { });
        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            return;
        }

        await CargarMesas();
        CerrarPanel();
    }

    private void CerrarPanel()
    {
        mostrarModalPedido = false;
        mesaSeleccionada = null;
        comandaActual = null;
    }

    public async ValueTask DisposeAsync()
    {
        Polling.ConexionCambiada -= ConexionCambiada;
        await Polling.DisposeAsync();
    }
}
