@page "/comandas"
@using Microsoft.AspNetCore.Authorization
@using PericoOnFire_2026.Shared.DTOs
@using PericoOnFire_2026.Shared.ENUM
@using PericoOnFire_2026.Servicio.ServicioHttp
@using PericoOnFire_2026.Server.Client.Shared
@implements IAsyncDisposable
@inject PericoOnFire_2026.Shared.SerPolling.PollingService Polling
@inject IHttpServicio http
@rendermode InteractiveAuto
@attribute [Authorize(Roles = "Mozo,Administracion")]

<main class="perico-main">

    <section class="salon salon-izq">
        <div class="salon-inner">
            @foreach (var numero in numerosIzquierda)
            {
                @RenderMesa(numero)
            }
        </div>
    </section>

    <section class="salon salon-der">
        <div class="salon-inner">
            <img src="img/perico-pizza.jpg" class="perico-img" />

            @foreach (var numero in numerosDerecha)
            {
                @RenderMesa(numero)
            }
        </div>
    </section>

</main>

@if (mesaSeleccionada != null)
{
    <aside class="panel-mesa">
        <div class="panel-header">
            <h5>Mesa @mesaSeleccionada.NumeroMesa</h5>
            <button class="btn-cerrar" @onclick="CerrarPanel">&times;</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="alert alert-info">@Mensaje</div>
        }

        @if (cargandoPanel)
        {
            <p>Cargando...</p>
        }
        else if (comandaActual == null)
        {
            <div class="panel-body">
                <p>La mesa está libre.</p>
                <button class="btn btn-primary" @onclick="AbrirMesa">
                    Abrir mesa
                </button>
            </div>
        }
        else
        {
            <div class="panel-body">

                <h6>Pedidos enviados</h6>
                @if (!pedidosActuales.Any())
                {
                    <p class="texto-vacio">Todavía no se envió nada a cocina/barra.</p>
                }
                else
                {
                    @foreach (var grupo in pedidosActuales.GroupBy(p => p.SectorDestino))
                    {
                        <div class="grupo-sector">
                            <strong>@grupo.Key</strong>
                            @foreach (var pedido in grupo)
                            {
                                <div class="pedido-card">
                                    <span class="pedido-estado">@pedido.Estado</span>
                                    <ul>
                                        @foreach (var detalle in pedido.DetallesPedido)
                                        {
                                            <li>@detalle.Cantidad x @detalle.NombreProducto</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                }

                @if (comandaActual.Estado == EnumEstadoComanda.PendienteCobro)
                {
                    <hr />
                    <p class="texto-vacio">Mesa cerrada, pendiente de cobro. El cobro se hace desde Caja.</p>
                }
                else
                {
                    <hr />

                    <h6>Agregar ítems</h6>
                    <select class="form-select" @bind="idProductoSeleccionado">
                        <option value="0">Seleccioná un producto...</option>
                        @foreach (var cat in productos.GroupBy(p => p.NombreCategoria))
                        {
                            <optgroup label="@cat.Key">
                                @foreach (var prod in cat)
                                {
                                    <option value="@prod.Id">@prod.Nombre - $@prod.Precio</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <button class="btn btn-sm btn-secondary mt-2" @onclick="AgregarAlCarrito">
                        Agregar
                    </button>

                    @if (carrito.Any())
                    {
                        <ul class="carrito-lista">
                            @foreach (var item in carrito)
                            {
                                <li>
                                    @item.Cantidad x @NombreProducto(item.IdProducto)
                                    <button class="btn-quitar" @onclick="() => QuitarDelCarrito(item)">x</button>
                                </li>
                            }
                        </ul>

                        <button class="btn btn-success w-100 mb-2" @onclick="EnviarPedido">
                            Enviar a cocina/barra
                        </button>
                    }

                    <hr />

                    @if (!pedidosActuales.Any())
                    {
                        <button class="btn btn-outline-danger w-100" @onclick="PedirCancelarMesa">
                            Cancelar mesa (abierta por error)
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-dark w-100" @onclick="PedirCerrarMesa">
                            Cerrar mesa (consumo final)
                        </button>
                    }
                }
            </div>
        }

        <Confirmacion @ref="confirmacion"
                      Titulo="@tituloConfirmacion"
                      textOk="Sí, continuar"
                      textCancelar="Volver"
                      onConfirm="EjecutarConfirmacion"
                      onCancel="() => confirmacion!.Ocultar()">
            <p>@mensajeConfirmacion</p>
        </Confirmacion>
    </aside>
}

