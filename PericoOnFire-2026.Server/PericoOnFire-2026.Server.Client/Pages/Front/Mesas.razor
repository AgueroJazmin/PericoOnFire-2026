@code {
    private bool sinConexion;
    private void ConexionCambiada(bool error) { sinConexion = error; _ = InvokeAsync(StateHasChanged); }

    private bool cargandoInicial = true;
    private List<MesaDTO> mesas = new();
    private List<SalaDTO> salas = new();
    // En celular se muestra un sector por vez; escritorio conserva todas las salas.
    private int? salaMovilId;
    private int? SalaMovilActivaId => salaMovilId.HasValue && salas.Any(s => s.Id == salaMovilId)
        ? salaMovilId : salas.OrderBy(s => s.Orden).Select(s => (int?)s.Id).FirstOrDefault();
    private List<ProductoListadoDTO> productos = new();

    private MesaDTO? mesaSeleccionada;
    private ComandaDTO? comandaActual;
    private List<PedidoDTO> pedidosActuales = new();
    private List<ItemPedidoDTO> carrito = new();

    private int? idUsuarioActual;
    private bool cargandoPanel;
    private string? Mensaje;
    private string? MensajeModal;
    private bool mostrarModalPedido;
    private bool esNuevaComanda;
    private List<int> idsPedidosEditando = new();
    private List<DetallePedidoDTO> detallesAntesDeEditar = new();
    private bool enviandoPedido;
    private int cantidadComensales = 1;
    private string categoriaSeleccionada = "";
    private string subcategoriaSeleccionada = "";
    private ItemPedidoDTO? itemEditandoObservacion;
    private string textoObservacion = "";
    private Confirmacion? confirmacion;
    private string tituloConfirmacion = "";
    private string mensajeConfirmacion = "";
    private Func<Task>? accionConfirmada;

    protected override async Task OnInitializedAsync()
    {
        // Las llamadas autenticadas usan la cookie del navegador.
        // El prerenderizado del servidor solo prepara la vista y la sesión.
        if (!OperatingSystem.IsBrowser()) return;
        Polling.ConexionCambiada += ConexionCambiada;

        try
        {
            await CargarMesas();
            await CargarSalas();
            await CargarProductos();
            await CargarUsuarioActual();
    

        }
        catch (System.Net.Http.HttpRequestException) { sinConexion = true; }
        finally { cargandoInicial = false; Polling.Iniciar(ActualizarPanel, TimeSpan.FromSeconds(2)); }
    }

    private async Task CargarSalas()
    {
        var resp = await http.Get<List<SalaDTO>>("api/Sala");
        if (!resp.Error && resp.Respuesta != null)
        {
            salas = resp.Respuesta;
        }
    }

    // Refresca el estado de las mesas y, si hay un panel abierto, también sus pedidos,
    // para que el mozo vea al toque si cocina/barra cancela o termina algo.
    private async Task ActualizarPanel()
    {
        if (!salas.Any()) await CargarSalas();
        if (!productos.Any()) await CargarProductos();
        if (idUsuarioActual == null) await CargarUsuarioActual();
        await CargarMesas();
        if (comandaActual != null)
        {
            await CargarPedidos();
            await InvokeAsync(StateHasChanged);
        }
    }

    private RenderFragment RenderMesa(MesaDTO mesa) => @<text>
        <button class="mesa forma-@mesa.Forma.ToString().ToLower() tamanio-@mesa.Tamanio.ToString().ToLower() estado-@mesa.Estado"
                title="@mesa.Estado.ToString()"
                @onclick="@(() => SeleccionarMesa(mesa))">
            <span class="numero-mesa">
                <span class="valor-numero-mesa">@mesa.NumeroMesa</span>
                <small class="mesa-estado-texto">@(mesa.Estado == EnumEstadoMesa.PendienteCobro ? "A cobrar" : mesa.Estado.ToString())</small>
            </span>
            @if (mesa.TienePedidoListo)
            {
                <span class="badge-notif" title="Pedido listo para retirar" aria-label="Pedido listo">✓</span>
            }
            @if (mesa.TienePedidoCancelado)
            {
                <span class="badge-cancelado" title="Hay un pedido cancelado por cocina/barra">!</span>
            }
        </button>
    </text>;

    private string NombreProducto(int idProducto) =>
        productos.FirstOrDefault(p => p.Id == idProducto)?.Nombre ?? "";

    private IEnumerable<string> CategoriasDisponibles => productos
        .Select(p => p.NombreCategoria)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(OrdenCategoria)
        .ThenBy(n => n);

    private static int OrdenCategoria(string categoria)
    {
        var nombre = categoria.ToLowerInvariant();
        if (nombre.Contains("comida")) return 1;
        if (nombre.Contains("bebida")) return 2;
        if (nombre.Contains("postre")) return 3;
        return 4;
    }

    private IEnumerable<string> SubcategoriasDisponibles => productos
        .Where(p => p.NombreCategoria == categoriaSeleccionada)
        .Select(p => p.NombreSubcategoria)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(n => n);

    private string busquedaProducto = "";
    private IEnumerable<ProductoListadoDTO> ProductosVisibles => productos
        .Where(p => string.IsNullOrWhiteSpace(busquedaProducto)
            ? p.NombreCategoria == categoriaSeleccionada && p.NombreSubcategoria == subcategoriaSeleccionada
            : System.Globalization.CultureInfo.GetCultureInfo("es-AR").CompareInfo.IndexOf(
                p.Nombre ?? "", busquedaProducto.Trim(),
                System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0)
        .OrderBy(p => p.Nombre);

    private int CantidadTotalItems => carrito.Sum(i => i.Cantidad);

    private decimal TotalCarrito => carrito.Sum(i =>
        (idsPedidosEditando.Any()
            ? detallesAntesDeEditar.FirstOrDefault(d => d.IdProducto == i.IdProducto)?.PrecioUnitario ?? productos.FirstOrDefault(p => p.Id == i.IdProducto)?.Precio ?? 0
            : productos.FirstOrDefault(p => p.Id == i.IdProducto)?.Precio ?? 0) * i.Cantidad);

    // La mesa solo se puede cerrar cuando ningún pedido quedó pendiente, en preparación
    // o listo sin retirar; los cancelados no cuentan porque ya no van a llegar a la mesa.
    private bool HayPedidosSinEntregar => pedidosActuales.Any(p =>
        p.Estado != EnumEstadoPedido.Entregado && p.Estado != EnumEstadoPedido.Cancelado);

    private async Task CargarMesas()
    {
        var respuesta = await http.Get<List<MesaDTO>>("api/Mesa");
        if (respuesta.Error) throw new System.Net.Http.HttpRequestException("No se pudo actualizar la información.");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            mesas = respuesta.Respuesta;
            if (mesaSeleccionada != null)
            {
                var actualizada = mesas.FirstOrDefault(m => m.Id == mesaSeleccionada.Id);
                if (actualizada != null) mesaSeleccionada = actualizada;
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CargarProductos()
    {
        var respuesta = await http.Get<List<ProductoListadoDTO>>("api/Producto");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            productos = respuesta.Respuesta.Where(p => p.Activo).ToList();
        }
    }

    private async Task CargarUsuarioActual()
    {
        var respuesta = await http.Get<int>("api/Usuario/Actual");
        if (!respuesta.Error)
        {
            idUsuarioActual = respuesta.Respuesta;
        }
    }

    private async Task SeleccionarMesa(MesaDTO mesa)
    {
        mesaSeleccionada = mesa;
        comandaActual = null;
        pedidosActuales = new();
        carrito = new();
        Mensaje = null;
        cargandoPanel = true;

        if (mesa.Estado != EnumEstadoMesa.Libre)
        {
            var respuesta = await http.Get<ComandaDTO>($"api/Comanda/Mesa/{mesa.Id}");
            if (!respuesta.Error && respuesta.Respuesta != null)
            {
                comandaActual = respuesta.Respuesta;
                await CargarPedidos();
            }
            else if (respuesta.Error)
            {
                Mensaje = respuesta.ObtenerError();
            }
        }

        cargandoPanel = false;
    }

    private async Task CargarPedidos()
    {
        if (comandaActual == null) return;

        var respuesta = await http.Get<List<PedidoDTO>>($"api/Pedido/Comanda/{comandaActual.Id}");
        if (respuesta.Error) throw new System.Net.Http.HttpRequestException("No se pudo actualizar la información.");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            pedidosActuales = respuesta.Respuesta;
        }
    }

    private async Task MarcarEntregado(PedidoDTO pedido)
    {
        var dto = new CambiarEstadoPedidoDTO { Estado = EnumEstadoPedido.Entregado };
        var respuesta = await http.Put($"api/Pedido/{pedido.Id}/Estado", dto);

        if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
            return;
        }

        await CargarPedidos();
        await CargarMesas();
    }

    private async Task EliminarPedidoCancelado(PedidoDTO pedido)
    {
        var respuesta = await http.Delete($"api/Pedido/{pedido.Id}");

        if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
            return;
        }

        await CargarPedidos();
        await CargarMesas();
    }

    private void AbrirModalNuevaComanda()
    {
        if (mesaSeleccionada == null || idUsuarioActual == null)
        {
            Mensaje = "No se pudo identificar al usuario logueado.";
            return;
        }

        esNuevaComanda = true;
        cantidadComensales = 1;
        AbrirModalPedido();
    }

    private void AbrirModalPedidoAdicional()
    {
        esNuevaComanda = false;
        AbrirModalPedido();
    }

    private void AbrirModalPedido()
    {
        idsPedidosEditando = new();
        detallesAntesDeEditar = new();
        carrito = new();
        CancelarObservacion();
        MensajeModal = null;
        busquedaProducto = "";
        categoriaSeleccionada = CategoriasDisponibles.FirstOrDefault() ?? "";
        subcategoriaSeleccionada = SubcategoriasDisponibles.FirstOrDefault() ?? "";
        mostrarModalPedido = true;
    }

    private void CerrarModalPedido()
    {
        if (enviandoPedido) return;
        mostrarModalPedido = false;
        carrito = new();
        CancelarObservacion();
        MensajeModal = null;
    }

    private void SeleccionarCategoria(string categoria)
    {
        busquedaProducto = "";
        categoriaSeleccionada = categoria;
        subcategoriaSeleccionada = SubcategoriasDisponibles.FirstOrDefault() ?? "";
    }

    private string IconoCategoria(string categoria)
    {
        var nombre = categoria.ToLowerInvariant();
        if (nombre.Contains("bebida")) return "🥤";
        if (nombre.Contains("postre")) return "🍰";
        if (nombre.Contains("café") || nombre.Contains("cafe")) return "☕";
        return "🍔";
    }

    private int CantidadProducto(int idProducto) =>
        carrito.Where(c => c.IdProducto == idProducto).Sum(c => c.Cantidad);

    private void AumentarProducto(int idProducto)
    {
        var existente = carrito.FirstOrDefault(c => c.IdProducto == idProducto);

        if (existente != null)
        {
            existente.Cantidad++;
        }
        else
        {
            carrito.Add(new ItemPedidoDTO
            {
                IdProducto = idProducto,
                Cantidad = 1
            });
        }
    }

    private void DisminuirProducto(int idProducto)
    {
        var existente = carrito.FirstOrDefault(c => c.IdProducto == idProducto);
        if (existente == null) return;

        existente.Cantidad--;
        if (existente.Cantidad <= 0)
            carrito.Remove(existente);
    }

    private void QuitarDelCarrito(ItemPedidoDTO item)
    {
        if (ReferenceEquals(itemEditandoObservacion, item))
            CancelarObservacion();

        carrito.Remove(item);
    }

    private void EditarObservacion(ItemPedidoDTO item)
    {
        itemEditandoObservacion = item;
        textoObservacion = item.Observacion ?? "";
    }

    private void GuardarObservacion()
    {
        if (itemEditandoObservacion == null) return;

        var texto = textoObservacion.Trim();
        if (!string.IsNullOrWhiteSpace(texto) &&
            string.IsNullOrWhiteSpace(itemEditandoObservacion.Observacion) &&
            itemEditandoObservacion.Cantidad > 1)
        {
            // Separa una unidad: permite una pizza sin aceitunas y otra normal.
            itemEditandoObservacion.Cantidad--;
            carrito.Add(new ItemPedidoDTO
            {
                IdProducto = itemEditandoObservacion.IdProducto,
                Cantidad = 1,
                Observacion = texto
            });
        }
        else
        {
            itemEditandoObservacion.Observacion = string.IsNullOrWhiteSpace(texto)
                ? null
                : texto;
        }

        itemEditandoObservacion = null;
        textoObservacion = "";
    }

    private void CancelarObservacion()
    {
        itemEditandoObservacion = null;
        textoObservacion = "";
    }

    private void AumentarComensales()
    {
        if (cantidadComensales < 50) cantidadComensales++;
    }

    private void DisminuirComensales()
    {
        if (cantidadComensales > 1) cantidadComensales--;
    }


    private void AbrirEdicionPendientes(List<PedidoDTO> pendientes)
    {
        if (comandaActual == null || pendientes.Any(p => p.Estado != EnumEstadoPedido.Pendiente)) return;
        esNuevaComanda = false;
        AbrirModalPedido();
        idsPedidosEditando = pendientes.Select(p => p.Id).ToList();
        detallesAntesDeEditar = pendientes.SelectMany(p => p.DetallesPedido).ToList();
        carrito = detallesAntesDeEditar.Select(d => new ItemPedidoDTO
        {
            IdProducto = d.IdProducto, Cantidad = d.Cantidad, Observacion = d.Observacion
        }).ToList();
    }

    private async Task GuardarEdicionPendientes()
    {
        if (comandaActual == null) return;
        var dto = new EditarPedidoPendienteDTO
        {
            IdsPedidos = idsPedidosEditando.ToList(),
            DetallesOriginales = detallesAntesDeEditar,
            Items = carrito
        };
        var respuesta = await http.Put($"api/Pedido/Comanda/{comandaActual.Id}/EditarPendientes", dto);
        if (respuesta.Error)
        {
            MensajeModal = respuesta.ObtenerError();
            return;
        }
        mostrarModalPedido = false;
        idsPedidosEditando = new();
        detallesAntesDeEditar = new();
        carrito = new();
        await CargarPedidos();
        await CargarMesas();
        Mensaje = "Pedido pendiente actualizado.";
    }

    private async Task ConfirmarPedido()
    {
        if (!carrito.Any() || enviandoPedido) return;

        enviandoPedido = true;
        MensajeModal = null;

        try
        {
            if (idsPedidosEditando.Any())
                await GuardarEdicionPendientes();
            else if (esNuevaComanda)
                await ConfirmarNuevaComanda();
            else
                await EnviarPedidoAdicional();
        }
        catch (System.Net.Http.HttpRequestException) { MensajeModal = "No se pudo confirmar el envío. Revisá los pedidos de la mesa antes de volver a enviar."; }
        finally
        {
            enviandoPedido = false;
        }
    }

    private async Task ConfirmarNuevaComanda()
    {
        if (mesaSeleccionada == null || idUsuarioActual == null) return;

        var idMesa = mesaSeleccionada.Id;
        var dto = new ConfirmarComandaDTO
        {
            IdMesa = mesaSeleccionada.Id,
            IdUsuario = idUsuarioActual.Value,
            CantidadComensales = cantidadComensales,
            Items = carrito
        };

        var respuesta = await http.Post<ConfirmarComandaDTO, ComandaConfirmadaDTO>("api/Comanda/Confirmar", dto);
        if (respuesta.Error || respuesta.Respuesta == null)
        {
            MensajeModal = respuesta.ObtenerError();
            await CargarMesas();
            return;
        }

        mostrarModalPedido = false;
        carrito = new();
        await CargarMesas();
        var mesaActualizada = mesas.FirstOrDefault(m => m.Id == idMesa);
        if (mesaActualizada != null)
            await SeleccionarMesa(mesaActualizada);

        Mensaje = $"Comanda {respuesta.Respuesta.NumeroComanda} enviada correctamente a cocina/barra.";
    }

    private async Task EnviarPedidoAdicional()
    {
        if (comandaActual == null || !carrito.Any()) return;

        var dto = new CargarPedidoDTO
        {
            IdComanda = comandaActual.Id,
            Items = carrito
        };

        var respuesta = await http.Post<CargarPedidoDTO, List<int>>("api/Pedido/CargarItems", dto);
        if (respuesta.Error)
        {
            MensajeModal = respuesta.ObtenerError();
            return;
        }

        mostrarModalPedido = false;
        carrito = new();
        await CargarPedidos();
        Mensaje = $"Pedido agregado a la comanda {comandaActual.NumeroComanda}.";
    }

    private void PedirCancelarMesa()
    {
        tituloConfirmacion = "Cancelar mesa";
        mensajeConfirmacion = $"¿Cancelar la apertura de la mesa {mesaSeleccionada?.NumeroMesa}? Todavía no se cargó ningún pedido.";
        accionConfirmada = CancelarMesa;
        confirmacion?.Ver();
    }

    private void PedirCerrarMesa()
    {
        tituloConfirmacion = "Cerrar mesa";
        mensajeConfirmacion = $"¿Cerrar la mesa {mesaSeleccionada?.NumeroMesa}? Pasa a pendiente de cobro y no se van a poder agregar más pedidos.";
        accionConfirmada = CerrarMesa;
        confirmacion?.Ver();
    }

    private async Task EjecutarConfirmacion()
    {
        confirmacion?.Ocultar();
        if (accionConfirmada != null)
            await accionConfirmada();
    }

    private async Task CancelarMesa()
    {
        if (comandaActual == null) return;

        var resp = await http.Put($"api/Comanda/{comandaActual.Id}/Cancelar", new { });
        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            return;
        }

        await CargarMesas();
        CerrarPanel();
    }

    private async Task CerrarMesa()
    {
        if (comandaActual == null) return;

        var resp = await http.Put($"api/Comanda/{comandaActual.Id}/Cerrar", new { });
        if (resp.Error)
        {
            Mensaje = resp.ObtenerError();
            return;
        }

        await CargarMesas();
        CerrarPanel();
    }

    private void CerrarPanel()
    {
        mostrarModalPedido = false;
        mesaSeleccionada = null;
        comandaActual = null;
    }

    public async ValueTask DisposeAsync()
    {
        Polling.ConexionCambiada -= ConexionCambiada;
        await Polling.DisposeAsync();
    }
}
