    }


    // Para un pago exacto no hace falta ingresar efectivo. Si hay vuelto, acepta
    // formatos habituales: 13000, 13.000, 13,000 y 13000,50.
    private static bool TryLeerImporte(string? texto, out decimal importe)
    {
        importe = 0;
        if (string.IsNullOrWhiteSpace(texto)) return false;
        var valor = texto.Trim().Replace("$", "").Replace(" ", "");
        if (!System.Text.RegularExpressions.Regex.IsMatch(valor, @"^\d+[.,\d]*$")) return false;

        var ultimoPunto = valor.LastIndexOf('.');
        var ultimaComa = valor.LastIndexOf(',');
        var ultimoSeparador = Math.Max(ultimoPunto, ultimaComa);
        if (ultimoSeparador >= 0)
        {
            var digitosFinales = valor.Length - ultimoSeparador - 1;
            if (digitosFinales == 0) return false;
            // Tres dígitos al final significa separador de miles (13.000).
            // Uno o dos significa centavos (13000,50).
            var separadorDecimal = digitosFinales <= 2 ? ultimoSeparador : -1;
            if (separadorDecimal >= 0)
            {
                valor = valor[..separadorDecimal].Replace(".", "").Replace(",", "") +
                        "." + valor[(separadorDecimal + 1)..];
            }
            else
            {
                valor = valor.Replace(".", "").Replace(",", "");
            }
        }
        return decimal.TryParse(valor, System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture, out importe) && importe > 0;
    }

