@page "/pedidos"
@using Microsoft.AspNetCore.Authorization
@using PericoOnFire_2026.Shared.DTOs
@using PericoOnFire_2026.Shared.ENUM
@using PericoOnFire_2026.Shared.Utilidades
@using PericoOnFire_2026.Servicio.ServicioHttp
@implements IAsyncDisposable
@inject PericoOnFire_2026.Shared.SerPolling.PollingService Polling
@inject IHttpServicio http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = "Administracion,Barra,Delivery")]

@if (sinConexion) { <p class="alert alert-warning m-2" role="status">No se pudo actualizar la información. Reintentando…</p> }

<div class="pedidos-pagina">

    <AuthorizeView Roles="Administracion,Barra">
        <Authorized>

            @if (!string.IsNullOrWhiteSpace(mensajePaseCaja))
            {
                <div class="alert alert-info" role="status">@mensajePaseCaja</div>
            }

            <div class="pedido-formulario-cabecera pedido-formulario-cabecera-superior">
                <button id="perico-nuevo-pedido-abrir" type="button"
                        class="btn btn-danger pedido-formulario-toggle"
                        aria-haspopup="dialog" aria-keyshortcuts="Control+Space"
                        @onclick="() => mostrarFormularioNuevoPedido = true">
                    ＋ Nuevo pedido <span class="atajo-nuevo-pedido">Ctrl + Espacio</span>
                </button>
                @if (!mostrarFormularioNuevoPedido && !string.IsNullOrWhiteSpace(MensajeForm))
                {
                    <span class="alert @(MensajeFormEsExito ? "alert-success" : "alert-warning") mb-0 py-2" role="status">@MensajeForm</span>
                }
            </div>
            <nav class="pestanas-tipo-pedidos" aria-label="Elegir tipo de pedido">
                <button type="button" class="pestana-tipo-pedido @(!mostrarRendiciones && pestanaPedidos == EnumTipoServicio.TakeAway ? "pestana-tipo-activa" : "")"
                        aria-pressed="@(!mostrarRendiciones && pestanaPedidos == EnumTipoServicio.TakeAway)"
                        @onclick="() => { pestanaPedidos = EnumTipoServicio.TakeAway; mostrarRendiciones = false; }">
                    Take Away <span>@takeAways.Count</span>
                </button>
                <button type="button" class="pestana-tipo-pedido @(!mostrarRendiciones && pestanaPedidos == EnumTipoServicio.Delivery ? "pestana-tipo-activa" : "")"
                        aria-pressed="@(!mostrarRendiciones && pestanaPedidos == EnumTipoServicio.Delivery)"
                        @onclick="() => { pestanaPedidos = EnumTipoServicio.Delivery; mostrarRendiciones = false; }">
                    Delivery <span>@deliveries.Count</span>
                </button>
                <button type="button" class="pestana-tipo-pedido @(mostrarRendiciones ? "pestana-tipo-activa" : "")"
                        aria-pressed="@mostrarRendiciones"
                        @onclick="() => mostrarRendiciones = true">
                    Rendiciones <span>@RendicionesPendientes.Count</span>
                </button>
            </nav>
            @* Se muestra una modalidad a la vez para evitar desplazarse entre ambas. *@
            <section class="panel-seguimiento" aria-label="Pedidos en curso">
                <div class="seguimiento-dos-columnas">
                    @foreach (var grupo in new[] { new { Titulo = "Take Away", Cuentas = takeAways }, new { Titulo = "Delivery", Cuentas = deliveries } })
                    {
                    @if (!mostrarRendiciones && pestanaPedidos == (grupo.Titulo == "Take Away" ? EnumTipoServicio.TakeAway : EnumTipoServicio.Delivery))
                    {
                    <section class="seguimiento-columna" aria-label="@grupo.Titulo">
                        <h3 class="seguimiento-columna-titulo">@grupo.Titulo <span>@grupo.Cuentas.Count</span></h3>
                        @if (!grupo.Cuentas.Any())
                        {
                            <p class="texto-vacio">No hay pedidos en curso.</p>
                        }
                        <div class="grilla-cuentas">
                    @foreach (var cuenta in grupo.Cuentas)
                    {
                        <div class="cuenta-card">
                            @if (cuenta.TipoServicio == EnumTipoServicio.TakeAway)
                            {
                                <div class="cuenta-card-titulo">
                                    @cuenta.NombreCliente
                                    <span class="cuenta-card-numero">· @cuenta.NumeroComanda</span>
                                </div>
                            }
                            else
                            {
                                <div class="cuenta-card-info">📍 @cuenta.Direccion</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(cuenta.Telefono))
                            {
                                <div class="cuenta-card-info">☎ @cuenta.Telefono</div>
                            }

                            <ul class="lista-items">
                                @foreach (var item in cuenta.Items)
                                {
                                    <li>@item.Cantidad x @item.NombreProducto</li>
                                }
                            </ul>

                            <div class="badges-sector">
                                @foreach (var pedido in cuenta.Pedidos)
                                {
                                    <span class="badge-sector">@pedido.Sector: @pedido.Estado</span>
                                }
                            </div>

                            @if (cuenta.TipoServicio == EnumTipoServicio.Delivery)
                            {
                                <div class="cuenta-card-titulo cuenta-card-titulo-final">
                                    @cuenta.NombreCliente
                                    <span class="cuenta-card-numero">· @cuenta.NumeroComanda</span>
                                </div>
                            }

                            @if (editandoHorarioId == cuenta.IdComanda)
                            {
                                <div class="editor-horario">
                                    <label>@(cuenta.TipoServicio == EnumTipoServicio.Delivery ? "Horario de entrega" : "Horario de retiro")</label>
                                    <input type="time" value="@horaEditando"
                                           @oninput="e => horaEditando = e.Value?.ToString() ?? string.Empty" />
                                    <div class="editor-horario-acciones">
                                        <button class="btn-cancelar-observacion" @onclick="CancelarEdicionHorario">Cancelar</button>
                                        <button class="btn-guardar-observacion" @onclick="() => GuardarHoraDeseada(cuenta)">Guardar</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="cuenta-card-info @ClaseHorarioProximo(cuenta)">
                                    🕒 @(cuenta.HoraDeseada.HasValue
                                                                                                                    ? $"Para las {cuenta.HoraDeseada.Value.ToLocalTime():HH:mm}"
                                                                                                                    : "Sin horario indicado")
                                    <button class="btn-editar-horario" @onclick="() => EditarHoraDeseada(cuenta)">✎ editar</button>
                                </div>
                            }

                            @if (cuenta.TipoServicio == EnumTipoServicio.Delivery)
                            {
                                <div class="cuenta-card-info">
                                    @if (cuenta.IdDelivery == null)
                                    {
                                        <span>Sin repartidor asignado</span>
                                    }
                                    else if (cuenta.TodoEnCamino)
                                    {
                                        <span>En camino con @cuenta.NombreDelivery</span>
                                    }
                                    else if (cuenta.TodoEntregado)
                                    {
                                        <span>Entregado por @cuenta.NombreDelivery</span>
                                    }
                                </div>
                            }

                            @* Resumen financiero para quien gestiona Take Away / Delivery.
                               Los importes previstos no son cobros confirmados en Caja. *@
                            <div class="cuenta-resumen-cobro" aria-label="Información de cobro de la comanda">
                                <div class="cuenta-cobro-fila cuenta-cobro-total">
                                    <span>Total de la venta</span>
                                    <strong>$@cuenta.TotalPedido.ToString("N2")</strong>
                                </div>
                                @if (cuenta.EstaPagado)
                                {
                                    <div class="cuenta-cobro-estado cuenta-cobro-pagado">
                                        ✓ Pagado @(string.IsNullOrWhiteSpace(cuenta.MediosPago) ? "" : "· " + cuenta.MediosPago)
                                    </div>
                                    @if (cuenta.EfectivoRecibido.HasValue)
                                    {
                                        <div class="cuenta-cobro-fila">
                                            <span>Efectivo registrado</span>
                                            <strong>$@cuenta.EfectivoRecibido.Value.ToString("N2")</strong>
                                        </div>
                                        <div class="cuenta-cobro-fila">
                                            <span>Vuelto registrado</span>
                                            <strong>$@((cuenta.VueltoRegistrado ?? 0).ToString("N2"))</strong>
                                        </div>
                                    }
                                }
                                else if (cuenta.TipoServicio == EnumTipoServicio.Delivery && cuenta.EfectivoPrevistoDelivery.HasValue)
                                {
                                    <div class="cuenta-cobro-estado cuenta-cobro-pendiente">Efectivo al entregar · Cobro todavía no registrado</div>
                                    <div class="cuenta-cobro-fila">
                                        <span>Cliente paga con</span>
                                        <strong>$@cuenta.EfectivoPrevistoDelivery.Value.ToString("N2")</strong>
                                    </div>
                                    <div class="cuenta-cobro-fila cuenta-cobro-vuelto">
                                        <span>Vuelto que lleva Delivery</span>
                                        <strong>$@((cuenta.EfectivoPrevistoDelivery.Value - cuenta.TotalPedido).ToString("N2"))</strong>
                                    </div>
                                    <div class="cuenta-cobro-fila">
                                        <span>Importe a rendir en Caja</span>
                                        <strong>$@cuenta.TotalPedido.ToString("N2")</strong>
                                    </div>
                                }
                                else
                                {
                                    <div class="cuenta-cobro-estado cuenta-cobro-pendiente">
                                        @(cuenta.TipoServicio == EnumTipoServicio.TakeAway
                                            ? "Pendiente de cobro al retirar / en Caja"
                                            : "Cobro pendiente · Medio de pago no indicado")
                                    </div>
                                }
                            </div>

                            @* Estado de pago: independiente del estado físico del pedido, porque
                               a veces se cobra antes (transferencia) y a veces al retirar/entregar. *@
                            @switch (cuenta.EstadoComanda)
                            {
                                case EnumEstadoComanda.PendienteCobro:
                                    <div class="cuenta-card-info aviso-pago">💰 Pendiente de pago en caja</div>
                                    break;
                                case EnumEstadoComanda.Pagada:
                                    <div class="cuenta-card-info aviso-pago-ok">✅ Pagado</div>
                                    break;
                            }

                            @if (cuenta.TipoServicio == EnumTipoServicio.TakeAway && cuenta.TodoListo && cuenta.EstadoComanda == EnumEstadoComanda.Abierta)
                            {
                                <div class="cuenta-card-info aviso-pago">🔔 Listo para retirar</div>
                            }

                            @if (PuedeCerrar(cuenta) &&
                                 !(cuenta.TipoServicio == EnumTipoServicio.Delivery &&
                                   cuenta.EfectivoPrevistoDelivery.HasValue && cuenta.IdDelivery.HasValue))
                            {
                                <button class="btn btn-sm btn-dark w-100 mt-1" @onclick="() => CerrarPedido(cuenta)">
                                    Pasar a Caja
                                </button>
                            }

                            @if (cuenta.TipoServicio == EnumTipoServicio.TakeAway && cuenta.EstadoComanda == EnumEstadoComanda.Pagada)
                            {
                                <button class="btn btn-sm btn-outline-success w-100 mt-1" @onclick="() => MarcarRetiradoTakeAway(cuenta)">
                                    Marcar retirado por el cliente
                                </button>
                            }
                        </div>
                    }
                        </div>
                    </section>
                    }
                    }
                </div>
                @if (mostrarRendiciones)
                {
                <section class="rendiciones-delivery" aria-label="Rendiciones pendientes de Delivery">
                    <div class="rendiciones-titulo">
                        <h3>Delivery · Pendientes de rendición</h3>
                        <span>@RendicionesPendientes.Count</span>
                    </div>
                    @if (!RendicionesPendientes.Any())
                    {
                        <p class="texto-vacio">No hay entregas en efectivo pendientes de rendición.</p>
                    }
                    else
                    {
                        <div class="rendiciones-grid">
                            @foreach (var cuenta in RendicionesPendientes)
                            {
                                <div class="rendicion-tarjeta">
                                    <div class="rendicion-encabezado">
                                        <strong>@cuenta.NumeroComanda · @cuenta.NombreCliente</strong>
                                        <span>Entregado · Sin rendir</span>
                                    </div>
                                    <small>Repartidor: @cuenta.NombreDelivery</small>
                                    <div class="rendicion-importes">
                                        <div><span>Total de venta</span><strong>$@cuenta.TotalPedido.ToString("N2")</strong></div>
                                        <div><span>Cliente pagó con (previsto)</span><strong>$@cuenta.EfectivoPrevistoDelivery!.Value.ToString("N2")</strong></div>
                                        <div><span>Vuelto previsto</span><strong>$@((cuenta.EfectivoPrevistoDelivery.Value - cuenta.TotalPedido).ToString("N2"))</strong></div>
                                        <div class="rendicion-neto"><span>Dinero a rendir en Caja</span><strong>$@cuenta.TotalPedido.ToString("N2")</strong></div>
                                    </div>
                                    @if (idRendicionConfirmando == cuenta.IdComanda)
                                    {
                                        <p class="rendicion-alerta">Confirmá solo después de recibir y contar el efectivo del repartidor. Esta acción registra el cobro en Caja.</p>
                                        <div class="rendicion-botones">
                                            <button class="btn btn-sm btn-outline-secondary" disabled="@guardandoRendicion" @onclick="() => idRendicionConfirmando = null">Volver</button>
                                            <button class="btn btn-sm btn-success" disabled="@guardandoRendicion" @onclick="() => ConfirmarRendicion(cuenta)">
                                                @(guardandoRendicion ? "Registrando..." : "Sí, recibí el dinero")
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" disabled="@guardandoRendicion"
                                                @onclick="() => idRendicionConfirmando = cuenta.IdComanda">
                                            Confirmar rendición y registrar en Caja
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(mensajeRendicion))
                    {
                        <div class="alert alert-info mt-2" role="status">@mensajeRendicion</div>
                    }
                </section>
                }
            </section>


            @if (mostrarFormularioNuevoPedido)
            {
                <div class="pedido-modal-fondo">
                    <div class="pedido-modal-ventana" role="dialog" aria-modal="true" aria-label="Cargar nuevo pedido">
                        <div class="pedido-modal-barra">
                            <strong>Cargar nuevo pedido</strong>
                            <button id="perico-nuevo-pedido-cerrar" type="button" class="pedido-modal-cerrar" aria-label="Cerrar ventana de nuevo pedido" aria-keyshortcuts="Escape"
                                    disabled="@enviandoPedido" @onclick="() => mostrarFormularioNuevoPedido = false">×</button>
                        </div>
                        <div class="panel-nuevo-pedido">
                <section class="modal-pedido" aria-label="Formulario de nuevo pedido">
                    <header class="modal-pedido-header">
                        <div class="modal-encabezado-contenido">

                            <div class="modal-identificacion">
                                <h4>Nuevo pedido</h4>
                                <span>@tipoNuevoPedido</span>
                            </div>



                        </div>

                    </header>

                    @if (!string.IsNullOrWhiteSpace(MensajeForm))
                    {
                        <div class="alert @(MensajeFormEsExito ? "alert-success" : "alert-danger") py-2">@MensajeForm</div>
                    }

                    <fieldset class="datos-cliente datos-cliente-superior" disabled="@enviandoPedido" aria-label="Datos del cliente">
                        <div class="cliente-linea">
                            <strong>Cliente</strong>
                            <div class="buscador-cliente-contenedor">
                                <input id="perico-buscar-cliente-pedido" class="form-control form-control-sm" type="search" autocomplete="off"
                                       placeholder="Buscar nombre, teléfono o referencia de WhatsApp..."
                                       value="@busquedaCliente" @oninput="BuscarClienteExistente" />
                                @if (resultadosCliente.Any())
                                {
                                    <div class="clientes-coincidencias" role="listbox" aria-label="Clientes encontrados">
                                        @foreach (var clienteEncontrado in resultadosCliente)
                                        {
                                            <button type="button" class="cliente-coincidencia" @onclick="() => SeleccionarClienteExistente(clienteEncontrado)">
                                                <strong>@clienteEncontrado.Nombre</strong>
                                                <span>@(string.IsNullOrWhiteSpace(clienteEncontrado.Telefono) ? clienteEncontrado.Direccion : clienteEncontrado.Telefono)</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="selector-tipo">
                                <button type="button" class="@(tipoNuevoPedido == EnumTipoServicio.TakeAway ? "activo" : "")"
                                        @onclick='() => tipoNuevoPedido = EnumTipoServicio.TakeAway'>Take Away</button>
                                <button type="button" class="@(tipoNuevoPedido == EnumTipoServicio.Delivery ? "activo" : "")"
                                        @onclick='() => tipoNuevoPedido = EnumTipoServicio.Delivery'>Delivery</button>
                            </div>
                        </div>
                        <div class="cliente-campos">
                            @if (tipoNuevoPedido == EnumTipoServicio.Delivery)
                            {
                                <label class="dato-cliente">Referencia de WhatsApp
                                    <input class="form-control form-control-sm" maxlength="150" required
                                           placeholder="Contacto o referencia de WhatsApp"
                                           @bind="direccionCliente" @bind:event="oninput" @bind:after="DesvincularClienteSeleccionado" />
                                </label>
                                <label class="dato-cliente">Entrega (opcional)
                                    <input type="time" class="form-control form-control-sm" value="@horaDeseadaTexto"
                                           @oninput="e => horaDeseadaTexto = e.Value?.ToString() ?? string.Empty" />
                                </label>
                            }
                            else
                            {
                                <label class="dato-cliente">Nombre y apellido
                                    <input class="form-control form-control-sm" maxlength="100"
                                           @bind="nombreCliente" @bind:event="oninput" @bind:after="DesvincularClienteSeleccionado" />
                                </label>
                                <div class="cliente-campos-secundarios">
                                    <label class="dato-cliente">Teléfono
                                        <input class="form-control form-control-sm" maxlength="30"
                                               @bind="telefonoCliente" @bind:event="oninput" @bind:after="DesvincularClienteSeleccionado" />
                                    </label>
                                    <label class="dato-cliente">Retiro (opcional)
                                        <input type="time" class="form-control form-control-sm" value="@horaDeseadaTexto"
                                               @oninput="e => horaDeseadaTexto = e.Value?.ToString() ?? string.Empty" />
                                    </label>
                                </div>
                            }
                        </div>
                    </fieldset>

                            <nav class="categorias categorias-superiores" aria-label="Categorías">
                                @foreach (var categoria in CategoriasDisponibles)
                                {
                                    <button class="@(categoria == categoriaSeleccionada ? "activo" : "")"
                                            @onclick="() => SeleccionarCategoria(categoria)">
                                        <span>@IconoCategoria(categoria)</span>
                                        @categoria
                                    </button>
                                }
                            </nav>

                    <fieldset class="selector-productos" disabled="@enviandoPedido">
                        <aside class="selector-resumen @(mostrarCarritoCompacto ? "carrito-compacto-abierto" : "carrito-compacto-cerrado")">
                            <button type="button" class="carrito-compacto-toggle" aria-expanded="@mostrarCarritoCompacto"
                                    @onclick="() => mostrarCarritoCompacto = !mostrarCarritoCompacto">
                                <span>🧾 Pedido (@CantidadTotalItems)</span>
                                <span>$@TotalCarrito.ToString("N2") @(mostrarCarritoCompacto ? "▴" : "▾")</span>
                            </button>
                            <div class="resumen-carrito">
                                <strong>Pedido (@CantidadTotalItems)</strong>
                                @if (!carrito.Any())
                                {
                                    <small>Todavía no agregaste productos.</small>
                                }
                                else
                                {
                                    @foreach (var item in carrito)
                                    {
                                        <div class="carrito-item">
                                            <div class="carrito-item-linea">
                                                <span>@item.Cantidad × @NombreProducto(item.IdProducto)</span>
                                                <div class="carrito-acciones">
                                                    <button class="btn-observacion"
                                                            title="Agregar observación"
                                                            aria-label="Agregar observación"
                                                            @onclick="() => EditarObservacion(item)">
                                                        ✎
                                                    </button>
                                                    <button class="btn-eliminar"
                                                            title="Quitar producto"
                                                            aria-label="Quitar producto"
                                                            @onclick="() => QuitarDelCarrito(item)">
                                                        ×
                                                    </button>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.Observacion))
                                            {
                                                <small class="observacion-carrito">⚠ @item.Observacion</small>
                                            }

                                            @if (ReferenceEquals(itemEditandoObservacion, item))
                                            {
                                                <div class="editor-observacion">
                                                    <label>Observación para cocina/barra</label>
                                                    <input type="text"
                                                           maxlength="300"
                                                           placeholder="Ej.: sin aceitunas"
                                                           @bind="textoObservacion"
                                                           @bind:event="oninput" />
                                                    <div class="editor-observacion-acciones">
                                                        <button class="btn-cancelar-observacion" @onclick="CancelarObservacion">Cancelar</button>
                                                        <button class="btn-guardar-observacion" @onclick="GuardarObservacion">Guardar</button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </aside>

                        <nav class="subcategorias" aria-label="Subcategorías">
                            @foreach (var subcategoria in SubcategoriasDisponibles)
                            {
                                <button class="@(subcategoria == subcategoriaSeleccionada ? "activo" : "")"
                                        @onclick="() => { busquedaProducto = string.Empty; subcategoriaSeleccionada = subcategoria; }">
                                    @subcategoria
                                </button>
                            }
                        </nav>

                        <div class="productos-modal">
                    <div class="productos-buscador">
                        <input type="search" class="form-control" aria-label="Buscar productos en todo el menú" placeholder="Buscar en todo el menú…" @bind="busquedaProducto" @bind:event="oninput" />
                    </div>
                            <div class="productos-titulo">
                                <strong>@(string.IsNullOrWhiteSpace(busquedaProducto) ? subcategoriaSeleccionada : "Resultados")</strong>
                                <span>@(string.IsNullOrWhiteSpace(busquedaProducto) ? categoriaSeleccionada : "Todo el menú")</span>
                            </div>

                            @foreach (var producto in ProductosVisibles)
                            {
                                var cantidad = CantidadProducto(producto.Id);
                                <article class="producto-fila">
                                    <div>
                                        <strong>@producto.Nombre</strong>
                                        <small>@(string.IsNullOrWhiteSpace(busquedaProducto) ? producto.SectorDestino.ToString() : producto.NombreSubcategoria)</small>
                                    </div>
                                    <span class="producto-precio">$@producto.Precio.ToString("N2")</span>
                                    <div class="control-cantidad">
                                        <button @onclick="() => DisminuirProducto(producto.Id)" disabled="@(cantidad == 0)">−</button>
                                        <span>@cantidad</span>
                                        <button @onclick="() => AumentarProducto(producto.Id)">+</button>
                                    </div>
                                </article>
                            }

                            @if (!ProductosVisibles.Any())
                            {
                                <p class="texto-vacio p-3">@(string.IsNullOrWhiteSpace(busquedaProducto) ? "No hay productos activos en esta subcategoría." : "No encontramos productos con ese nombre.")</p>
                            }
                        </div>
                    </fieldset>

                    <div class="pago-inmediato">
                        @if (tipoNuevoPedido == EnumTipoServicio.Delivery && !cobrarAhora)
                        {
                            <label class="pago-inmediato-opcion">
                                <input type="checkbox" @bind="efectivoAlRecibirDelivery" disabled="@enviandoPedido" />
                                <strong>Cliente paga en efectivo al recibir</strong>
                            </label>
                            @if (efectivoAlRecibirDelivery)
                            {
                                <label class="pago-inmediato-metodo">
                                    ¿Con cuánto paga el cliente?
                                    <input type="text" inputmode="decimal" class="form-control form-control-sm"
                                           placeholder="Ej.: 30000 o 30.000"
                                           @bind="efectivoPrevistoTexto" @bind:event="oninput"
                                           disabled="@enviandoPedido" />
                                </label>
                                @if (TryLeerImporte(efectivoPrevistoTexto, out var efectivoPrevisto) && efectivoPrevisto >= TotalCarrito)
                                {
                                    <strong class="delivery-vuelto-previsto">Vuelto a llevar: $@((efectivoPrevisto - TotalCarrito).ToString("N2"))</strong>
                                }
                                else
                                {
                                    <small class="text-danger">Indicá el efectivo que entregará el cliente (mínimo $@TotalCarrito.ToString("N2")).</small>
                                }
                            }
                        }
                        <label class="pago-inmediato-opcion">
                            <input type="checkbox" @bind="cobrarAhora" disabled="@enviandoPedido" />
                            <strong>El cliente paga ahora</strong>
                        </label>
                        @if (cobrarAhora)
                        {
                            <label class="pago-inmediato-metodo">
                                Medio de pago
                                <select class="form-select form-select-sm" @bind="tipoPagoInmediato" disabled="@enviandoPedido">
                                    @foreach (var tipo in TiposPagoCaja.Habilitados)
                                    {
                                        <option value="@tipo">@TiposPagoCaja.Nombre(tipo)</option>
                                    }
                                </select>
                            </label>
                            <div class="pago-inmediato-total">Total a cobrar: <strong>$@TotalCarrito.ToString("N2")</strong></div>
                            @if (tipoPagoInmediato == EnumTipoPago.Efectivo)
                            {
                                <label class="pago-inmediato-metodo">
                                    ¿Te entregaron más efectivo? (opcional, solo para calcular el vuelto)
                                    <input type="text" inputmode="decimal" class="form-control form-control-sm"
                                           placeholder="Ej.: 15000 o 15.000"
                                           @bind="efectivoEntregadoTexto" @bind:event="oninput"
                                           disabled="@enviandoPedido" />
                                </label>
                                @if (!string.IsNullOrWhiteSpace(efectivoEntregadoTexto))
                                {
                                    @if (TryLeerImporte(efectivoEntregadoTexto, out var efectivoIngresado))
                                    {
                                        @if (efectivoIngresado >= TotalCarrito)
                                        {
                                            <small>Vuelto: $@((efectivoIngresado - TotalCarrito).ToString("N2"))</small>
                                        }
                                        else
                                        {
                                            <small class="text-danger">El efectivo recibido no alcanza para cubrir el pedido.</small>
                                        }
                                    }
                                    else
                                    {
                                        <small class="text-danger">Ingresá un importe válido, por ejemplo 15000 o 15.000.</small>
                                    }
                                }
                            }
                            <small>El cobro se registra en el turno de Caja abierto al confirmar el pedido.</small>
                        }
                        else
                        {
                            <small>El pedido se envía sin cobrar. Podés registrarlo en Caja después.</small>
                        }
                    </div>
                    <footer class="modal-pedido-footer">
                        @if (!PedidoListoParaEnviar && !enviandoPedido)
                        {
                            <p class="pedido-datos-faltantes" role="status">@DatosFaltantesPedido</p>
                        }
                        <div>
                            <span>Total</span>
                            <strong>$@TotalCarrito.ToString("N2")</strong>
                        </div>
                        <button class="btn btn-outline-secondary" @onclick="ReiniciarFormularioPedido" disabled="@enviandoPedido">Vaciar</button>
                        <button class="btn btn-success" @onclick="EnviarPedido" disabled="@(!PedidoListoParaEnviar || enviandoPedido)">
                            @(enviandoPedido ? "Guardando..." : cobrarAhora ? "Cobrar y enviar a cocina/barra" : "Enviar a cocina/barra")
                        </button>
                    </footer>
                </section>
                        </div>
                    </div>
                </div>
            }

        </Authorized>
    </AuthorizeView>


    <AuthorizeView Roles="Delivery">
        <Authorized>
            @if (!string.IsNullOrWhiteSpace(MensajeDelivery))
            {
                <div class="alert alert-info">@MensajeDelivery</div>
            }

            <section class="panel-delivery">
                <h4>Para repartir</h4>

                @if (!ParaRepartir.Any())
                {
                    <p class="texto-vacio">No hay pedidos listos para repartir en este momento.</p>
                }

                <div class="grilla-cuentas">
                    @foreach (var cuenta in ParaRepartir)
                    {
                        <div class="cuenta-card">
                            <div class="cuenta-card-info">📍 @cuenta.Direccion</div>
                            @if (!string.IsNullOrWhiteSpace(cuenta.Telefono))
                            {
                                <div class="cuenta-card-info">☎ @cuenta.Telefono</div>
                            }
                            <ul class="lista-items">
                                @foreach (var item in cuenta.Items)
                                {
                                    <li>@item.Cantidad x @item.NombreProducto</li>
                                }
                            </ul>
                            @if (cuenta.HoraDeseada.HasValue)
                            {
                                <div class="cuenta-card-info @ClaseHorarioProximo(cuenta)">🕒 Para las @cuenta.HoraDeseada.Value.ToLocalTime().ToString("HH:mm")</div>
                            }
                            <div class="cuenta-card-titulo cuenta-card-titulo-final">
                                @cuenta.NombreCliente
                                <span class="cuenta-card-numero">· @cuenta.NumeroComanda</span>
                            </div>
                            <div class="delivery-cobro @(cuenta.EstaPagado ? "delivery-cobro-pagado" : "delivery-cobro-pendiente")">
                                <div><strong>Total: $@cuenta.TotalPedido.ToString("N2")</strong></div>
                                @if (cuenta.EstaPagado)
                                {
                                    <div>✓ Ya pagado @(string.IsNullOrWhiteSpace(cuenta.MediosPago) ? "" : "· " + cuenta.MediosPago). No cobrar nuevamente.</div>
                                    @if (cuenta.EfectivoRecibido.HasValue)
                                    {
                                        <small>Registrado en caja: efectivo $@cuenta.EfectivoRecibido.Value.ToString("N2") · vuelto $@((cuenta.VueltoRegistrado ?? 0).ToString("N2")).</small>
                                    }
                                }
                                else
                                {
                                    @if (cuenta.EfectivoPrevistoDelivery.HasValue)
                                    {
                                        <div><strong>💵 Cobra en efectivo al entregar: $@cuenta.TotalPedido.ToString("N2")</strong></div>
                                        <div>Cliente paga con: <strong>$@cuenta.EfectivoPrevistoDelivery.Value.ToString("N2")</strong></div>
                                        <div class="delivery-vuelto-previsto">Vuelto a llevar: <strong>$@((cuenta.EfectivoPrevistoDelivery.Value - cuenta.TotalPedido).ToString("N2"))</strong></div>
                                        <small>Cobro previsto: todavía no está registrado como pagado en Caja.</small>
                                    }
                                    else
                                    {
                                        <div>⚠ Pendiente de cobro. Consultá con Barra/Caja cómo se cobrará.</div>
                                        <small>No se registró el medio de pago ni un vuelto previsto.</small>
                                    }
                                }
                            </div>

                            <button class="btn btn-sm btn-primary w-100 mt-1" @onclick="() => TomarPedido(cuenta)">
                                Tomar este pedido
                            </button>
                        </div>
                    }
                </div>

                <hr />

                <h4>Mis entregas en curso</h4>
                @if (!MisEntregas.Any())
                {
                    <p class="texto-vacio">No tenés entregas en curso.</p>
                }

                <div class="grilla-cuentas">
                    @foreach (var cuenta in MisEntregas)
                    {
                        <div class="cuenta-card">
                            <div class="cuenta-card-info">📍 @cuenta.Direccion</div>
                            @if (!string.IsNullOrWhiteSpace(cuenta.Telefono))
                            {
                                <div class="cuenta-card-info">☎ @cuenta.Telefono</div>
                            }
                            <ul class="lista-items">
                                @foreach (var item in cuenta.Items)
                                {
                                    <li>@item.Cantidad x @item.NombreProducto</li>
                                }
                            </ul>
                            @if (cuenta.HoraDeseada.HasValue)
                            {
                                <div class="cuenta-card-info @ClaseHorarioProximo(cuenta)">🕒 Para las @cuenta.HoraDeseada.Value.ToLocalTime().ToString("HH:mm")</div>
                            }
                            <div class="cuenta-card-titulo cuenta-card-titulo-final">
                                @cuenta.NombreCliente
                                <span class="cuenta-card-numero">· @cuenta.NumeroComanda</span>
                            </div>
                            <div class="delivery-cobro @(cuenta.EstaPagado ? "delivery-cobro-pagado" : "delivery-cobro-pendiente")">
                                <div><strong>Total: $@cuenta.TotalPedido.ToString("N2")</strong></div>
                                @if (cuenta.EstaPagado)
                                {
                                    <div>✓ Ya pagado @(string.IsNullOrWhiteSpace(cuenta.MediosPago) ? "" : "· " + cuenta.MediosPago). No cobrar nuevamente.</div>
                                    @if (cuenta.EfectivoRecibido.HasValue)
                                    {
                                        <small>Registrado en caja: efectivo $@cuenta.EfectivoRecibido.Value.ToString("N2") · vuelto $@((cuenta.VueltoRegistrado ?? 0).ToString("N2")).</small>
                                    }
                                }
                                else
                                {
                                    @if (cuenta.EfectivoPrevistoDelivery.HasValue)
                                    {
                                        <div><strong>💵 Cobra en efectivo al entregar: $@cuenta.TotalPedido.ToString("N2")</strong></div>
                                        <div>Cliente paga con: <strong>$@cuenta.EfectivoPrevistoDelivery.Value.ToString("N2")</strong></div>
                                        <div class="delivery-vuelto-previsto">Vuelto a llevar: <strong>$@((cuenta.EfectivoPrevistoDelivery.Value - cuenta.TotalPedido).ToString("N2"))</strong></div>
                                        <small>Cobro previsto: todavía no está registrado como pagado en Caja.</small>
                                    }
                                    else
                                    {
                                        <div>⚠ Pendiente de cobro. Consultá con Barra/Caja cómo se cobrará.</div>
                                        <small>No se registró el medio de pago ni un vuelto previsto.</small>
                                    }
                                }
                            </div>

                            <button class="btn btn-sm btn-success w-100 mt-1" @onclick="() => MarcarEntregado(cuenta)">
                                Marcar entregado
                            </button>
                        </div>
                    }
                </div>
                <hr />
                <div class="delivery-historial-cabecera">
                    <h4>Mis entregas de hoy</h4>
                    <span>@HoraArgentina.HoyLocal.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="delivery-historial-resumen">
                    <strong>@historialDeliveryHoy.Count entregas</strong>
                    <span>Valor total de pedidos: $@historialDeliveryHoy.Sum(c => c.TotalPedido).ToString("N2")</span>
                </div>
                @if (!historialDeliveryHoy.Any())
                {
                    <p class="texto-vacio">Todavía no registraste entregas hoy.</p>
                }
                else
                {
                    <div class="delivery-historial-lista">
                        @foreach (var entrega in historialDeliveryHoy)
                        {
                            <div class="delivery-historial-item">
                                <strong>@entrega.NumeroComanda</strong>
                                <span>@entrega.NombreCliente</span>
                                <span>@HoraArgentina.DesdeUtc(entrega.FechaEntrega!.Value).ToString("HH:mm")</span>
                                <strong>$@entrega.TotalPedido.ToString("N2")</strong>
                                <small>@entrega.Direccion · @(entrega.EstaPagado ? "Pagado" : "Pendiente de cobro")</small>
                            </div>
                        }
                    </div>
                }
            </section>

        </Authorized>
    </AuthorizeView>
</div>



