@code {
    [SupplyParameterFromQuery(Name = "tipo")] public string? TipoSolicitado { get; set; }
    private EnumTipoServicio TipoPorAcceso => string.Equals(TipoSolicitado, "delivery", StringComparison.OrdinalIgnoreCase) ? EnumTipoServicio.Delivery : EnumTipoServicio.TakeAway;
    protected override void OnParametersSet() { if (!carrito.Any() && string.IsNullOrWhiteSpace(nombreCliente)) tipoNuevoPedido = TipoPorAcceso; }

    private bool sinConexion;
    private void ConexionCambiada(bool error) { sinConexion = error; _ = InvokeAsync(StateHasChanged); }

    // El formulario se abre solo al necesitar cargar un nuevo pedido.
    private bool mostrarFormularioNuevoPedido;
    private bool cobrarAhora;
    private EnumTipoPago tipoPagoInmediato = EnumTipoPago.Efectivo;
    private string efectivoEntregadoTexto = "";
    private bool efectivoAlRecibirDelivery;
    private string efectivoPrevistoTexto = "";
    private EnumTipoServicio tipoNuevoPedido = EnumTipoServicio.TakeAway;
    private string nombreCliente = "";
    private int? idClienteExistente;
    private string busquedaCliente = "";
    private List<ClienteBusquedaDTO> resultadosCliente = new();
    private int versionBusquedaCliente;
    private string telefonoCliente = "";
    private string direccionCliente = "";
    private string horaDeseadaTexto = "";
    private List<ProductoListadoDTO> productos = new();
    private List<ItemPedidoDTO> carrito = new();
    private string categoriaSeleccionada = "";
    private string subcategoriaSeleccionada = "";
    private ItemPedidoDTO? itemEditandoObservacion;
    private string textoObservacion = "";
    private bool enviandoPedido;
    private string? MensajeForm;
    private bool MensajeFormEsExito => MensajeForm != null && MensajeForm.StartsWith("Pedido ") && (MensajeForm.EndsWith(" enviado.") || MensajeForm.EndsWith(" enviado y cobrado."));

    // Cuánto antes del horario deseado se lo marca en rojo para avisar que se acerca.
    private const int MinutosAvisoHoraDeseada = 15;

    //Para editar el horario deseado de un pedido ya creado, es solo para administracion/barra, no para delivery
    private int? editandoHorarioId;
    private string horaEditando = "";

    // ---- Seguimiento (Administracion/Barra) ----
    private List<PedidoParaLlevarDTO> takeAways = new();
    private EnumTipoServicio pestanaPedidos = EnumTipoServicio.TakeAway;
    private bool mostrarRendiciones;
    private List<PedidoParaLlevarDTO> deliveries = new();
    private bool mostrarCarritoCompacto;
    private List<PedidoParaLlevarDTO> RendicionesPendientes => deliveries
        .Where(c => c.TipoServicio == EnumTipoServicio.Delivery &&
                    !c.EstaPagado && c.TodoEntregado &&
                    c.IdDelivery.HasValue && c.EfectivoPrevistoDelivery.HasValue &&
                    c.EfectivoPrevistoDelivery.Value >= c.TotalPedido && c.TotalPedido > 0 &&
                    (c.EstadoComanda == EnumEstadoComanda.Abierta ||
                     c.EstadoComanda == EnumEstadoComanda.PendienteCobro))
        .ToList();
    private int? idRendicionConfirmando;
    private bool guardandoRendicion;
    private string? mensajeRendicion;

    private List<PedidoParaLlevarDTO> historialDeliveryHoy = new();

    //Para Delivery
    private string? MensajeDelivery;
    private List<PedidoParaLlevarDTO> ParaRepartir =>
        deliveries.Where(c => c.TodoListo && c.IdDelivery == null).ToList();
    private List<PedidoParaLlevarDTO> MisEntregas =>
        deliveries.Where(c => c.IdDelivery == idUsuarioActual && c.TodoEnCamino).ToList();

    private int? idUsuarioActual;
    private bool esSoloDelivery;
    private bool puedeAccederCaja;
    private string? mensajePaseCaja;

    private IEnumerable<string> CategoriasDisponibles => productos
        .Select(p => p.NombreCategoria)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(OrdenCategoria)
        .ThenBy(n => n);

    private static int OrdenCategoria(string categoria)
    {
        var nombre = categoria.ToLowerInvariant();
        if (nombre.Contains("comida")) return 1;
        if (nombre.Contains("bebida")) return 2;
        if (nombre.Contains("postre")) return 3;
        return 4;
    }

    private IEnumerable<string> SubcategoriasDisponibles => productos
        .Where(p => p.NombreCategoria == categoriaSeleccionada)
        .Select(p => p.NombreSubcategoria)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(n => n);

    private string busquedaProducto = "";
    private IEnumerable<ProductoListadoDTO> ProductosVisibles => productos
        .Where(p => string.IsNullOrWhiteSpace(busquedaProducto)
            ? p.NombreCategoria == categoriaSeleccionada && p.NombreSubcategoria == subcategoriaSeleccionada
            : System.Globalization.CultureInfo.GetCultureInfo("es-AR").CompareInfo.IndexOf(
                p.Nombre ?? "", busquedaProducto.Trim(),
                System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0)
        .OrderBy(p => p.Nombre);

    private int CantidadTotalItems => carrito.Sum(i => i.Cantidad);

    private decimal TotalCarrito => carrito.Sum(i =>
        (productos.FirstOrDefault(p => p.Id == i.IdProducto)?.Precio ?? 0) * i.Cantidad);

    private string DatosFaltantesPedido
    {
        get
        {
            var faltantes = new List<string>();
            if (string.IsNullOrWhiteSpace(nombreCliente) && tipoNuevoPedido != EnumTipoServicio.Delivery) faltantes.Add("nombre del cliente");
            if (tipoNuevoPedido == EnumTipoServicio.Delivery && string.IsNullOrWhiteSpace(direccionCliente)) faltantes.Add("referencia de WhatsApp");
            if (!carrito.Any()) faltantes.Add("al menos un producto");
            return "Para enviar, completá: " + string.Join(", ", faltantes) + ".";
        }
    }
    private bool PedidoListoParaEnviar =>
        (tipoNuevoPedido == EnumTipoServicio.Delivery || !string.IsNullOrWhiteSpace(nombreCliente)) &&
        carrito.Any() &&
        (tipoNuevoPedido != EnumTipoServicio.Delivery || !string.IsNullOrWhiteSpace(direccionCliente));

    protected override async Task OnInitializedAsync()
    {
        // Las llamadas autenticadas usan la cookie del navegador.
        // El prerenderizado del servidor solo prepara la vista y la sesión.
        if (!OperatingSystem.IsBrowser()) return;
        Polling.ConexionCambiada += ConexionCambiada;

        try
        {
        await CargarRolActual();
        await CargarUsuarioActual();
        await CargarProductos();
        ReiniciarFormularioPedido();
        await CargarSeguimiento();
        }
        catch (System.Net.Http.HttpRequestException) { sinConexion = true; }
        finally { Polling.Iniciar(CargarSeguimiento, TimeSpan.FromSeconds(4)); }
    }

    private async Task CargarRolActual()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        puedeAccederCaja = user.IsInRole("Administracion") || user.IsInRole("Caja");
        esSoloDelivery = user.IsInRole("Delivery") &&
                         !user.IsInRole("Administracion") &&
                         !user.IsInRole("Barra");
    }

    private async Task CargarUsuarioActual()
    {
        var respuesta = await http.Get<int>("api/Usuario/Actual");
        if (!respuesta.Error)
        {
            idUsuarioActual = respuesta.Respuesta;
        }
    }

    private async Task CargarProductos()
    {
        var respuesta = await http.Get<List<ProductoListadoDTO>>("api/Producto");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            productos = respuesta.Respuesta.Where(p => p.Activo).ToList();
        }
    }

    private async Task CargarSeguimiento()
    {
        if (idUsuarioActual == null) await CargarUsuarioActual();
        if (!productos.Any()) await CargarProductos();
        // El rol Delivery no tiene permiso para ver TakeAway (el server también lo
        // rechaza), así que ni se lo pedimos.
        if (!esSoloDelivery)
        {
            var respuestaTakeAway = await http.Get<List<PedidoParaLlevarDTO>>($"api/Pedido/ParaLlevar/{EnumTipoServicio.TakeAway}");
        if (respuestaTakeAway.Error) throw new System.Net.Http.HttpRequestException("No se pudo actualizar la información.");
            if (!respuestaTakeAway.Error && respuestaTakeAway.Respuesta != null)
            {
                takeAways = respuestaTakeAway.Respuesta;
            }
        }

        var respuestaDelivery = await http.Get<List<PedidoParaLlevarDTO>>($"api/Pedido/ParaLlevar/{EnumTipoServicio.Delivery}");
        if (respuestaDelivery.Error) throw new System.Net.Http.HttpRequestException("No se pudo actualizar la información.");
        if (!respuestaDelivery.Error && respuestaDelivery.Respuesta != null)
        {
            deliveries = respuestaDelivery.Respuesta;
        }

        var respuestaHistorial = await http.Get<List<PedidoParaLlevarDTO>>("api/Pedido/Delivery/MisEntregasHoy");
        if (!respuestaHistorial.Error && respuestaHistorial.Respuesta != null)
            historialDeliveryHoy = respuestaHistorial.Respuesta;

        await InvokeAsync(StateHasChanged);
    }

    // Se puede pasar a caja apenas cocina/barra terminó (listo, en camino o ya
    // entregado), sin esperar a que el cliente lo retire o el repartidor lo entregue.
    // Una vez que ya está en caja (PendienteCobro) o ya se cobró (Pagada), el botón
    // desaparece porque no hay nada más que cerrar.
    private bool PuedeCerrar(PedidoParaLlevarDTO cuenta) =>
        cuenta.EstadoComanda == EnumEstadoComanda.Abierta && cuenta.TodoListoOMasAlla;

    private string NombreProducto(int idProducto) =>
        productos.FirstOrDefault(p => p.Id == idProducto)?.Nombre ?? "";

    //Es lo del horario deseado, que es opcional. Si ya pasó la hora deseada, se marca en rojo para avisar que se acerca.
    //Lo puse que aparezca en rojo 15 minutos antes de la hora deseada, para que el personal sepa que se acerca la hora y
    // se apure en preparar el pedido. Tambien la comanda aparece solo 45 minutos antes de la hora deseada, para que no se vea en el seguimiento demasiado temprano.

    private string ClaseHorarioProximo(PedidoParaLlevarDTO cuenta) =>
        cuenta.HoraDeseada.HasValue && cuenta.HoraDeseada.Value <= DateTime.UtcNow.AddMinutes(MinutosAvisoHoraDeseada)
            ? "hora-proxima"
            : "";

