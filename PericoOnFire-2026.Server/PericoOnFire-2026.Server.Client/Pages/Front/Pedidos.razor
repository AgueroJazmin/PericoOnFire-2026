    private string IconoCategoria(string categoria)
    {
        var nombre = categoria.ToLowerInvariant();
        if (nombre.Contains("bebida")) return "🥤";
        if (nombre.Contains("postre")) return "🍰";
        if (nombre.Contains("café") || nombre.Contains("cafe")) return "☕";
        return "🍔";
    }

    //Es lo mismo que en mesa.razor, pero es para Take Away y Delivery.

    private int CantidadProducto(int idProducto) =>
        carrito.Where(c => c.IdProducto == idProducto).Sum(c => c.Cantidad);

    private void AumentarProducto(int idProducto)
    {
        var existente = carrito.FirstOrDefault(c => c.IdProducto == idProducto);

        if (existente != null)
        {
            existente.Cantidad++;
        }
        else
        {
            carrito.Add(new ItemPedidoDTO
            {
                IdProducto = idProducto,
                Cantidad = 1
            });
        }
    }

    private void DisminuirProducto(int idProducto)
    {
        var existente = carrito.FirstOrDefault(c => c.IdProducto == idProducto);
        if (existente == null) return;

        existente.Cantidad--;
        if (existente.Cantidad <= 0)
            carrito.Remove(existente);
    }

    private void QuitarDelCarrito(ItemPedidoDTO item)
    {
        if (ReferenceEquals(itemEditandoObservacion, item))
            CancelarObservacion();

        carrito.Remove(item);
    }

    private void EditarObservacion(ItemPedidoDTO item)
    {
        itemEditandoObservacion = item;
        textoObservacion = item.Observacion ?? "";
    }

    private void GuardarObservacion()
    {
        if (itemEditandoObservacion == null) return;

        var texto = textoObservacion.Trim();
        if (!string.IsNullOrWhiteSpace(texto) &&
            string.IsNullOrWhiteSpace(itemEditandoObservacion.Observacion) &&
            itemEditandoObservacion.Cantidad > 1)
        {
            itemEditandoObservacion.Cantidad--;
            carrito.Add(new ItemPedidoDTO
            {
                IdProducto = itemEditandoObservacion.IdProducto,
                Cantidad = 1,
                Observacion = texto
            });
        }
        else
        {
            itemEditandoObservacion.Observacion = string.IsNullOrWhiteSpace(texto)
                ? null
                : texto;
        }

        itemEditandoObservacion = null;
        textoObservacion = "";
    }

    private void CancelarObservacion()
    {
        itemEditandoObservacion = null;
        textoObservacion = "";
    }

    //Aca es la parte del horario deseado, el cual lo dejo opcional.
    //Solo es horas y minutos, no se elige fecha. Se asume que es para hoy, y si ya pasó, se asume que es para mañana.
    private DateTime? ConvertirHoraDeseada(string horaTexto)
    {
        if (string.IsNullOrWhiteSpace(horaTexto)) return null;
        if (!TimeSpan.TryParse(horaTexto, out var hora)) return null;

        var ahora = DateTime.Now;
        var candidato = ahora.Date.Add(hora);
        if (candidato < ahora.AddMinutes(-1))
        {
            candidato = candidato.AddDays(1);
        }

        return candidato.ToUniversalTime();
    }

    private async Task EnviarPedido()
    {
        if (idUsuarioActual == null)
        {
            MensajeForm = "No se pudo identificar tu usuario. Recargá la página e intentá de nuevo.";
            return;
        }

        if (!PedidoListoParaEnviar || enviandoPedido) return;

        if (tipoNuevoPedido == EnumTipoServicio.Delivery && !cobrarAhora && efectivoAlRecibirDelivery &&
            (!TryLeerImporte(efectivoPrevistoTexto, out var efectivoPrometido) || efectivoPrometido < TotalCarrito))
        {
            MensajeForm = "Ingresá con cuánto efectivo pagará el cliente. Debe alcanzar para cubrir el total.";
            return;
        }

        if (cobrarAhora && tipoPagoInmediato == EnumTipoPago.Efectivo &&
            !string.IsNullOrWhiteSpace(efectivoEntregadoTexto) &&
            (!TryLeerImporte(efectivoEntregadoTexto, out var recibido) || recibido < TotalCarrito))
        {
            MensajeForm = "Revisá el importe de efectivo recibido: debe ser válido y cubrir el total del pedido.";
            return;
        }

        enviandoPedido = true;
        try
        {
        var dto = new ConfirmarPedidoSinMesaDTO
        {
            IdUsuario = idUsuarioActual.Value,
            TipoServicio = tipoNuevoPedido,
            NombreCliente = tipoNuevoPedido == EnumTipoServicio.Delivery && !idClienteExistente.HasValue
                ? ("Referencia: " + direccionCliente.Trim())[..Math.Min(("Referencia: " + direccionCliente.Trim()).Length, 100)]
                : nombreCliente.Trim(),
            IdClienteExistente = idClienteExistente,
            Telefono = tipoNuevoPedido == EnumTipoServicio.Delivery || string.IsNullOrWhiteSpace(telefonoCliente)
                ? null : telefonoCliente.Trim(),
            Direccion = tipoNuevoPedido == EnumTipoServicio.Delivery ? direccionCliente.Trim() : null,
            HoraDeseada = ConvertirHoraDeseada(horaDeseadaTexto),
            CobrarAhora = cobrarAhora,
            EfectivoPrevistoDelivery = tipoNuevoPedido == EnumTipoServicio.Delivery && !cobrarAhora && efectivoAlRecibirDelivery &&
                TryLeerImporte(efectivoPrevistoTexto, out var previsto) ? previsto : null,
            LineasPago = cobrarAhora
                ? new List<LineaPagoDTO>
                  {
                      new LineaPagoDTO
                      {
                          TipoPago = tipoPagoInmediato,
                          Monto = tipoPagoInmediato == EnumTipoPago.Efectivo &&
                                  TryLeerImporte(efectivoEntregadoTexto, out var importeRecibido)
                              ? importeRecibido : TotalCarrito
                      }
                  }
                : new List<LineaPagoDTO>(),
            Items = carrito
        };

        var respuesta = await http.Post<ConfirmarPedidoSinMesaDTO, ComandaConfirmadaDTO>("api/Comanda/ConfirmarSinMesa", dto);
        enviandoPedido = false;

        if (respuesta.Error)
        {
            MensajeForm = respuesta.ObtenerError();
            return;
        }

        var numeroGenerado = respuesta.Respuesta!.NumeroComanda;
        var fueCobrado = cobrarAhora;
        ReiniciarFormularioPedido();
        MensajeForm = fueCobrado ? $"Pedido {numeroGenerado} enviado y cobrado." : $"Pedido {numeroGenerado} enviado.";
        mostrarFormularioNuevoPedido = false;
        await CargarSeguimiento();
        }
        catch (System.Net.Http.HttpRequestException) { MensajeForm = "No se pudo confirmar el envío. Revisá el seguimiento antes de volver a enviar."; }
        finally { enviandoPedido = false; }
    }

    //Es de administración/barra, para marcar como retirado un pedido de TakeAway que ya lo retiró el cliente

    private async Task MarcarRetiradoTakeAway(PedidoParaLlevarDTO cuenta)
    {
        // No repetir transiciones de pedidos ya entregados o cancelados.
        foreach (var pedido in cuenta.Pedidos.Where(p => p.Estado != EnumEstadoPedido.Entregado &&
                                                        p.Estado != EnumEstadoPedido.Cancelado))
        {
            var dto = new CambiarEstadoPedidoDTO { Estado = EnumEstadoPedido.Entregado };
            try
            {
                var respuesta = await http.Put($"api/Pedido/{pedido.IdPedido}/Estado", dto);
                if (respuesta.Error)
                {
                    MensajeForm = $"No se pudo registrar el retiro de la comanda {cuenta.NumeroComanda}: {respuesta.ObtenerError()}";
                    await CargarSeguimiento();
                    return;
                }
            }
            catch (System.Net.Http.HttpRequestException)
            {
                MensajeForm = $"No se pudo verificar el retiro de la comanda {cuenta.NumeroComanda}. Actualizá los pedidos antes de reintentar.";
                await CargarSeguimiento();
                return;
            }
        }

        MensajeForm = null;
        await CargarSeguimiento();
    }

    private async Task CerrarPedido(PedidoParaLlevarDTO cuenta)
    {
        mensajePaseCaja = null;
        var respuesta = await http.Put($"api/Comanda/{cuenta.IdComanda}/Cerrar", new { });
        if (respuesta.Error)
        {
            mensajePaseCaja = respuesta.ObtenerError();
            return;
        }

        if (cuenta.TipoServicio == EnumTipoServicio.TakeAway && puedeAccederCaja)
        {
            Navigation.NavigateTo("/caja");
            return;
        }

        if (cuenta.TipoServicio == EnumTipoServicio.TakeAway)
            mensajePaseCaja = $"La comanda {cuenta.NumeroComanda} se envió a Caja. Un usuario de Caja o Administración deberá cobrarla.";

        await CargarSeguimiento();
    }

    private async Task ConfirmarRendicion(PedidoParaLlevarDTO cuenta)
    {
        if (guardandoRendicion || idRendicionConfirmando != cuenta.IdComanda) return;
        guardandoRendicion = true;
        mensajeRendicion = null;
        try
        {
            var resp = await http.Post($"api/Pedido/Delivery/{cuenta.IdComanda}/ConfirmarRendicion", new { });
            if (resp.Error)
            {
                mensajeRendicion = resp.ObtenerError();
                return;
            }
            idRendicionConfirmando = null;
            mensajeRendicion = $"Rendición de {cuenta.NumeroComanda} registrada en Caja por ${cuenta.TotalPedido:N2}.";
            await CargarSeguimiento();
        }
        catch (System.Net.Http.HttpRequestException)
        {
            mensajeRendicion = "No se pudo verificar la rendición. Actualizá el seguimiento y revisá Caja antes de reintentar.";
        }
        finally { guardandoRendicion = false; }
    }

