    private async Task BuscarClienteExistente(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        busquedaCliente = e.Value?.ToString() ?? "";
        var version = ++versionBusquedaCliente;
        resultadosCliente.Clear();
        if (busquedaCliente.Trim().Length < 2) return;
        try
        {
            var respuesta = await http.Get<List<ClienteBusquedaDTO>>(
                "api/Cliente/Buscar?q=" + Uri.EscapeDataString(busquedaCliente.Trim()));
            if (version == versionBusquedaCliente && !respuesta.Error)
                resultadosCliente = respuesta.Respuesta ?? new();
        }
        catch (System.Net.Http.HttpRequestException)
        {
            if (version == versionBusquedaCliente)
                resultadosCliente.Clear();
        }
    }

    private void SeleccionarClienteExistente(ClienteBusquedaDTO cliente)
