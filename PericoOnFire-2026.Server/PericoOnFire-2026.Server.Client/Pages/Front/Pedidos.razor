</style>

@code {
    // ---- Nuevo pedido (modal, calcado del de Mesas.razor) ----
    private bool mostrarModalPedido;
    private EnumTipoServicio tipoNuevoPedido = EnumTipoServicio.TakeAway;
    private string nombreCliente = "";
    private string telefonoCliente = "";
    private string direccionCliente = "";
    private List<ProductoListadoDTO> productos = new();
    private List<ItemPedidoDTO> carrito = new();
    private string categoriaSeleccionada = "";
    private string subcategoriaSeleccionada = "";
    private ItemPedidoDTO? itemEditandoObservacion;
    private string textoObservacion = "";
    private bool enviandoPedido;
    private string? MensajeForm;

    // ---- Seguimiento (Administracion/Barra) ----
    private EnumTipoServicio tabSeguimiento = EnumTipoServicio.TakeAway;
    private List<PedidoParaLlevarDTO> takeAways = new();
    private List<PedidoParaLlevarDTO> deliveries = new();

    // ---- Vista Delivery ----
    private string? MensajeDelivery;
    private List<PedidoParaLlevarDTO> ParaRepartir =>
        deliveries.Where(c => c.TodoListo && c.IdDelivery == null).ToList();
    private List<PedidoParaLlevarDTO> MisEntregas =>
        deliveries.Where(c => c.IdDelivery == idUsuarioActual && c.TodoEnCamino).ToList();

    private int? idUsuarioActual;

    private IEnumerable<string> CategoriasDisponibles => productos
        .Select(p => p.NombreCategoria)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(n => n);

    private IEnumerable<string> SubcategoriasDisponibles => productos
        .Where(p => p.NombreCategoria == categoriaSeleccionada)
        .Select(p => p.NombreSubcategoria)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(n => n);

    private IEnumerable<ProductoListadoDTO> ProductosVisibles => productos
        .Where(p => p.NombreCategoria == categoriaSeleccionada &&
                    p.NombreSubcategoria == subcategoriaSeleccionada)
        .OrderBy(p => p.Nombre);

    private int CantidadTotalItems => carrito.Sum(i => i.Cantidad);

    private decimal TotalCarrito => carrito.Sum(i =>
        (productos.FirstOrDefault(p => p.Id == i.IdProducto)?.Precio ?? 0) * i.Cantidad);

    private bool PedidoListoParaEnviar =>
        !string.IsNullOrWhiteSpace(nombreCliente) &&
        carrito.Any() &&
        (tipoNuevoPedido != EnumTipoServicio.Delivery || !string.IsNullOrWhiteSpace(direccionCliente));

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarioActual();
        await CargarProductos();
        await CargarSeguimiento();
        Polling.Iniciar(CargarSeguimiento, TimeSpan.FromSeconds(4));
    }

    private async Task CargarUsuarioActual()
    {
        var respuesta = await http.Get<int>("api/Usuario/Actual");
        if (!respuesta.Error)
        {
            idUsuarioActual = respuesta.Respuesta;
        }
    }

    private async Task CargarProductos()
    {
        var respuesta = await http.Get<List<ProductoListadoDTO>>("api/Producto");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            productos = respuesta.Respuesta.Where(p => p.Activo).ToList();
        }
    }

    private async Task CargarSeguimiento()
    {
        var respuestaTakeAway = await http.Get<List<PedidoParaLlevarDTO>>($"api/Pedido/ParaLlevar/{EnumTipoServicio.TakeAway}");
        if (!respuestaTakeAway.Error && respuestaTakeAway.Respuesta != null)
        {
            takeAways = respuestaTakeAway.Respuesta;
        }

        var respuestaDelivery = await http.Get<List<PedidoParaLlevarDTO>>($"api/Pedido/ParaLlevar/{EnumTipoServicio.Delivery}");
        if (!respuestaDelivery.Error && respuestaDelivery.Respuesta != null)
        {
            deliveries = respuestaDelivery.Respuesta;
        }

        await InvokeAsync(StateHasChanged);
    }

    private string NombreProducto(int idProducto) =>
        productos.FirstOrDefault(p => p.Id == idProducto)?.Nombre ?? "";

    // ---- Modal: abrir/cerrar ----

    private void AbrirModalPedido()
    {
        CancelarObservacion();
        MensajeForm = null;
        tipoNuevoPedido = EnumTipoServicio.TakeAway;
        nombreCliente = "";
        telefonoCliente = "";
        direccionCliente = "";
        carrito = new();
        categoriaSeleccionada = CategoriasDisponibles.FirstOrDefault() ?? "";
        subcategoriaSeleccionada = SubcategoriasDisponibles.FirstOrDefault() ?? "";
        mostrarModalPedido = true;
    }

    private void CerrarModalPedido()
    {
        mostrarModalPedido = false;
        CancelarObservacion();
    }

    private void SeleccionarCategoria(string categoria)
    {
        categoriaSeleccionada = categoria;
        subcategoriaSeleccionada = SubcategoriasDisponibles.FirstOrDefault() ?? "";
    }

    private string IconoCategoria(string categoria)
    {
        var nombre = categoria.ToLowerInvariant();
        if (nombre.Contains("bebida")) return "🥤";
        if (nombre.Contains("postre")) return "🍰";
        if (nombre.Contains("café") || nombre.Contains("cafe")) return "☕";
        return "🍔";
    }

    // ---- Carrito (mismo comportamiento que en Mesas.razor) ----

    private int CantidadProducto(int idProducto) =>
        carrito.Where(c => c.IdProducto == idProducto).Sum(c => c.Cantidad);

    private void AumentarProducto(int idProducto)
    {
        var existente = carrito.FirstOrDefault(c => c.IdProducto == idProducto);

        if (existente != null)
        {
            existente.Cantidad++;
        }
        else
        {
            carrito.Add(new ItemPedidoDTO
            {
                IdProducto = idProducto,
                Cantidad = 1
            });
        }
    }

    private void DisminuirProducto(int idProducto)
    {
        var existente = carrito.FirstOrDefault(c => c.IdProducto == idProducto);
        if (existente == null) return;

        existente.Cantidad--;
        if (existente.Cantidad <= 0)
            carrito.Remove(existente);
    }

    private void QuitarDelCarrito(ItemPedidoDTO item)
    {
        if (ReferenceEquals(itemEditandoObservacion, item))
            CancelarObservacion();

        carrito.Remove(item);
    }

    private void EditarObservacion(ItemPedidoDTO item)
    {
        itemEditandoObservacion = item;
        textoObservacion = item.Observacion ?? "";
    }

    private void GuardarObservacion()
    {
        if (itemEditandoObservacion == null) return;

        var texto = textoObservacion.Trim();
        if (!string.IsNullOrWhiteSpace(texto) &&
            string.IsNullOrWhiteSpace(itemEditandoObservacion.Observacion) &&
            itemEditandoObservacion.Cantidad > 1)
        {
            // Separa una unidad: permite, por ej., una porción sin algo y el resto normal.
            itemEditandoObservacion.Cantidad--;
            carrito.Add(new ItemPedidoDTO
            {
                IdProducto = itemEditandoObservacion.IdProducto,
                Cantidad = 1,
                Observacion = texto
            });
        }
        else
        {
            itemEditandoObservacion.Observacion = string.IsNullOrWhiteSpace(texto)
                ? null
                : texto;
        }

        itemEditandoObservacion = null;
        textoObservacion = "";
    }

    private void CancelarObservacion()
    {
        itemEditandoObservacion = null;
        textoObservacion = "";
    }

    // ---- Envío del pedido ----

    private async Task EnviarPedido()
    {
        if (idUsuarioActual == null)
        {
            MensajeForm = "No se pudo identificar tu usuario. Recargá la página e intentá de nuevo.";
            return;
        }

        if (!PedidoListoParaEnviar) return;

        enviandoPedido = true;

        var dto = new ConfirmarPedidoSinMesaDTO
        {
            IdUsuario = idUsuarioActual.Value,
            TipoServicio = tipoNuevoPedido,
            NombreCliente = nombreCliente.Trim(),
            Telefono = string.IsNullOrWhiteSpace(telefonoCliente) ? null : telefonoCliente.Trim(),
            Direccion = tipoNuevoPedido == EnumTipoServicio.Delivery ? direccionCliente.Trim() : null,
            Items = carrito
        };

        var respuesta = await http.Post<ConfirmarPedidoSinMesaDTO, ComandaConfirmadaDTO>("api/Comanda/ConfirmarSinMesa", dto);
        enviandoPedido = false;

        if (respuesta.Error)
        {
            MensajeForm = respuesta.ObtenerError();
            return;
        }

        mostrarModalPedido = false;
        MensajeForm = $"Pedido {respuesta.Respuesta!.NumeroComanda} enviado.";
        await CargarSeguimiento();
    }

    // ---- Seguimiento Administracion/Barra ----

    private async Task MarcarRetiradoTakeAway(PedidoParaLlevarDTO cuenta)
    {
        foreach (var pedido in cuenta.Pedidos)
        {
            var dto = new CambiarEstadoPedidoDTO { Estado = EnumEstadoPedido.Entregado };
            await http.Put($"api/Pedido/{pedido.IdPedido}/Estado", dto);
        }

        await CargarSeguimiento();
    }

    private async Task CerrarPedido(PedidoParaLlevarDTO cuenta)
    {
        var respuesta = await http.Put($"api/Comanda/{cuenta.IdComanda}/Cerrar", new { });
        if (respuesta.Error)
        {
            MensajeForm = respuesta.ObtenerError();
            return;
        }

        await CargarSeguimiento();
    }

    // ---- Vista Delivery ----

    private async Task TomarPedido(PedidoParaLlevarDTO cuenta)
    {
        if (idUsuarioActual == null)
        {
            MensajeDelivery = "No se pudo identificar tu usuario. Recargá la página e intentá de nuevo.";
            return;
        }

        var dto = new AsignarDeliveryDTO { IdUsuarioDelivery = idUsuarioActual.Value };
        var respuesta = await http.Put($"api/Pedido/Delivery/{cuenta.IdComanda}/Tomar", dto);

        if (respuesta.Error)
        {
            MensajeDelivery = respuesta.ObtenerError();
            return;
        }

        await CargarSeguimiento();
    }

    private async Task MarcarEntregado(PedidoParaLlevarDTO cuenta)
    {
        if (idUsuarioActual == null)
        {
            MensajeDelivery = "No se pudo identificar tu usuario. Recargá la página e intentá de nuevo.";
            return;
        }

        var dto = new AsignarDeliveryDTO { IdUsuarioDelivery = idUsuarioActual.Value };
        var respuesta = await http.Put($"api/Pedido/Delivery/{cuenta.IdComanda}/MarcarEntregado", dto);

        if (respuesta.Error)
        {
            MensajeDelivery = respuesta.ObtenerError();
            return;
        }

        await CargarSeguimiento();
    }

    public async ValueTask DisposeAsync()
    {
        await Polling.DisposeAsync();
    }
}
