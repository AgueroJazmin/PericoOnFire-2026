</style>

@code {
    private DateTime desde = HoraArgentina.HoyLocal;
    private DateTime hasta = HoraArgentina.HoyLocal;
    private List<VentaCajaDTO> ventas = new();
    private ResumenVentasDTO? resumen;
    private bool cargando = true;
    private bool modoTodo;
    private string? mensaje;

    private decimal TotalPorTipoPago => resumen?.PorTipoPago.Sum(f => f.Monto) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // Las llamadas autenticadas usan la cookie del navegador.
        // El prerenderizado del servidor solo prepara la vista y la sesión.
        if (!OperatingSystem.IsBrowser()) return;

        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        mensaje = null;

        var rango = modoTodo
            ? "todo=true"
            : $"desde={desde:yyyy-MM-dd}&hasta={hasta:yyyy-MM-dd}";

        var respuestaVentas = await http.Get<List<VentaCajaDTO>>($"api/Caja/Ventas?{rango}");
        if (respuestaVentas.Error)
        {
            mensaje = respuestaVentas.ObtenerError();
            ventas = new();
            resumen = null;
            cargando = false;
            return;
        }

        ventas = respuestaVentas.Respuesta ?? new();

        var respuestaResumen = await http.Get<ResumenVentasDTO>($"api/Caja/Estadisticas?{rango}");
        resumen = respuestaResumen.Error ? null : respuestaResumen.Respuesta;

        // En "Todo" el server calcula el rango (primer pago hasta hoy): se muestra en los campos de fecha.
        if (modoTodo && resumen != null)
        {
            desde = resumen.Desde.Date;
            hasta = resumen.Hasta.Date;
        }

        cargando = false;
    }

    // Si el usuario cambia una fecha a mano, deja de estar en modo "Todo".
    private async Task CambiarFecha()
    {
        modoTodo = false;
        await Cargar();
    }

    private async Task Hoy()
    {
        modoTodo = false;
        desde = hasta = HoraArgentina.HoyLocal;
        await Cargar();
    }

    private async Task Ayer()
    {
        modoTodo = false;
        desde = hasta = HoraArgentina.HoyLocal.AddDays(-1);
        await Cargar();
    }

    private async Task UltimosSieteDias()
    {
        modoTodo = false;
        hasta = HoraArgentina.HoyLocal;
        desde = hasta.AddDays(-6);
        await Cargar();
    }

    private async Task Todo()
    {
        modoTodo = true;
        await Cargar();
    }

    private static string Dinero(decimal monto) => $"${monto:0.00}";

    // El ancho de la barra se arma con la cultura invariante para que no salga con coma.
    private static string Porcentaje(decimal parte, decimal total) =>
        total <= 0 ? "0" : Math.Min(100m, parte / total * 100m).ToString("0.#", CultureInfo.InvariantCulture);

    private static string Servicio(VentaCajaDTO venta) =>
        venta.NumeroMesa != null
            ? $"Mesa {venta.NumeroMesa}"
            : venta.TipoServicio switch
            {
                EnumTipoServicio.Mesa => "Salón",
                EnumTipoServicio.TakeAway => "Take Away",
                _ => venta.TipoServicio.ToString()
            };

    private string FechaHora(DateTime fechaUtc)
    {
        var local = HoraArgentina.DesdeUtc(fechaUtc);
        return desde.Date == hasta.Date ? local.ToString("HH:mm") : local.ToString("dd/MM HH:mm");
    }
}
