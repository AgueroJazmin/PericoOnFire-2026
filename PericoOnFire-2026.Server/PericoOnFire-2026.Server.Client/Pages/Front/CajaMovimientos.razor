@using PericoOnFire_2026.Shared.DTOs
@using PericoOnFire_2026.Shared.ENUM
@using PericoOnFire_2026.Shared.Utilidades
@using PericoOnFire_2026.Servicio.ServicioHttp
@inject IHttpServicio http

@* Movimientos de dinero del turno abierto: ingresos, egresos (gastos, proveedores) y retiros de
   efectivo, cada uno con su motivo. Los cobros no se cargan acá: se ven en Ventas. *@

<div class="cm-contenedor">

    @if (!CajaAbierta)
    {
        <div class="alert alert-warning">
            La caja está cerrada. Abrí un turno desde la parte de arriba para registrar movimientos.
        </div>
    }
    else
    {
        <section class="cm-tarjetas">
            <div class="cm-tarjeta cm-tarjeta-principal">
                <span>Efectivo en caja</span>
                <strong>@Dinero(Estado!.EfectivoEsperado)</strong>
            </div>
            <div class="cm-tarjeta">
                <span>Ingresos</span>
                <strong class="cm-positivo">@Dinero(Estado.Ingresos)</strong>
            </div>
            <div class="cm-tarjeta">
                <span>Egresos y retiros</span>
                <strong class="cm-negativo">@Dinero(Estado.Egresos + Estado.Retiros)</strong>
            </div>
        </section>

        <section class="cm-formulario">
            <h5>Nuevo movimiento</h5>

            <div class="cm-grilla">
                <div class="cm-campo">
                    <label>Tipo</label>
                    <select class="form-select" @bind="nuevo.TipoMovimiento">
                        <option value="@EnumTipoMovCaja.Ingreso">Ingreso (entra dinero)</option>
                        <option value="@EnumTipoMovCaja.Egreso">Egreso (gasto o pago)</option>
                        <option value="@EnumTipoMovCaja.Retiro">Retiro (sacar efectivo)</option>
                    </select>
                    <small class="cm-ayuda">@AyudaTipo</small>
                </div>

                <div class="cm-campo">
                    <label>Monto</label>
                    <input type="number" step="0.01" min="0" class="form-control" @bind="nuevo.Monto" />
                </div>

                <div class="cm-campo cm-campo-ancho">
                    <label>Motivo</label>
                    <input type="text" maxlength="200" class="form-control" @bind="nuevo.Motivo"
                           placeholder="@PlaceholderMotivo" />
                </div>

                <div class="cm-campo cm-campo-ancho">
                    <label>Observaciones (opcional)</label>
                    <input type="text" maxlength="300" class="form-control" @bind="nuevo.Observaciones" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert @(esError ? "alert-danger" : "alert-success") mt-2 mb-0">@mensaje</div>
            }

            <button type="button" class="btn btn-success w-100 mt-3" disabled="@procesando" @onclick="Registrar">
                Registrar movimiento
            </button>
        </section>
    }

    <section class="cm-listado">
        <h5>Movimientos del turno</h5>

        @if (!movimientos.Any())
        {
            <p class="texto-vacio">Todavía no hay movimientos en este turno.</p>
        }

        @foreach (var movimiento in movimientos)
        {
            <article class="cm-movimiento">
                <div class="cm-movimiento-cabecera">
                    <span class="cm-etiqueta @ClaseEtiqueta(movimiento)">@movimiento.TipoMovimiento</span>
                    <span class="cm-monto @ClaseMonto(movimiento)">@Signo(movimiento)@Dinero(movimiento.Monto)</span>
                </div>
                <div class="cm-motivo">@movimiento.Motivo</div>
                @if (!string.IsNullOrWhiteSpace(movimiento.Observaciones))
                {
                    <div class="cm-observaciones">@movimiento.Observaciones</div>
                }
                <div class="cm-info">@HoraArgentina.DesdeUtc(movimiento.FechaMovimiento).ToString("HH:mm") · @(movimiento.NombreUsuario ?? "—")</div>
            </article>
        }
    </section>
</div>

<style>
    .cm-contenedor {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        color: #222;
    }

    .cm-tarjetas {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: .75rem;
    }

    .cm-tarjeta {
        display: flex;
        flex-direction: column;
        gap: .15rem;
        background: white;
        border-radius: 8px;
        padding: .75rem 1rem;
        border-left: 4px solid #ccc;
        min-width: 0;
    }

        .cm-tarjeta span {
            font-size: .85rem;
            color: #666;
        }

        .cm-tarjeta strong {
            font-size: 1.3rem;
            overflow-wrap: anywhere;
        }

    .cm-tarjeta-principal {
        border-left-color: #2e7d32;
    }

    .cm-positivo {
        color: #2e7d32;
    }

    .cm-negativo {
        color: #d32f2f;
    }

    .cm-formulario {
        background: white;
        border-radius: 8px;
        padding: 1rem;
    }

        .cm-formulario h5 {
            margin: 0 0 .75rem;
        }

    .cm-grilla {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .6rem .75rem;
    }

    .cm-campo {
        display: flex;
        flex-direction: column;
        gap: .2rem;
        min-width: 0;
    }

        .cm-campo label {
            font-size: .85rem;
            color: #666;
        }

    .cm-campo-ancho {
        grid-column: 1 / -1;
    }

    .cm-ayuda {
        color: #777;
        line-height: 1.3;
    }

    .cm-listado {
        background: #f4f4f4;
        border-radius: 8px;
        padding: .75rem;
    }

        .cm-listado h5 {
            margin: 0 0 .6rem;
        }

    .cm-movimiento {
        background: white;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: .6rem .75rem;
        margin-bottom: .6rem;
    }

    .cm-movimiento-cabecera {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
    }

    .cm-etiqueta {
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        padding: .15rem .55rem;
        border-radius: 999px;
        background: #eee;
        color: #444;
    }

    .cm-etiqueta-entrada {
        background: #e6f4ea;
        color: #1e6b32;
    }

    .cm-etiqueta-salida {
        background: #fdecea;
        color: #a52720;
    }

    .cm-monto {
        font-weight: bold;
        white-space: nowrap;
    }

    .cm-motivo {
        margin-top: .3rem;
        overflow-wrap: anywhere;
    }

    .cm-observaciones {
        font-size: .85rem;
        color: #555;
        overflow-wrap: anywhere;
    }

    .cm-info {
        margin-top: .2rem;
        font-size: .8rem;
        color: #777;
    }

    @@media (max-width: 560px) {
        .cm-grilla {
            grid-template-columns: 1fr;
        }

        .cm-tarjetas {
            grid-template-columns: 1fr 1fr;
        }

        .cm-tarjeta-principal {
            grid-column: 1 / -1;
        }

        .cm-formulario {
            padding: .75rem;
        }
    }
</style>

@code {
    // La caja le pasa el estado que ya tiene cargado, así este componente no lo vuelve a pedir.
    [Parameter] public EstadoCajaDTO? Estado { get; set; }

    // Avisa a la caja que algo cambió para que refresque lo que muestra arriba (efectivo en caja).
    [Parameter] public EventCallback OnCambio { get; set; }

    private List<MovimientoCajaDTO> movimientos = new();
    private MovimientoCajaCrearDTO nuevo = new();
    private bool procesando;
    private bool esError;
    private string? mensaje;

    private bool CajaAbierta => Estado?.Abierta == true;

    private string AyudaTipo => nuevo.TipoMovimiento switch
    {
        EnumTipoMovCaja.Ingreso => "Entra efectivo al cajón y no es una venta. Ej.: sumás cambio o el dueño deja plata.",
        EnumTipoMovCaja.Egreso => "Sale efectivo del cajón para pagar algo del local. Ej.: proveedor, hielo, repartidor.",
        _ => "Sacás efectivo del cajón para guardarlo, no es un gasto. Ej.: depositar o llevar a la caja fuerte."
    };

    private string PlaceholderMotivo => nuevo.TipoMovimiento switch
    {
        EnumTipoMovCaja.Ingreso => "Ej: aporte de cambio",
        EnumTipoMovCaja.Egreso => "Ej: pago a proveedor",
        _ => "Ej: retiro para depositar"
    };

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        var respuesta = await http.Get<List<MovimientoCajaDTO>>("api/Caja/Movimientos");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            movimientos = respuesta.Respuesta;
        }
    }

    private async Task Registrar()
    {
        mensaje = null;
        esError = true;

        if (nuevo.Monto <= 0)
        {
            mensaje = "El monto debe ser mayor a cero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevo.Motivo))
        {
            mensaje = "El motivo es obligatorio.";
            return;
        }

        procesando = true;

        var respuesta = await http.Post<MovimientoCajaCrearDTO, MovimientoCajaDTO>("api/Caja/Movimientos", nuevo);

        procesando = false;

        if (respuesta.Error)
        {
            mensaje = respuesta.ObtenerError();
            return;
        }

        esError = false;
        mensaje = "Movimiento registrado.";

        // Se conserva el tipo elegido por si se cargan varios seguidos del mismo tipo.
        nuevo = new MovimientoCajaCrearDTO { TipoMovimiento = nuevo.TipoMovimiento };

        await Cargar();
        await OnCambio.InvokeAsync();
    }

    private static string Dinero(decimal monto) => $"${monto:0.00}";

    private static string Signo(MovimientoCajaDTO m) => m.EsEntrada ? "+" : m.EsSalida ? "−" : "";

    private static string ClaseEtiqueta(MovimientoCajaDTO m) =>
        m.EsEntrada ? "cm-etiqueta-entrada" : m.EsSalida ? "cm-etiqueta-salida" : "";

    private static string ClaseMonto(MovimientoCajaDTO m) =>
        m.EsEntrada ? "cm-positivo" : m.EsSalida ? "cm-negativo" : "";
}
