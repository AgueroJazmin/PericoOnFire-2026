@using PericoOnFire_2026.Shared.DTOs
@using PericoOnFire_2026.Shared.Utilidades
@using PericoOnFire_2026.Servicio.ServicioHttp
@using PericoOnFire_2026.Server.Client.Shared
@inject IHttpServicio http

@* Arqueo: se compara el efectivo que el sistema espera en el cajón con el que se cuenta de verdad,
   y al confirmar se cierra el turno. El efectivo contado no se autocompleta a propósito: si viniera
   cargado con el esperado, el arqueo dejaría de ser un control. *@

<div class="ca-contenedor">

    @if (!CajaAbierta)
    {
        <div class="alert alert-info">
            La caja está cerrada. Para empezar a cobrar, abrí un turno desde la parte de arriba.
        </div>
    }
    else
    {
        <section class="ca-cierre">
            <h5>Cierre de caja</h5>

            <div class="ca-detalle">
                <div class="ca-fila"><span>Monto inicial</span><span>@Dinero(Estado!.MontoInicial)</span></div>
                <div class="ca-fila"><span>+ Cobros en efectivo</span><span>@Dinero(Estado.CobrosEfectivo)</span></div>
                <div class="ca-fila"><span>+ Ingresos</span><span>@Dinero(Estado.Ingresos)</span></div>
                <div class="ca-fila"><span>− Egresos</span><span>@Dinero(Estado.Egresos)</span></div>
                <div class="ca-fila"><span>− Retiros</span><span>@Dinero(Estado.Retiros)</span></div>
                <div class="ca-fila ca-fila-total"><span>Efectivo esperado</span><strong>@Dinero(Estado.EfectivoEsperado)</strong></div>
            </div>

            <div class="ca-informativo">
                <strong>Cobros que no son en efectivo</strong>
                <div class="ca-detalle ca-detalle-suave">
                    <div class="ca-fila"><span>Débito</span><span>@Dinero(Estado.CobrosDebito)</span></div>
                    <div class="ca-fila"><span>Crédito</span><span>@Dinero(Estado.CobrosCredito)</span></div>
                    <div class="ca-fila"><span>Transferencia</span><span>@Dinero(Estado.CobrosTransferencia)</span></div>
                    <div class="ca-fila"><span>QR</span><span>@Dinero(Estado.CobrosQR)</span></div>
                </div>
                <small>Esta plata no está en el cajón (va al posnet, al banco o a la app de QR), por eso no se cuenta acá. Se muestra solo para que después la compares con esos resúmenes.</small>
            </div>

            <div class="ca-campo">
                <label>Efectivo contado en el cajón</label>
                <input type="number" step="0.01" min="0" class="form-control" placeholder="Contá el efectivo y cargalo acá"
                       @bind="montoContado" @bind:event="oninput" />
            </div>

            @if (montoContado != null)
            {
                <div class="ca-diferencia @ClaseDiferencia">@TextoDiferencia</div>
            }

            <div class="ca-campo">
                <label>Observaciones (opcional)</label>
                <textarea class="form-control" rows="2" maxlength="300" @bind="observaciones"></textarea>
            </div>

            @if (CuentasPendientes > 0)
            {
                <div class="alert alert-warning mt-2 mb-0">
                    Hay @CuentasPendientes @(CuentasPendientes == 1 ? "cuenta esperando" : "cuentas esperando") cobro.
                    Si cerrás ahora, se cobrarán en el próximo turno y no entrarán en este arqueo.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert alert-danger mt-2 mb-0">@mensaje</div>
            }

            <button type="button" class="btn btn-dark w-100 mt-3" disabled="@(procesando || montoContado == null)" @onclick="PedirCierre">
                Cerrar caja y guardar arqueo
            </button>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(resultado))
    {
        <div class="alert alert-success mb-0">@resultado</div>
    }

    <section class="ca-historial">
        <h5>Arqueos anteriores</h5>
        <p class="ca-ayuda">Cada arqueo muestra con cuánto efectivo se abrió el cajón, cuánto debía haber según el sistema y cuánto se contó de verdad. La diferencia es lo contado menos lo que debía haber.</p>

        @if (!turnos.Any())
        {
            <p class="texto-vacio">Todavía no hay arqueos guardados.</p>
        }

        @foreach (var turno in turnos)
        {
            <article class="ca-turno">
                <div class="ca-turno-cabecera">
                    <strong>@FechaHora(turno.FechaApertura) → @FechaHora(turno.FechaCierre)</strong>
                    <span class="ca-etiqueta @ClaseDiferenciaTurno(turno)">@EtiquetaDiferencia(turno)</span>
                </div>
                <div class="ca-turno-cifras">
                    <span>Abrió con <strong>@Dinero(turno.MontoInicial)</strong></span>
                    <span>Debía haber <strong>@Dinero(turno.MontoEsperado ?? 0)</strong></span>
                    <span>Se contó <strong>@Dinero(turno.MontoContado ?? 0)</strong></span>
                </div>
                <div class="ca-turno-info">
                    Abrió @(turno.NombreUsuarioApertura ?? "—") · Cerró @(turno.NombreUsuarioCierre ?? "—")
                </div>
                @if (!string.IsNullOrWhiteSpace(turno.ObservacionesCierre))
                {
                    <div class="ca-turno-obs">@turno.ObservacionesCierre</div>
                }
                <button type="button" class="ca-ojo" title="Ver movimientos de este turno" @onclick="() => VerMovimientos(turno)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg>
                    Ver movimientos
                </button>
            </article>
        }
    </section>
</div>

@if (turnoVisto != null)
{
    <div class="ca-modal-fondo" @onclick="CerrarMovimientos">
        <div class="ca-modal" role="dialog" aria-modal="true" aria-label="Movimientos del turno"
             @onclick="() => { }" @onclick:stopPropagation="true">
            <header class="ca-modal-cabecera">
                <div class="ca-modal-titulo">
                    <strong>Movimientos del turno</strong>
                    <small>@FechaHora(turnoVisto.FechaApertura) → @FechaHora(turnoVisto.FechaCierre)</small>
                </div>
                <button type="button" class="ca-modal-cerrar" aria-label="Cerrar" @onclick="CerrarMovimientos">&times;</button>
            </header>

            <div class="ca-modal-cuerpo">
                @if (cargandoMovimientos)
                {
                    <p class="texto-vacio">Cargando…</p>
                }
                else if (!movimientosVistos.Any())
                {
                    <p class="texto-vacio">Este turno no tiene movimientos guardados.</p>
                }

                @foreach (var movimiento in movimientosVistos)
                {
                    <article class="ca-mov">
                        <div class="ca-mov-cabecera">
                            <span class="ca-etiqueta @ClaseEtiquetaMov(movimiento)">@movimiento.TipoMovimiento</span>
                            <span class="ca-mov-monto @ClaseMontoMov(movimiento)">@SignoMov(movimiento)@Dinero(movimiento.Monto)</span>
                        </div>
                        <div class="ca-mov-motivo">@movimiento.Motivo</div>
                        @if (!string.IsNullOrWhiteSpace(movimiento.Observaciones))
                        {
                            <div class="ca-turno-obs">@movimiento.Observaciones</div>
                        }
                        <div class="ca-turno-info">@FechaHora(movimiento.FechaMovimiento) · @(movimiento.NombreUsuario ?? "—")</div>
                    </article>
                }
            </div>
        </div>
    </div>
}

<Confirmacion @ref="confirmacionCierre"
              Titulo="Cerrar caja"
              textOk="Sí, cerrar caja"
              textCancelar="Volver"
              onConfirm="ConfirmarCierre"
              onCancel="() => confirmacionCierre!.Ocultar()">
    @if (Estado != null && montoContado != null)
    {
        <p>
            Esperado <strong>@Dinero(Estado.EfectivoEsperado)</strong> · contado <strong>@Dinero(montoContado.Value)</strong>.
        </p>
        <p><strong>@TextoDiferencia</strong></p>
        <p>Una vez cerrada, para cobrar hay que abrir un turno nuevo.</p>
    }
</Confirmacion>

