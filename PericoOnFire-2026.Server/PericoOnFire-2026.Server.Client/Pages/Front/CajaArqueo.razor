@code {
    // La caja le pasa el estado que ya tiene cargado y cuántas cuentas siguen esperando cobro.
    [Parameter] public EstadoCajaDTO? Estado { get; set; }
    [Parameter] public int CuentasPendientes { get; set; }

    // Avisa a la caja que el turno cambió (se cerró) para que refresque todo.
    [Parameter] public EventCallback OnCambio { get; set; }

    private List<TurnoCajaDTO> turnos = new();
    private decimal? montoContado;
    private string? observaciones;
    private bool procesando;
    private string? mensaje;
    private string? resultado;

    private Confirmacion? confirmacionCierre;

    // Movimientos de un arqueo anterior (se ven en un modal).
    private TurnoCajaDTO? turnoVisto;
    private List<MovimientoCajaDTO> movimientosVistos = new();
    private bool cargandoMovimientos;

    private bool CajaAbierta => Estado?.Abierta == true;

    // Contado menos esperado: positivo es sobrante, negativo es faltante.
    private decimal Diferencia => (montoContado ?? 0) - (Estado?.EfectivoEsperado ?? 0);

    private string TextoDiferencia =>
        Diferencia == 0 ? "Sin diferencia: el cajón coincide con lo esperado."
        : Diferencia > 0 ? $"Sobrante de {Dinero(Diferencia)}"
        : $"Faltante de {Dinero(-Diferencia)}";

    private string ClaseDiferencia => Diferencia == 0 ? "ca-ok" : Diferencia > 0 ? "ca-sobrante" : "ca-faltante";

    protected override async Task OnInitializedAsync()
    {
        await CargarTurnos();
    }

    private async Task CargarTurnos()
    {
        var respuesta = await http.Get<List<TurnoCajaDTO>>("api/Caja/Turnos");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            turnos = respuesta.Respuesta;
        }
    }

    private async Task VerMovimientos(TurnoCajaDTO turno)
    {
        turnoVisto = turno;
        movimientosVistos = new();
        cargandoMovimientos = true;

        var respuesta = await http.Get<List<MovimientoCajaDTO>>($"api/Caja/Movimientos?idTurno={turno.Id}");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            movimientosVistos = respuesta.Respuesta;
        }

        cargandoMovimientos = false;
    }

    private void CerrarMovimientos()
    {
        turnoVisto = null;
        movimientosVistos = new();
    }

    private void PedirCierre()
    {
        mensaje = null;

        if (montoContado == null || montoContado < 0)
        {
            mensaje = "Cargá el efectivo contado en el cajón.";
            return;
        }

        confirmacionCierre?.Ver();
    }

    private async Task ConfirmarCierre()
    {
        if (montoContado == null) return;

        procesando = true;

        var dto = new CerrarCajaDTO
        {
            MontoContado = montoContado.Value,
            Observaciones = observaciones
        };

        var diferenciaAlCerrar = TextoDiferencia;

        var respuesta = await http.Post<CerrarCajaDTO, TurnoCajaDTO>("api/Caja/Cerrar", dto);

        confirmacionCierre?.Ocultar();
        procesando = false;

        if (respuesta.Error)
        {
            mensaje = respuesta.ObtenerError();
            return;
        }

        resultado = $"Caja cerrada y arqueo guardado. {diferenciaAlCerrar}";
        montoContado = null;
        observaciones = null;

        await CargarTurnos();
        await OnCambio.InvokeAsync();
    }

    private static string Dinero(decimal monto) => $"${monto:0.00}";

    private static string FechaHora(DateTime? fechaUtc) =>
        fechaUtc == null ? "—" : HoraArgentina.DesdeUtc(fechaUtc.Value).ToString("dd/MM HH:mm");

    private static string SignoMov(MovimientoCajaDTO m) => m.EsEntrada ? "+" : m.EsSalida ? "−" : "";

    private static string ClaseEtiquetaMov(MovimientoCajaDTO m) =>
        m.EsEntrada ? "ca-etiqueta-entrada" : m.EsSalida ? "ca-etiqueta-salida" : "";

    private static string ClaseMontoMov(MovimientoCajaDTO m) =>
        m.EsEntrada ? "ca-mov-entrada" : m.EsSalida ? "ca-mov-salida" : "";

    private static string EtiquetaDiferencia(TurnoCajaDTO turno) =>
        (turno.Diferencia ?? 0) == 0 ? "Sin diferencia"
        : turno.Diferencia > 0 ? $"Sobrante {Dinero(turno.Diferencia!.Value)}"
        : $"Faltante {Dinero(-turno.Diferencia!.Value)}";

    private static string ClaseDiferenciaTurno(TurnoCajaDTO turno) =>
        (turno.Diferencia ?? 0) == 0 ? "ca-ok" : turno.Diferencia > 0 ? "ca-sobrante" : "ca-faltante";
}
