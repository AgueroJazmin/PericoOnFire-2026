    protected override async Task OnInitializedAsync()
    {
        // Las llamadas autenticadas usan la cookie del navegador.
        // El prerenderizado del servidor solo prepara la vista y la sesión.
        if (!OperatingSystem.IsBrowser()) return;

        await CargarCategorias();
        await CargarSubcategorias();
        await CargarProductos();
        await CargarUsuarios();
        await CargarMesas();
        await CargarSalas();

        Polling.Iniciar(ActualizarTodo, TimeSpan.FromSeconds(2));
    }

    private async Task ActualizarTodo()
    {
        await CargarCategorias();
        await CargarSubcategorias();
        await CargarProductos();
        await CargarUsuarios();
        await CargarMesas();
        await CargarSalas();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await Polling.DisposeAsync();
    }

    private void CambiarTab(string tab)
    {
        if (salaEditandoNombreId != null) { MensajeMesas = "Guardá o cancelá el nombre antes de cambiar de pestaña."; return; }
        if (editandoDistribucion) { MensajeMesas = "Guardá o cancelá la distribución antes de cambiar de pestaña."; return; }
        tabActiva = tab;
        seccionActiva = "";
        Mensaje = "";
        CancelarEdicion();
