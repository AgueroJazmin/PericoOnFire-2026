    private bool editandoDistribucion;
    private bool guardandoDistribucion;
    private bool distribucionModificada;
    private List<MesaDTO> borradorMesas = new();
    private MesaDTO? mesaParaMover;

    private void IniciarDistribucion()
    {
        borradorMesas = mesas.Select(m => new MesaDTO
        {
            Id = m.Id, NumeroMesa = m.NumeroMesa, IdSala = m.IdSala,
            Fila = m.Fila, Columna = m.Columna, Forma = m.Forma, Tamanio = m.Tamanio
        }).ToList();
        mesaSeleccionadaConfig = null;
        mesaParaMover = null;
        MensajeMesas = null;
        distribucionModificada = false;
        editandoDistribucion = true;
    }

    private void ElegirMesaParaMover(MesaDTO mesa)
    {
        if (editandoDistribucion && !guardandoDistribucion) mesaParaMover = mesa;
    }

    private void PulsarMesa(MesaDTO mesa)
    {
        if (!editandoDistribucion) { SeleccionarMesaConfig(mesa); return; }
        if (guardandoDistribucion) return;
        if (mesaParaMover == null) ElegirMesaParaMover(mesa);
        else MoverMesa(mesa.Fila, mesa.Columna);
    }

    private async Task PulsarCelda(int fila, int columna)
    {
        if (editandoDistribucion) MoverMesa(fila, columna);
        else await CrearMesaEnCelda(fila, columna);
    }

    private void MoverMesa(int fila, int columna)
    {
        if (!editandoDistribucion || guardandoDistribucion || mesaParaMover == null) return;
        var origen = mesaParaMover;
        var destino = MesasSalaActual.FirstOrDefault(m => m.Fila == fila && m.Columna == columna);
        if (destino != null)
        {
            destino.Fila = origen.Fila;
            destino.Columna = origen.Columna;
        }
        origen.Fila = fila;
        origen.Columna = columna;
        mesaParaMover = null;
        distribucionModificada = MesasSalaActual.Any(m =>
        {
            var original = mesas.First(o => o.Id == m.Id);
            return m.Fila != original.Fila || m.Columna != original.Columna;
        });
    }

    private void CancelarDistribucion()
    {
        if (guardandoDistribucion) return;
        editandoDistribucion = false;
        borradorMesas.Clear();
        mesaParaMover = null;
        distribucionModificada = false;
        MensajeMesas = "Movimientos descartados.";
    }

    private async Task GuardarDistribucion()
    {
        if (guardandoDistribucion || !distribucionModificada || salaSeleccionadaId == null) return;
        guardandoDistribucion = true;
        MensajeMesas = null;
        try
        {
            var dto = new DistribucionMesasDTO
            {
                IdSala = salaSeleccionadaId.Value,
                Mesas = MesasSalaActual.Select(m =>
                {
                    var original = mesas.First(o => o.Id == m.Id);
                    return new PosicionMesaDTO
                    {
                        Id = m.Id, Fila = m.Fila, Columna = m.Columna,
                        FilaOriginal = original.Fila, ColumnaOriginal = original.Columna
                    };
                }).ToList()
            };
            var resp = await http.Put<DistribucionMesasDTO>("api/Mesa/Distribucion", dto);
            if (resp.Error) { MensajeMesas = resp.ObtenerError(); return; }
            editandoDistribucion = false;
            mesaParaMover = null;
            borradorMesas.Clear();
            distribucionModificada = false;
            await CargarMesas();
            MensajeMesas = "Distribución guardada. Ya se muestra en Comandas.";
        }
        catch (Exception)
        {
            MensajeMesas = "No se pudo confirmar el guardado. Revisá la conexión e intentá de nuevo. Si ya se guardó, cancelá y recargá la página.";
        }
        finally { guardandoDistribucion = false; }
    }

    //Nuevos metodos para mesas
    private async Task CargarMesas()
    {
        if (editandoDistribucion) return;
        var resp = await http.Get<List<MesaDTO>>("api/Mesa");

        if (!resp.Error && resp.Respuesta != null)
        {
            if (!editandoDistribucion) mesas = resp.Respuesta;
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private async Task CargarSalas()
    {
        if (editandoDistribucion) return;
        var resp = await http.Get<List<SalaDTO>>("api/Sala");

        if (!resp.Error && resp.Respuesta != null)
        {
            if (editandoDistribucion) return;
            salas = resp.Respuesta;
            if (salaSeleccionadaId == null && salas.Any())
                salaSeleccionadaId = salas.OrderBy(s => s.Orden).First().Id;
        }
    }

    private void SeleccionarSala(int idSala)
    {
        salaSeleccionadaId = idSala;
        mesaSeleccionadaConfig = null;
        MensajeMesas = null;
    }

    private int? salaEditandoNombreId;
    private string nombreSalaEditado = "";
    private bool guardandoNombreSala;

    private void EditarNombreSala(SalaDTO sala)
    {
        if (editandoDistribucion || guardandoNombreSala) return;
        salaEditandoNombreId = sala.Id;
        nombreSalaEditado = sala.Nombre;
        MensajeMesas = null;
    }

    private void CancelarNombreSala()
    {
        if (guardandoNombreSala) return;
        salaEditandoNombreId = null;
        nombreSalaEditado = "";
        MensajeMesas = null;
    }

    private async Task TeclaNombreSala(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await GuardarNombreSala();
        else if (e.Key == "Escape") CancelarNombreSala();
    }

    private async Task GuardarNombreSala()
    {
        if (salaEditandoNombreId == null || guardandoNombreSala) return;
        var nombre = nombreSalaEditado.Trim();
        if (string.IsNullOrWhiteSpace(nombre) || nombre.Length > 60)
        {
            MensajeMesas = "El nombre debe tener entre 1 y 60 caracteres.";
            return;
        }
        var sala = salas.FirstOrDefault(s => s.Id == salaEditandoNombreId);
        if (sala == null) { MensajeMesas = "La sala ya no existe. Recargá la página."; return; }
        guardandoNombreSala = true;
        try
        {
            var dto = new SalaCrearDTO { Nombre = nombre, Orden = sala.Orden };
            var resp = await http.Put<SalaCrearDTO>($"api/Sala/{sala.Id}", dto);
            if (resp.Error) { MensajeMesas = resp.ObtenerError(); return; }
            sala.Nombre = nombre;
            salaEditandoNombreId = null;
            nombreSalaEditado = "";
            await CargarSalas();
            MensajeMesas = "Nombre de la sala actualizado.";
        }
        catch (Exception)
        {
            MensajeMesas = "No se pudo confirmar el cambio. Revisá la conexión y volvé a intentar.";
        }
        finally { guardandoNombreSala = false; }
    }

    private async Task CrearSala()
    {
        if (string.IsNullOrWhiteSpace(nombreNuevaSala)) return;

        var dto = new SalaCrearDTO { Nombre = nombreNuevaSala.Trim() };
        var resp = await http.Post<SalaCrearDTO, int>("api/Sala", dto);

        if (!resp.Error)
        {
            nombreNuevaSala = "";
            mostrarFormNuevaSala = false;
            await CargarSalas();
            salaSeleccionadaId = resp.Respuesta;
        }
        else
        {
            MensajeMesas = resp.ObtenerError();
        }
    }

    private async Task EliminarSala(int idSala)
    {
        var resp = await http.Delete($"api/Sala/{idSala}");

        if (!resp.Error)
        {
            salaSeleccionadaId = null;
            mesaSeleccionadaConfig = null;
            await CargarSalas();
        }
        else
        {
            MensajeMesas = resp.ObtenerError();
        }
    }

    private async Task CrearMesaEnCelda(int fila, int columna)
    {
        if (salaSeleccionadaId == null) return;

        var dto = new MesaCrearDTO { IdSala = salaSeleccionadaId.Value, Fila = fila, Columna = columna };
        var resp = await http.Post<MesaCrearDTO, MesaDTO>("api/Mesa/EnCelda", dto);

        if (!resp.Error)
        {
            MensajeMesas = null;
            await CargarMesas();
            if (resp.Respuesta != null)
                SeleccionarMesaConfig(resp.Respuesta);
        }
        else
        {
            MensajeMesas = resp.ObtenerError();
        }
    }

    private void SeleccionarMesaConfig(MesaDTO m)
    {
        mesaSeleccionadaConfig = m;
        numeroEditado = m.NumeroMesa;
        salaDestinoEditada = m.IdSala ?? salaSeleccionadaId ?? 0;
        formaEditada = m.Forma;
        tamanioEditada = m.Tamanio;
    }

    private async Task GuardarMesaConfig()
    {
        if (mesaSeleccionadaConfig == null) return;

        var dto = new MesaDTO
        {
            NumeroMesa = numeroEditado,
            Estado = mesaSeleccionadaConfig.Estado,
            IdSala = salaDestinoEditada,
            Fila = mesaSeleccionadaConfig.Fila,
            Columna = mesaSeleccionadaConfig.Columna,
            Forma = formaEditada,
            Tamanio = tamanioEditada
        };

        var resp = await http.Put<MesaDTO>($"api/Mesa/{mesaSeleccionadaConfig.Id}", dto);

        if (!resp.Error)
        {
            MensajeMesas = "Mesa actualizada.";
            mesaSeleccionadaConfig = null;
            await CargarMesas();
        }
        else
        {
            MensajeMesas = resp.ObtenerError();
        }
    }

    private async Task EliminarMesaConfig(int id)
    {
        var resp = await http.Delete($"api/Mesa/{id}");

        if (!resp.Error)
        {
            mesaSeleccionadaConfig = null;
            await CargarMesas();
        }
        else
        {
            MensajeMesas = resp.ObtenerError();
        }
    }

