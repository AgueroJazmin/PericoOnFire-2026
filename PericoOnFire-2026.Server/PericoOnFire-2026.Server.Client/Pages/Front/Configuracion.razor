@page "/configuracion"
@using PericoOnFire_2026.Shared.DTOs
@using PericoOnFire_2026.Shared.ENUM
@using PericoOnFire_2026.Servicio.ServicioHttp

@inject IHttpServicio http

<div class="config-page">

    <h2>Configuración</h2>
    <p>Alta de categorías, subcategorías y productos.</p>

    <div class="config-cards">

        <button class="config-card" @onclick="AbrirCategoria">
            <i class="bi bi-tags-fill"></i>
            <span>Cargar Categoría</span>
        </button>

        <button class="config-card" @onclick="AbrirSubcategoria">
            <i class="bi bi-diagram-3-fill"></i>
            <span>Cargar Subcategoría</span>
        </button>

        <button class="config-card" @onclick="AbrirProducto">
            <i class="bi bi-box-seam-fill"></i>
            <span>Cargar Producto</span>
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert alert-info mt-3">
            @Mensaje
        </div>
    }

</div>

@if (modalCategoria)
{
    <div class="modal-fondo">
        <div class="modal-card">
            <h4>Cargar Categoría</h4>

            <EditForm Model="categoria" OnValidSubmit="GuardarCategoria">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label>Nombre categoría</label>
                    <InputText class="form-control"
                               @bind-Value="categoria.NombreCategoria" />
                </div>

                <div class="modal-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="CerrarModales">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (modalSubcategoria)
{
    <div class="modal-fondo">
        <div class="modal-card">
            <h4>Cargar Subcategoría</h4>

            <EditForm Model="subcategoria" OnValidSubmit="GuardarSubcategoria">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label>Id Categoría</label>
                    <InputSelect class="form-select"
                                 @bind-Value="subcategoria.IdCategoria">

                        <option value="0">Seleccione una categoría</option>

                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.Id">
                                @cat.NombreCategoria
                            </option>
                        }

                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label>Nombre subcategoría</label>
                    <InputText class="form-control"
                               @bind-Value="subcategoria.NombreSubcategoria" />
                </div>

                <div class="modal-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="CerrarModales">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (modalProducto)
{
    <div class="modal-fondo">
        <div class="modal-card modal-card-lg">
            <h4>Cargar Producto</h4>

            <EditForm Model="producto" OnValidSubmit="GuardarProducto">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label>Nombre producto</label>
                    <InputText class="form-control"
                               @bind-Value="producto.Nombre" />
                </div>

                <div class="mb-3">
                    <label>Precio</label>
                    <InputNumber class="form-control"
                                 @bind-Value="producto.Precio" />
                </div>

                <div class="mb-3">
                    <label>Subcategoría</label>
                    <InputSelect class="form-select"
                                 @bind-Value="producto.IdSubcategoria">
                        <option value="0">Seleccione una subcategoría</option>

                        @foreach (var sub in subcategorias)
                        {
                            <option value="@sub.Id">@sub.NombreSubcategoria</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label>Sector destino</label>
                    <InputSelect class="form-control"
                                 @bind-Value="producto.SectorDestino">
                        @foreach (var sector in Enum.GetValues<EnumSectorDestino>())
                        {
                            <option value="@sector">@sector</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="producto.Activo" />
                    <label class="form-check-label">Activo</label>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <button class="btn btn-secondary" type="button" @onclick="CerrarModales">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
    .config-page {
        background: white;
        min-height: calc(100vh - 64px);
        padding: 2rem;
        border-radius: 0.5rem;
    }

        .config-page h2 {
            font-weight: bold;
            margin-bottom: .3rem;
        }

    .config-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .config-card {
        height: 160px;
        background: #f20b0b;
        color: black;
        border: none;
        border-radius: 1.2rem;
        font-weight: bold;
        font-size: 1.1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        box-shadow: 0 5px 14px rgba(0,0,0,.25);
    }

        .config-card i {
            font-size: 2.3rem;
            margin-bottom: .7rem;
        }

        .config-card:hover {
            transform: scale(1.03);
            background: #d90000;
        }

    .modal-fondo {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.55);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal-card {
        width: 420px;
        background: white;
        padding: 1.5rem;
        border-radius: 1rem;
        box-shadow: 0 6px 25px rgba(0,0,0,.35);
    }

    .modal-card-lg {
        width: 520px;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: .8rem;
        margin-top: 1rem;
    }
</style>

@code {
    private List<CategoriaListadoDTO> categorias = new();
    private List<SubcategoriaListadoDTO> subcategorias = new();

    private bool modalCategoria = false;
    private bool modalSubcategoria = false;
    private bool modalProducto = false;

    private string Mensaje = "";

    private CategoriaCrearDTO categoria = new();
    private SubcategoriaCrearDTO subcategoria = new();
    private ProductoCrearDTO producto = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
        await CargarSubcategorias();
    }

    private async Task CargarCategorias()
    {
        var resp = await http.Get<List<CategoriaListadoDTO>>("api/Categoria");

        if (!resp.Error && resp.Respuesta != null)
        {
            categorias = resp.Respuesta;
        }
    }

    private async Task CargarSubcategorias()
    {
        var resp = await http.Get<List<SubcategoriaListadoDTO>>("api/Subcategoria");

        if (!resp.Error && resp.Respuesta != null)
        {
            subcategorias = resp.Respuesta;
        }
    }

    private void AbrirCategoria()
    {
        Mensaje = "";
        categoria = new();
        modalCategoria = true;
    }

    private void AbrirSubcategoria()
    {
        Mensaje = "";
        subcategoria = new();
        modalSubcategoria = true;
    }

    private void AbrirProducto()
    {
        Mensaje = "";
        producto = new();
        modalProducto = true;
    }

    private void CerrarModales()
    {
        modalCategoria = false;
        modalSubcategoria = false;
        modalProducto = false;
    }

    private async Task GuardarCategoria()
    {
        var resp = await http.Post<CategoriaCrearDTO, int>("api/Categoria", categoria);

        if (!resp.Error)
        {
            Mensaje = "Categoría cargada correctamente.";
            CerrarModales();

            await CargarCategorias();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private async Task GuardarSubcategoria()
    {
        var resp = await http.Post<SubcategoriaCrearDTO, int>("api/Subcategoria", subcategoria);

        if (!resp.Error)
        {
            Mensaje = "Subcategoría cargada correctamente.";
            CerrarModales();

            await CargarSubcategorias();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private async Task GuardarProducto()
    {
        var resp = await http.Post<ProductoCrearDTO, int>("api/Producto", producto);

        if (!resp.Error)
        {
            Mensaje = "Producto cargado correctamente.";
            CerrarModales();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }
}
}