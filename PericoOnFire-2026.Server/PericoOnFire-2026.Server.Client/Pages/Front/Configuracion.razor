    //Esto es lo que yo agrego para que ande roles con lo que yo hice de mi page
    private List<UsuarioRolDTO>? usuariosRol;
    private List<string> rolesDisponibles2 = Enum.GetNames(typeof(EnumRolSistema)).ToList();
    private Dictionary<string, string> rolSeleccionado = new();
    private string filtroRol = "";
    private string filtroEstadoRol = "todos";
    private IEnumerable<UsuarioRolDTO> UsuariosRolFiltrados => (usuariosRol ?? new())
        .Where(u => string.IsNullOrEmpty(filtroRol) || u.Email.Contains(filtroRol, StringComparison.OrdinalIgnoreCase))
        .Where(u => filtroEstadoRol == "todos" ||
                    (filtroEstadoRol == "activos" && u.Activo) ||
                    (filtroEstadoRol == "inactivos" && !u.Activo));



    private async Task CargarUsuariosRol()
    {
        var resp = await http.Get<List<UsuarioRolDTO>>("api/seguridad/usuarios");
        if (!resp.Error && resp.Respuesta != null)
        {
            usuariosRol = resp.Respuesta;
            foreach (var u in usuariosRol)
                if (!rolSeleccionado.ContainsKey(u.Email))
                    rolSeleccionado[u.Email] = rolesDisponibles2.First();
        }
        else Mensaje = resp.ObtenerError();
    }

    private async Task AsignarRol(UsuarioRolDTO usuario)
    {
        Mensaje = "";
        var dto = new AsignarRolDTO { Email = usuario.Email, Rol = rolSeleccionado[usuario.Email] };
        var resp = await http.Post<AsignarRolDTO>("api/seguridad/asignar-rol", dto);
        if (!resp.Error) { Mensaje = $"Rol {dto.Rol} asignado a {dto.Email}."; await CargarUsuariosRol(); }
        else Mensaje = resp.ObtenerError();
    }

    private async Task RemoverRol(UsuarioRolDTO usuario, string rol)
    {
        Mensaje = "";
        var dto = new AsignarRolDTO { Email = usuario.Email, Rol = rol };
        var resp = await http.Post<AsignarRolDTO>("api/seguridad/remover-rol", dto);
        if (!resp.Error) { Mensaje = $"Rol {rol} removido de {usuario.Email}."; await CargarUsuariosRol(); }
        else Mensaje = resp.ObtenerError();
    }

    private async Task CambiarEstadoUsuario(UsuarioRolDTO usuario, bool activar)
    {
        Mensaje = "";
        var dto = new AsignarRolDTO { Email = usuario.Email, Rol = "" };
        var endpoint = activar ? "api/seguridad/activar-usuario" : "api/seguridad/desactivar-usuario";
        var resp = await http.Post<AsignarRolDTO>(endpoint, dto);
        if (!resp.Error) { Mensaje = $"Usuario {usuario.Email} {(activar ? "activado" : "desactivado")}."; await CargarUsuariosRol(); }
        else Mensaje = resp.ObtenerError();
    }

    private async Task MostrarRoles()
