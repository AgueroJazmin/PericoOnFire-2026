@page "/configuracion"
@using Microsoft.AspNetCore.Authorization
@using PericoOnFire_2026.Shared.DTOs
@using PericoOnFire_2026.Shared.ENUM
@using PericoOnFire_2026.Servicio.ServicioHttp
@implements IAsyncDisposable
@inject PericoOnFire_2026.Shared.SerPolling.PollingService Polling
@inject NavigationManager NavManager
@inject IHttpServicio http
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = "Administracion")]

<div class="config-layout">

    <div class="config-tabs">
        <button class="tab-btn @(tabActiva == "general" ? "tab-activa" : "")"
                @onclick='() => CambiarTab("general")'>
            Configuración general
        </button>

        <button class="tab-btn @(tabActiva == "mesas" ? "tab-activa" : "")"
                @onclick='() => CambiarTab("mesas")'>
            Mesas
        </button>
    </div>

    @if (tabActiva == "general")
    {
        <div class="config-body">

            <aside class="config-sidebar">
                <h4>CONFIGURACIÓN</h4>

                <button class="side-item @(seccionActiva == "categorias" ? "side-activo" : "")"
                        @onclick="MostrarCategorias">
                    <i class="bi bi-tags-fill"></i>
                    Categorías
                </button>

                <button class="side-item @(seccionActiva == "subcategorias" ? "side-activo" : "")"
                        @onclick="MostrarSubcategorias">
                    <i class="bi bi-diagram-3-fill"></i>
                    Subcategorías
                </button>

                <button class="side-item @(seccionActiva == "productos" ? "side-activo" : "")"
                        @onclick="MostrarProductos">
                    <i class="bi bi-box-seam-fill"></i>
                    Productos
                </button>

                <button class="side-item @(seccionActiva == "usuarios" ? "side-activo" : "")"
                        @onclick="@(() => CambiarSeccion("usuarios"))">
                    <i class="bi bi-people-fill"></i>
                    Usuarios
                </button>
                <!-- Cambie el boton de roles para que me dirija a mi page que cree, asi que la page de roles se puede eliminar-->
                <button class="side-item @(seccionActiva == "roles" ? "side-activo" : "")"
                        @onclick="MostrarRoles">
                    <i class="bi bi-shield-lock-fill"></i>
                    Roles
                </button>
            </aside>

            <main class="config-content">



                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="alert alert-info">@Mensaje</div>
                }

                @if (seccionActiva == "")
                {
                    <div class="empty-state">
                        <i class="bi bi-chevron-left"></i>
                        Seleccioná un ítem del listado
                    </div>
                }

                @if (seccionActiva == "categorias")
                {
                    <div class="section-header">
                        <h3>Categorías</h3>
                    </div>

                    <EditForm Model="categoria" OnValidSubmit="GuardarCategoria">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-line categorias-form">
                            <InputText class="form-control"
                                       placeholder="Nombre categoría"
                                       @bind-Value="categoria.NombreCategoria" />

                            <button class="btn btn-dark" type="submit">
                                + Nueva Categoría
                            </button>
                        </div>
                    </EditForm>
                    <input class="form-control mt-3 mb-3"
                           placeholder="Buscar categoría..."
                           @bind="filtroCategoria"
                           @bind:event="oninput" />

                    <table class="table tabla-config mt-3">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th style="width: 130px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (categorias.Count == 0)
                            {
                                <tr>
                                    <td colspan="2" class="text-muted">
                                        No hay categorías cargadas.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var c in CategoriasFiltradas)
                                {
                                    <tr>
                                        <td>
                                            @if (editandoCategoriaId == c.Id)
                                            {
                                                <input class="form-control form-control-sm"
                                                       @bind="editandoCategoriaNombre" />
                                            }
                                            else
                                            {
                                                @c.NombreCategoria
                                            }
                                        </td>

                                        <td class="acciones">
                                            @if (editandoCategoriaId == c.Id)
                                            {
                                                <button class="btn btn-sm btn-success"
                                                        @onclick="() => GuardarEdicionCategoria(c)">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>

                                                <button class="btn btn-sm btn-secondary"
                                                        @onclick="CancelarEdicion">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-primary"
                                                        title="Editar"
                                                        @onclick="() => EditarCategoria(c)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>

                                                <button class="btn btn-sm btn-outline-danger"
                                                        title="Borrar"
                                                        @onclick="() => EliminarCategoria(c.Id)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }

                @if (seccionActiva == "subcategorias")
                {
                    <div class="section-header">
                        <h3>Subcategorías</h3>
                    </div>

                    <EditForm Model="subcategoria" OnValidSubmit="GuardarSubcategoria">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-line subcategorias-form">
                            <InputSelect class="form-select"
                                         @bind-Value="subcategoria.IdCategoria">
                                <option value="0">Seleccione categoría</option>
                                @foreach (var cat in categorias)
                                {
                                    <option value="@cat.Id">@cat.NombreCategoria</option>
                                }
                            </InputSelect>

                            <InputText class="form-control"
                                       placeholder="Nombre subcategoría"
                                       @bind-Value="subcategoria.NombreSubcategoria" />

                            <button class="btn btn-dark" type="submit">
                                + Nueva Subcategoría
                            </button>
                        </div>
                    </EditForm>

                    <input class="form-control mt-3"
                           placeholder="Buscar subcategoría o categoría..."
                           @bind="filtroSubcategoria"
                           @bind:event="oninput" />

                    <table class="table tabla-config mt-3">
                        <thead>
                            <tr>
                                <th>Categoría</th>
                                <th>Subcategoría</th>
                                <th style="width: 130px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in SubcategoriasFiltradas)
                            {
                                <tr>
                                    <td>@s.NombreCategoria</td>
                                    <td>
                                        @if (editandoSubcategoriaId == s.Id)
                                        {
                                            <input class="form-control form-control-sm"
                                                   @bind="editandoSubcategoriaNombre" />
                                        }
                                        else
                                        {
                                            @s.NombreSubcategoria
                                        }
                                    </td>

                                    <td class="acciones">
                                        @if (editandoSubcategoriaId == s.Id)
                                        {
                                            <button class="btn btn-sm btn-success"
                                                    @onclick="() => GuardarEdicionSubcategoria(s)">
                                                <i class="bi bi-check-lg"></i>
                                            </button>

                                            <button class="btn btn-sm btn-secondary"
                                                    @onclick="CancelarEdicion">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => EditarSubcategoria(s)">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => EliminarSubcategoria(s.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (seccionActiva == "productos")
                {
                    <div class="section-header">
                        <h3>Productos</h3>
                    </div>

                    <EditForm Model="producto" OnValidSubmit="GuardarProducto">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-line productos-form">

                            <div>
                                <label class="form-label">Nombre</label>
                                <InputText class="form-control"
                                           placeholder="Ej: Hamburguesa doble cheddar"
                                           @bind-Value="producto.Nombre" />
                            </div>

                            <div>
                                <label class="form-label">Precio</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber class="form-control"
                                                 @bind-Value="producto.Precio" />
                                </div>
                            </div>

                            <div>
                                <label class="form-label">Subcategoría</label>
                                <InputSelect class="form-select"
                                             @bind-Value="producto.IdSubcategoria">
                                    <option value="0">Seleccione subcategoría</option>
                                    @foreach (var sub in subcategorias)
                                    {
                                        <option value="@sub.Id">@sub.NombreSubcategoria</option>
                                    }
                                </InputSelect>
                            </div>

                            <div>
                                <label class="form-label">Sector</label>
                                <InputSelect class="form-select"
                                             @bind-Value="producto.SectorDestino">
                                    @foreach (var sector in Enum.GetValues<EnumSectorDestino>())
                                    {
                                        <option value="@sector">@sector</option>
                                    }
                                </InputSelect>
                            </div>

                            <button class="btn btn-dark btn-producto" type="submit">
                                + Nuevo
                            </button>

                        </div>
                    </EditForm>

                    <input class="form-control mt-3"
                           placeholder="Buscar producto, categoría o subcategoría..."
                           @bind="filtroProducto"
                           @bind:event="oninput" />

                    <div class="tabla-scroll tabla-productos-scroll">
                        <table class="table tabla-config tabla-productos mt-3">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Categoría</th>
                                    <th>Subcategoría</th>
                                    <th>Precio</th>
                                    <th>Sector</th>
                                    <th>Activo</th>
                                    <th style="width: 130px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in ProductosFiltrados)
                                {
                                    <tr>
                                        <td>
                                            @if (editandoProductoId == p.Id)
                                            {
                                                <input class="form-control form-control-sm"
                                                       @bind="editandoProducto.Nombre" />
                                            }
                                            else
                                            {
                                                @p.Nombre
                                            }
                                        </td>

                                        <td>@p.NombreCategoria</td>
                                        <td>@p.NombreSubcategoria</td>

                                        <td>
                                            @if (editandoProductoId == p.Id)
                                            {
                                                <input type="number"
                                                       class="form-control form-control-sm"
                                                       @bind="editandoProducto.Precio" />
                                            }
                                            else
                                            {
                                                @($"$ {p.Precio:N0}")
                                            }
                                        </td>

                                        <td>@p.SectorDestino</td>

                                        <td>
                                            @if (p.Activo)
                                            {
                                                <span class="badge bg-success">Sí</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </td>

                                        <td class="acciones">
                                            @if (editandoProductoId == p.Id)
                                            {
                                                <button class="btn btn-sm btn-success"
                                                        @onclick="() => GuardarEdicionProducto(p)">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>

                                                <button class="btn btn-sm btn-secondary"
                                                        @onclick="CancelarEdicion">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => EditarProducto(p)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>

                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => EliminarProducto(p.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (seccionActiva == "usuarios")
                {
                    <h3>Usuarios</h3>

                    <div class="top-action">
                        <button class="btn btn-dark" @onclick="NuevoUsuario">
                            + Nuevo Usuario
                        </button>
                    </div>

                    @if (creandoUsuario)
                    {
                        <div class="card p-3 mb-3">
                            <h5>Nuevo usuario</h5>

                            <EditForm Model="usuarioNuevo" OnValidSubmit="GuardarUsuarioNuevo">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <InputText class="form-control mb-2" placeholder="Nombre completo"
                                           @bind-Value="usuarioNuevo.Nombre" />

                                <InputText class="form-control mb-2" placeholder="Email"
                                           @bind-Value="usuarioNuevo.Email" />

                                <InputText class="form-control mb-2" placeholder="Contraseña"
                                           @bind-Value="usuarioNuevo.Password" />

                                <InputSelect class="form-select mb-2" @bind-Value="usuarioNuevo.Rol">
                                    <option value="">Seleccione rol</option>
                                    <option value="Administracion">Administracion</option>
                                    <option value="Cocina">Cocina</option>
                                    <option value="Delivery">Delivery</option>
                                    <option value="Mozo">Mozo</option>
                                </InputSelect>

                                <button class="btn btn-success" type="submit">Guardar</button>
                            </EditForm>
                        </div>
                    }

                    <table class="table tabla-config">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th>Email confirmado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in usuarios)
                            {
                                <tr>
                                    <td>@u.Email</td>
                                    <td>@u.Rol</td>
                                    <td>@(u.EmailConfirmed ? "Sí" : "No")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => EditarUsuario(u)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (usuarioEditandoId != null)
                    {
                        <div class="card p-3 mt-3">
                            <h5>Editar usuario</h5>

                            <EditForm Model="usuarioEditar" OnValidSubmit="GuardarUsuarioEditado">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <InputText class="form-control mb-2"
                                           @bind-Value="usuarioEditar.Email" />

                                <InputSelect class="form-select mb-2" @bind-Value="usuarioEditar.Rol">
                                    <option value="Administracion">Administracion</option>
                                    <option value="Cocina">Cocina</option>
                                    <option value="Delivery">Delivery</option>
                                    <option value="Mozo">Mozo</option>
                                </InputSelect>

                                <label>
                                    <InputCheckbox @bind-Value="usuarioEditar.EmailConfirmed" />
                                    Email confirmado
                                </label>

                                <br />

                                <button class="btn btn-success mt-2" type="submit">
                                    Guardar cambios
                                </button>
                            </EditForm>
                        </div>
                    }
                }
                <!-- No se que quisite hacer con eso, pero ya esta la pagina de roles -->
                @if (seccionActiva == "roles")
                {
                    <div class="section-header">
                        <h3>Roles de usuario</h3>
                    </div>

                    <div class="filtros-row mb-3">
                        <input class="form-control buscador-rol" placeholder="Buscar por email..."
                               @bind="filtroRol" @bind:event="oninput" />
                        <select class="form-select filtro-estado-rol" @bind="filtroEstadoRol">
                            <option value="todos">Todos</option>
                            <option value="activos">Activos</option>
                            <option value="inactivos">Inactivos</option>
                        </select>
                    </div>

                    @if (usuariosRol == null)
                    {
                        <p class="text-muted">Cargando usuarios...</p>
                    }
                    else
                    {
                        <table class="table tabla-config">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Estado</th>
                                    <th>Roles actuales</th>
                                    <th>Asignar rol</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in UsuariosRolFiltrados)
                                {
                                    <tr>
                                        <td>@usuario.Email</td>
                                        <td>
                                            @if (usuario.Activo)
                                            {
                                                <span class="badge bg-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactivo</span>
                                            }
                                        </td>
                                        <td>
                                            @if (usuario.Roles.Count == 0)
                                            {
                                                <span class="text-muted">Sin rol</span>
                                            }
                                            else
                                            {
                                                @foreach (var rol in usuario.Roles)
                                                {
                                                    <span class="badge bg-dark me-1">
                                                        @rol
                                                        <button class="btn btn-sm btn-link text-white p-0 ms-1"
                                                                @onclick="() => RemoverRol(usuario, rol)">
                                                            x
                                                        </button>
                                                    </span>
                                                }
                                            }
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm"
                                                    value="@rolSeleccionado[usuario.Email]"
                                                    @onchange="e => rolSeleccionado[usuario.Email] = e.Value!.ToString()!">
                                                @foreach (var rol in rolesDisponibles2)
                                                {
                                                    <option value="@rol">@rol</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="acciones">
                                            <button class="btn btn-sm btn-primary"
                                                    @onclick="() => AsignarRol(usuario)">
                                                Asignar
                                            </button>
                                            @if (usuario.Activo)
                                            {
                                                <button class="btn btn-sm btn-warning"
                                                        @onclick="() => CambiarEstadoUsuario(usuario, false)">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-success"
                                                        @onclick="() => CambiarEstadoUsuario(usuario, true)">
                                                    Activar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                <!-- Hasta aca-->
            </main>
        </div>
    }

    <!-- Nuevo de Mesas: salas + grilla, como en el diseño de referencia -->
    @if (tabActiva == "mesas")
    {
        <div class="mesas-config">
            <div class="section-header">
                <h3>Salas y mesas</h3>
                @if (!editandoDistribucion)
                {
                    <button class="btn btn-dark" disabled="@(salaSeleccionadaId == null || !MesasSalaActual.Any() || salaEditandoNombreId != null || guardandoNombreSala)" @onclick="IniciarDistribucion">Editar distribución</button>
                }
                else
                {
                    <div class="distribucion-acciones">
                        <button class="btn btn-success" disabled="@(guardandoDistribucion || !distribucionModificada)" @onclick="GuardarDistribucion">@(guardandoDistribucion ? "Guardando..." : "Guardar distribución")</button>
                        <button class="btn btn-outline-secondary" disabled="@guardandoDistribucion" @onclick="CancelarDistribucion">Cancelar</button>
                    </div>
                }
            </div>

            <fieldset class="salas-tabs" disabled="@(editandoDistribucion || guardandoNombreSala)">
                @foreach (var s in salas.OrderBy(s => s.Orden))
                {
                    <div class="sala-tab-grupo" @key="s.Id">
                        @if (salaEditandoNombreId == s.Id)
                        {
                            <input class="form-control form-control-sm input-nueva-sala"
                                   aria-label="Nombre de la sala" maxlength="60"
                                   @bind="nombreSalaEditado" @bind:event="oninput"
                                   @onkeyup="TeclaNombreSala" />
                            <button type="button" class="btn btn-sm btn-success" @onclick="GuardarNombreSala">Guardar</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelarNombreSala">Cancelar</button>
                        }
                        else
                        {
                            <button class="sala-tab @(salaSeleccionadaId == s.Id ? "sala-tab-activa" : "")"
                                    @onclick="() => SeleccionarSala(s.Id)">
                                @s.Nombre
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    title="Editar nombre" aria-label="@($"Editar nombre de {s.Nombre}")"
                                    @onclick="() => EditarNombreSala(s)">
                                <i class="bi bi-pencil"></i>
                            </button>
                        }
                    </div>
                }

                @if (mostrarFormNuevaSala)
                {
                    <input class="form-control form-control-sm input-nueva-sala"
                           placeholder="Nombre de la sala"
                           @bind="nombreNuevaSala" @bind:event="oninput"
                           @onkeyup='async (e) => { if (e.Key == "Enter") { await CrearSala(); } }' />
                    <button class="btn btn-sm btn-success" @onclick="CrearSala">✓</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => mostrarFormNuevaSala = false">✕</button>
                }
                else
                {
                    <button class="btn btn-sm btn-dark" @onclick="() => mostrarFormNuevaSala = true">+ Nueva sala</button>
                }
            </fieldset>

            @if (editandoDistribucion)
            {
                <p class="distribucion-ayuda" role="status">Arrastrá una mesa o tocala y después tocá su destino. Si está ocupado, intercambian lugares. @(mesaParaMover == null ? "" : $"Mesa {mesaParaMover.NumeroMesa} seleccionada.")</p>
            }

            @if (!string.IsNullOrWhiteSpace(MensajeMesas))
            {
                <div class="alert alert-info mt-2">@MensajeMesas</div>
            }

            @if (salas.Count == 0)
            {
                <p class="text-muted mt-3">Todavía no creaste ninguna sala. Empezá por "+ Nueva sala".</p>
            }
            else if (salaSeleccionadaId == null)
            {
                <p class="text-muted mt-3">Elegí una sala arriba para ver y armar sus mesas.</p>
            }
            else
            {
                <div class="editor-salon">
                    <div class="grilla-salon">
                        @for (var fila = 0; fila < FilasGrilla; fila++)
                        {
                            var filaActual = fila;
                            <div class="fila-grilla">
                                @for (var columna = 0; columna < ColumnasGrilla; columna++)
                                {
                                    var columnaActual = columna;
                                    var mesaEnCelda = MesasSalaActual.FirstOrDefault(m => m.Fila == filaActual && m.Columna == columnaActual);

                                    <div class="posicion-mesa"
                                         @ondragover:preventDefault="true"
                                         @ondrop="() => MoverMesa(filaActual, columnaActual)">
                                        @if (mesaEnCelda != null)
                                        {
                                            <button type="button" disabled="@guardandoDistribucion"
                                                    draggable="@(editandoDistribucion ? "true" : "false")"
                                                    @ondragstart="() => ElegirMesaParaMover(mesaEnCelda)"
                                                    @ondragend="() => mesaParaMover = null"
                                                    class="celda-mesa tamanio-@mesaEnCelda.Tamanio.ToString().ToLower() forma-@mesaEnCelda.Forma.ToString().ToLower()
                                                        @(mesaSeleccionadaConfig?.Id == mesaEnCelda.Id || mesaParaMover?.Id == mesaEnCelda.Id ? "celda-mesa-activa" : "")"
                                                    aria-label="@($"Mesa {mesaEnCelda.NumeroMesa}, fila {filaActual + 1}, columna {columnaActual + 1}")"
                                                    @onclick="() => PulsarMesa(mesaEnCelda)">
                                                @mesaEnCelda.NumeroMesa
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" disabled="@guardandoDistribucion" class="celda-vacia"
                                                    title="@(editandoDistribucion ? "Mover mesa acá" : "Agregar mesa acá")"
                                                    aria-label="@($"Celda vacía, fila {filaActual + 1}, columna {columnaActual + 1}")"
                                                    @onclick="() => PulsarCelda(filaActual, columnaActual)">
                                                @(editandoDistribucion ? "·" : "+")
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <fieldset class="panel-mesa-config" disabled="@editandoDistribucion">
                        <div class="panel-mesa-header">
                            @(salas.First(s => s.Id == salaSeleccionadaId).Nombre)
                            <button class="btn-cerrar" title="Eliminar sala" @onclick="() => EliminarSala(salaSeleccionadaId!.Value)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>

                        @if (mesaSeleccionadaConfig == null)
                        {
                            <p class="text-muted">Hacé click en una celda vacía para agregar una mesa, o en una mesa ya creada para editarla.</p>
                        }
                        else
                        {
                            <div class="panel-mesa-body">
                                <div class="panel-mesa-titulo">
                                    Mesa @mesaSeleccionadaConfig.NumeroMesa
                                    <button class="btn-cerrar" title="Eliminar mesa" @onclick="() => EliminarMesaConfig(mesaSeleccionadaConfig.Id)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>

                                <label>Número</label>
                                <input type="number" class="form-control form-control-sm" @bind="numeroEditado" />

                                <label class="mt-2">Sala</label>
                                <select class="form-select form-select-sm" @bind="salaDestinoEditada">
                                    @foreach (var s in salas.OrderBy(s => s.Orden))
                                    {
                                        <option value="@s.Id">@s.Nombre</option>
                                    }
                                </select>

                                <label class="mt-2">Forma</label>
                                <select class="form-select form-select-sm" @bind="formaEditada">
                                    <option value="@EnumFormaMesa.Cuadrada">Cuadrada</option>
                                    <option value="@EnumFormaMesa.Redonda">Redonda</option>
                                </select>

                                <label class="mt-2">Tamaño</label>
                                <select class="form-select form-select-sm" @bind="tamanioEditada">
                                    <option value="@EnumTamanioMesa.Chica">Chica</option>
                                    <option value="@EnumTamanioMesa.Mediana">Mediana</option>
                                    <option value="@EnumTamanioMesa.Grande">Grande</option>
                                </select>

                                <button class="btn btn-dark w-100 mt-3" @onclick="GuardarMesaConfig">
                                    Guardar cambios
                                </button>
                            </div>
                        }
                    </fieldset>
                </div>
            }
        </div>
    }

</div>

