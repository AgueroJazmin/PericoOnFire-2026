    private IEnumerable<CategoriaListadoDTO> CategoriasFiltradas =>
    string.IsNullOrWhiteSpace(filtroCategoria)
        ? categorias
        : categorias.Where(c =>
            c.NombreCategoria.Contains(filtroCategoria, StringComparison.OrdinalIgnoreCase));

private IEnumerable<SubcategoriaListadoDTO> SubcategoriasFiltradas =>
    string.IsNullOrWhiteSpace(filtroSubcategoria)
        ? subcategorias
        : subcategorias.Where(s =>
            s.NombreSubcategoria.Contains(filtroSubcategoria, StringComparison.OrdinalIgnoreCase)
            || s.NombreCategoria.Contains(filtroSubcategoria, StringComparison.OrdinalIgnoreCase));

private IEnumerable<ProductoListadoDTO> ProductosFiltrados =>
    string.IsNullOrWhiteSpace(filtroProducto)
        ? productos
        : productos.Where(p =>
            p.Nombre.Contains(filtroProducto, StringComparison.OrdinalIgnoreCase)
            || p.NombreCategoria.Contains(filtroProducto, StringComparison.OrdinalIgnoreCase)
            || p.NombreSubcategoria.Contains(filtroProducto, StringComparison.OrdinalIgnoreCase));

    private async Task CargarUsuarios()
    {
        var resp = await http.Get<List<UsuarioListadoDTO>>("api/Usuario");

        if (!resp.Error && resp.Respuesta != null)
            usuarios = resp.Respuesta;
        else
            Mensaje = resp.ObtenerError();
    }

    private void NuevoUsuario()
    {
        usuarioNuevo = new();
        creandoUsuario = true;
        usuarioEditandoId = null;
        Mensaje = "";
    }

    private async Task GuardarUsuarioNuevo()
    {
        var resp = await http.Post<UsuarioCrearDTO>("api/Usuario", usuarioNuevo);

        if (!resp.Error)
        {
            Mensaje = "Usuario creado correctamente.";
            creandoUsuario = false;
            usuarioNuevo = new();
            await CargarUsuarios();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }

    private void EditarUsuario(UsuarioListadoDTO u)
    {
        usuarioEditandoId = u.Id;
        creandoUsuario = false;

        usuarioEditar = new UsuarioEditarDTO
        {
            Email = u.Email,
            Rol = u.Rol,
            EmailConfirmed = u.EmailConfirmed
        };
    }

    private async Task GuardarUsuarioEditado()
    {
        if (usuarioEditandoId == null)
            return;

        var resp = await http.Put<UsuarioEditarDTO>($"api/Usuario/{usuarioEditandoId}", usuarioEditar);

        if (!resp.Error)
        {
            Mensaje = "Usuario actualizado correctamente.";
            usuarioEditandoId = null;
            usuarioEditar = new();
            await CargarUsuarios();
        }
        else
        {
            Mensaje = resp.ObtenerError();
        }
    }
