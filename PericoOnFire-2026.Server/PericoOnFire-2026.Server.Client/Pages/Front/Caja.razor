    .linea-pago-quitar {
        padding: 0 .75rem;
        line-height: 1;
        font-size: 1.3rem;
    }

    .dividir-pago {
        display: inline-block;
        margin: .2rem 0 .6rem;
    }

    .resumen-cobro {
        margin-top: .4rem;
        padding: .5rem .75rem;
        border-radius: 6px;
        background: #f4f4f4;
    }

    .resumen-cobro-fila {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
    }

    .vuelto-preview {
        margin-top: 0.25rem;
        font-weight: 600;
        color: #2e7d32;
    }

    .vuelto-faltante {
        color: #d32f2f;
    }

    .detalle-cobro {
        padding-left: 1.2rem;
    }

    @@media (max-width: 760px) {
        .caja-pagina {
            padding: .75rem;
            gap: .75rem;
        }

        .caja-layout {
            grid-template-columns: 1fr;
            gap: .75rem;
        }

        .lista-cuentas {
            max-height: 38vh;
        }

        .panel-cobro {
            padding: .75rem;
            overflow: hidden;
        }

        .tabla-detalle {
            display: block;
            overflow-x: auto;
            white-space: nowrap;
        }

        .total-cuenta {
            text-align: left;
        }

        .form-cobro {
            max-width: none;
            margin-left: 0;
        }
    }

    @@media (max-width: 560px) {
        .estado-caja {
            padding: .6rem .75rem;
        }

        .estado-caja-cifras {
            grid-template-columns: 1fr 1fr;
        }

        .cifra-principal {
            grid-column: 1 / -1;
        }

        .apertura-campo {
            max-width: none;
        }

        .apertura-caja .btn {
            width: 100%;
        }

        .caja-tab {
            flex: 1 1 0;
            justify-content: center;
            padding: .5rem .35rem;
            font-size: .9rem;
        }
    }

    @@media (max-width: 400px) {
        .linea-pago {
            grid-template-columns: minmax(0, 1fr) auto;
        }

        .linea-pago-tipo {
            grid-column: 1 / -1;
        }
    }
</style>

@code {
    private List<ComandaPendienteCobroDTO> cuentas = new();
    private ComandaPendienteCobroDTO? cuentaSeleccionada;
    private EstadoCajaDTO? estado;
    private string pestania = "cobrar";
    private bool procesando;
    private string? Mensaje;
    private int? idUsuarioActual;

    // Apertura: el monto inicial viene cargado con lo que quedó contado en el último cierre,
    // pero si la persona lo cambia, el refresco automático ya no lo pisa.
    private decimal montoInicialApertura;
    private bool aperturaEditada;

    // Pago combinado: una línea por forma de pago. Los montos se cargan solos (la primera línea
    // arranca con el total de la cuenta y, al dividir, la otra se completa con lo que falta), pero
    // cualquiera se puede modificar. Una línea que la persona tocó ya no se recalcula sola.
    private List<LineaPagoDTO> lineasPago = new();
    private readonly HashSet<LineaPagoDTO> lineasEditadas = new();

    private Confirmacion? confirmacionCobro;
    private Confirmacion? confirmacionCerrarSinCobro;

    private bool CajaAbierta => estado?.Abierta == true;

    private ResultadoCobro CobroActual =>
        cuentaSeleccionada == null
            ? CobroCombinado.Evaluar(0, lineasPago)
            : CobroCombinado.Evaluar(cuentaSeleccionada.Total, lineasPago);

    private decimal TotalCobrado => lineasPago.Sum(l => l.Monto);

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarioActual();
        await Refrescar();
        Polling.Iniciar(Refrescar, TimeSpan.FromSeconds(4));
    }

    private async Task Refrescar()
    {
        await CargarEstado();
        await CargarCuentas();
    }

    private async Task CargarUsuarioActual()
    {
        var respuesta = await http.Get<int>("api/Usuario/Actual");
        if (!respuesta.Error)
        {
            idUsuarioActual = respuesta.Respuesta;
        }
    }

    private async Task CargarEstado()
    {
        var respuesta = await http.Get<EstadoCajaDTO>("api/Caja/Estado");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            estado = respuesta.Respuesta;

            if (!estado.Abierta && !aperturaEditada)
            {
                montoInicialApertura = estado.MontoInicialSugerido ?? 0;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CargarCuentas()
    {
        var respuesta = await http.Get<List<ComandaPendienteCobroDTO>>("api/Pago/PendientesCobro");
        if (!respuesta.Error && respuesta.Respuesta != null)
        {
            cuentas = respuesta.Respuesta;

            // Si la cuenta que tenía abierta ya no está pendiente (por ej. se cobró
            // desde otra caja), la saco del panel para no dejar un formulario colgado.
            if (cuentaSeleccionada != null && !cuentas.Any(c => c.Id == cuentaSeleccionada.Id))
            {
                cuentaSeleccionada = null;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private string ClasePestania(string nombre) => pestania == nombre ? "caja-tab-activa" : "";

    private void CambiarPestania(string nombre)
    {
        pestania = nombre;
        Mensaje = null;
    }

    private static string Dinero(decimal monto) => $"${monto:0.00}";

    // ---- Apertura de caja ----

    private async Task AbrirCaja()
    {
        procesando = true;
        Mensaje = null;

        var dto = new AbrirCajaDTO { MontoInicial = montoInicialApertura };
        var respuesta = await http.Post<AbrirCajaDTO, TurnoCajaDTO>("api/Caja/Abrir", dto);

        procesando = false;

        if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
            return;
        }

        aperturaEditada = false;
        Mensaje = "Caja abierta. Ya se puede cobrar.";
        await Refrescar();
    }

    // ---- Cobro ----

    private void SeleccionarCuenta(ComandaPendienteCobroDTO cuenta)
    {
        cuentaSeleccionada = cuenta;
        Mensaje = null;

        // El monto ya viene cargado con el total de la cuenta, en efectivo por defecto.
        lineasEditadas.Clear();
        lineasPago = new List<LineaPagoDTO>
        {
            new LineaPagoDTO { TipoPago = EnumTipoPago.Efectivo, Monto = cuenta.Total }
        };
    }

    private void AlEditarMonto(LineaPagoDTO linea)
    {
        lineasEditadas.Add(linea);
        Rebalancear(linea);
    }

    private void AgregarLinea()
    {
        var libres = TiposPagoCaja.Habilitados
            .Where(t => lineasPago.All(l => l.TipoPago != t))
            .ToList();

        if (!libres.Any()) return;

        lineasPago.Add(new LineaPagoDTO { TipoPago = libres[0], Monto = 0 });
        Rebalancear(null);
    }

    private void QuitarLinea(LineaPagoDTO linea)
    {
        lineasPago.Remove(linea);
        lineasEditadas.Remove(linea);

        if (cuentaSeleccionada != null && lineasPago.Count == 1 && !lineasEditadas.Contains(lineasPago[0]))
        {
            lineasPago[0].Monto = cuentaSeleccionada.Total;
        }
        else
        {
            Rebalancear(null);
        }
    }

    // Cuando hay más de una forma de pago, la última línea que la persona no tocó se completa
    // sola con lo que falta para llegar al total de la cuenta (nunca menos de cero).
    private void Rebalancear(LineaPagoDTO? editada)
    {
        if (cuentaSeleccionada == null || lineasPago.Count < 2) return;

        var candidata = lineasPago.LastOrDefault(l => !ReferenceEquals(l, editada) && !lineasEditadas.Contains(l));
        if (candidata == null) return;

        var resto = cuentaSeleccionada.Total - lineasPago.Where(l => !ReferenceEquals(l, candidata)).Sum(l => l.Monto);
        candidata.Monto = Math.Max(resto, 0);
    }

    private void PedirConfirmarCobro()
    {
        if (cuentaSeleccionada == null) return;

        if (!CajaAbierta)
        {
            Mensaje = "La caja está cerrada. Abrí un turno antes de cobrar.";
            return;
        }

        var cobro = CobroActual;
        if (!cobro.EsValido)
        {
            Mensaje = cobro.Error;
            return;
        }

        Mensaje = null;
        confirmacionCobro?.Ver();
    }

    private async Task ConfirmarCobro()
    {
        if (cuentaSeleccionada == null || idUsuarioActual == null) return;

        procesando = true;

        var dto = new RegistrarPagoDTO
        {
            IdComanda = cuentaSeleccionada.Id,
            IdUsuarioCaja = idUsuarioActual.Value,
            Lineas = lineasPago
                .Where(l => l.Monto > 0)
                .Select(l => new LineaPagoDTO { TipoPago = l.TipoPago, Monto = l.Monto })
                .ToList()
        };

        var respuesta = await http.Post<RegistrarPagoDTO, PagoRegistradoDTO>("api/Pago/Registrar", dto);
        confirmacionCobro?.Ocultar();
        procesando = false;

        if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
            return;
        }

        Mensaje = $"Cobro registrado. Vuelto: ${respuesta.Respuesta!.Vuelto:0.00}";
        cuentaSeleccionada = null;
        lineasPago = new();
        lineasEditadas.Clear();
        await Refrescar();
    }

    // Para las cuentas que quedaron en PendienteCobro sin ningún ítem cargado
    // (pedidos todos cancelados, o mesas viejas de antes de esta validación).
    // Usa el endpoint CerrarSinCobro del PagoController en vez de Registrar,
    // porque acá no hay ningún monto real que registrar como Pago.
    private void PedirCerrarSinCobro()
    {
        if (cuentaSeleccionada == null) return;
        confirmacionCerrarSinCobro?.Ver();
    }

    private async Task ConfirmarCerrarSinCobro()
    {
        if (cuentaSeleccionada == null) return;

        procesando = true;

        var respuesta = await http.Put($"api/Pago/CerrarSinCobro/{cuentaSeleccionada.Id}", new { });
        confirmacionCerrarSinCobro?.Ocultar();
        procesando = false;

        if (respuesta.Error)
        {
            Mensaje = respuesta.ObtenerError();
            return;
        }

        Mensaje = "Mesa cerrada sin cobro.";
        cuentaSeleccionada = null;
        await Refrescar();
    }

    public async ValueTask DisposeAsync()
    {
        await Polling.DisposeAsync();
    }
}
