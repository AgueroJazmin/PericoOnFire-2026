@page "/caja"
@using Microsoft.AspNetCore.Authorization
@using PericoOnFire_2026.Shared.DTOs
@using PericoOnFire_2026.Shared.ENUM
@using PericoOnFire_2026.Shared.Utilidades
@using PericoOnFire_2026.Servicio.ServicioHttp
@using PericoOnFire_2026.Server.Client.Shared
@implements IAsyncDisposable
@inject PericoOnFire_2026.Shared.SerPolling.PollingService Polling
@inject IHttpServicio http
@rendermode InteractiveAuto
@attribute [Authorize(Roles = "Caja,Administracion")]

<div class="caja-pagina">

    @* ---- Estado de la caja: abierta/cerrada, lo cobrado en el turno y la apertura ---- *@
    @if (estado == null)
    {
        <section class="estado-caja">
            <span class="texto-vacio">Cargando el estado de la caja…</span>
        </section>
    }
    else if (estado.Abierta)
    {
        <section class="estado-caja estado-caja-abierta">
            <div class="estado-caja-cabecera">
                <span class="estado-caja-punto"></span>
                <strong>Caja abierta</strong>
                <span class="estado-caja-detalle">
                    desde las @HoraArgentina.DesdeUtc(estado.Turno!.FechaApertura).ToString("HH:mm")
                    · @(estado.Turno.NombreUsuarioApertura ?? "—")
                </span>
            </div>
            <div class="estado-caja-cifras">
                <div class="cifra cifra-principal">
                    <span>Efectivo en caja</span>
                    <strong>@Dinero(estado.EfectivoEsperado)</strong>
                </div>
                <div class="cifra">
                    <span>Débito</span>
                    <strong>@Dinero(estado.CobrosDebito)</strong>
                </div>
                <div class="cifra">
                    <span>Crédito</span>
                    <strong>@Dinero(estado.CobrosCredito)</strong>
                </div>
                <div class="cifra">
                    <span>Transferencia</span>
                    <strong>@Dinero(estado.CobrosTransferencia)</strong>
                </div>
                <div class="cifra">
                    <span>QR</span>
                    <strong>@Dinero(estado.CobrosQR)</strong>
                </div>
                <div class="cifra">
                    <span>Ventas del turno</span>
                    <strong>@estado.CantidadVentas</strong>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="estado-caja estado-caja-cerrada">
            <div class="estado-caja-cabecera">
                <span class="estado-caja-punto estado-caja-punto-cerrada"></span>
                <strong>Caja cerrada</strong>
                <span class="estado-caja-detalle">Abrí un turno con el efectivo inicial para poder cobrar.</span>
            </div>
            <div class="apertura-caja">
                <div class="apertura-campo">
                    <label>Monto inicial (efectivo en el cajón)</label>
                    <input type="number" step="0.01" min="0" class="form-control"
                           @bind="montoInicialApertura" @bind:after="() => aperturaEditada = true" />
                    @if (estado.MontoInicialSugerido != null)
                    {
                        <small class="texto-vacio">Se cargó lo que quedó contado en el último cierre; podés cambiarlo.</small>
                    }
                </div>
                <button type="button" class="btn btn-success" disabled="@procesando" @onclick="AbrirCaja">
                    Abrir caja
                </button>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert alert-info mb-0">@Mensaje</div>
    }

    @* ---- Pestañas ---- *@
    <nav class="caja-tabs" role="tablist">
        <button type="button" role="tab" class="caja-tab @ClasePestania("cobrar")" @onclick='() => CambiarPestania("cobrar")'>
            Cobrar
            @if (cuentas.Any())
            {
                <span class="caja-tab-contador">@cuentas.Count</span>
            }
        </button>
        <button type="button" role="tab" class="caja-tab @ClasePestania("ventas")" @onclick='() => CambiarPestania("ventas")'>Ventas</button>
        <button type="button" role="tab" class="caja-tab @ClasePestania("movimientos")" @onclick='() => CambiarPestania("movimientos")'>Movimientos</button>
        <button type="button" role="tab" class="caja-tab @ClasePestania("arqueo")" @onclick='() => CambiarPestania("arqueo")'>Arqueo</button>
    </nav>

    @if (pestania == "ventas")
    {
        <CajaVentas />
    }
    else if (pestania == "movimientos")
    {
        <CajaMovimientos Estado="estado" OnCambio="Refrescar" />
    }
    else if (pestania == "arqueo")
    {
        <CajaArqueo Estado="estado" CuentasPendientes="cuentas.Count" OnCambio="Refrescar" />
    }
    else
    {
        <div class="caja-layout">
            <section class="lista-cuentas">
                <h4>Cuentas pendientes de cobro</h4>

                @if (!cuentas.Any())
                {
                    <p class="texto-vacio">No hay ninguna mesa esperando para cobrar.</p>
                }

                @foreach (var cuenta in cuentas)
                {
                    <button class="cuenta-card @(cuentaSeleccionada?.Id == cuenta.Id ? "cuenta-card-activa" : "")"
                            @onclick="() => SeleccionarCuenta(cuenta)">
                        <div class="cuenta-card-titulo">
                            @(cuenta.NumeroMesa != null ? $"Mesa {cuenta.NumeroMesa}" : cuenta.TipoServicio.ToString())
                            <span class="cuenta-card-numero">· @cuenta.NumeroComanda</span>
                        </div>
                        <div class="cuenta-card-info">
                            @(cuenta.NombreMozo ?? "—") · hace @((int)(DateTime.UtcNow - cuenta.FechaApertura).TotalMinutes) min
                        </div>
                        <div class="cuenta-card-total">$@cuenta.Total.ToString("0.00")</div>
                    </button>
                }
            </section>

            <section class="panel-cobro">
                @if (cuentaSeleccionada == null)
                {
                    <p class="texto-vacio">Elegí una cuenta de la izquierda para cobrarla.</p>
                }
                else
                {
                    <h4>
                        @(cuentaSeleccionada.NumeroMesa != null ? $"Mesa {cuentaSeleccionada.NumeroMesa}" : cuentaSeleccionada.TipoServicio.ToString())
                        <span class="cuenta-card-numero">· @cuentaSeleccionada.NumeroComanda</span>
                    </h4>
                    <p class="texto-vacio">Mozo: @(cuentaSeleccionada.NombreMozo ?? "—") · @cuentaSeleccionada.CantidadComensales comensales</p>

                    @if (!cuentaSeleccionada.Items.Any())
                    {
                        <div class="alert alert-warning">
                            Esta cuenta no tiene ningún producto cargado (seguramente se cancelaron todos los
                            pedidos, o quedó abierta de antes). No hay nada para cobrar, pero la mesa sigue
                            bloqueada hasta que se cierre.
                        </div>
                        <button class="btn btn-outline-dark w-100" disabled="@procesando" @onclick="PedirCerrarSinCobro">
                            Cerrar mesa sin cobro
                        </button>
                    }
                    else
                    {
                        <table class="tabla-detalle">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cant.</th>
                                    <th>Precio</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cuentaSeleccionada.Items)
                                {
                                    <tr>
                                        <td>@item.NombreProducto</td>
                                        <td>@item.Cantidad</td>
                                        <td>$@item.PrecioUnitario.ToString("0.00")</td>
                                        <td>$@item.Subtotal.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="total-cuenta">
                            Total a cobrar: <strong>$@cuentaSeleccionada.Total.ToString("0.00")</strong>
                        </div>

                        @if (!CajaAbierta)
                        {
                            <div class="alert alert-warning">
                                La caja está cerrada: abrí un turno (arriba) para poder cobrar esta cuenta.
                            </div>
                        }

                        <div class="form-cobro">
                            <label>Forma de pago</label>

                            @foreach (var linea in lineasPago)
                            {
                                <div class="linea-pago">
                                    <select class="form-select linea-pago-tipo" @bind="linea.TipoPago">
                                        @foreach (var tipo in TiposPagoCaja.Habilitados)
                                        {
                                            @if (tipo == linea.TipoPago || lineasPago.All(l => l.TipoPago != tipo))
                                            {
                                                <option value="@tipo">@TiposPagoCaja.Nombre(tipo)</option>
                                            }
                                        }
                                    </select>
                                    <input type="number" step="0.01" min="0" class="form-control linea-pago-monto"
                                           aria-label="Monto con @TiposPagoCaja.Nombre(linea.TipoPago)"
                                           @bind="linea.Monto" @bind:after="() => AlEditarMonto(linea)" />
                                    @if (lineasPago.Count > 1)
                                    {
                                        <button type="button" class="btn btn-outline-secondary linea-pago-quitar"
                                                aria-label="Quitar esta forma de pago" @onclick="() => QuitarLinea(linea)">
                                            &times;
                                        </button>
                                    }
                                </div>
                            }

                            @if (lineasPago.Count < TiposPagoCaja.Habilitados.Length)
                            {
                                <button type="button" class="btn btn-link p-0 dividir-pago" @onclick="AgregarLinea">
                                    + Dividir el pago en otra forma
                                </button>
                            }

                            @{
                                var cobro = CobroActual;
                            }
                            <div class="resumen-cobro">
                                <div class="resumen-cobro-fila">
                                    <span>Cobrado</span>
                                    <strong>$@TotalCobrado.ToString("0.00")</strong>
                                </div>

                                @if (!cobro.EsValido)
                                {
                                    <div class="vuelto-preview vuelto-faltante">@cobro.Error</div>
                                }
                                else if (cobro.Vuelto > 0)
                                {
                                    <div class="vuelto-preview">Vuelto: $@cobro.Vuelto.ToString("0.00")</div>
                                }
                                else
                                {
                                    <div class="vuelto-preview">Cobro completo</div>
                                }
                            </div>

                            <button class="btn btn-success w-100 mt-3" disabled="@(procesando || !CajaAbierta)" @onclick="PedirConfirmarCobro">
                                Confirmar cobro
                            </button>
                        </div>
                    }
                }
            </section>
        </div>
    }
</div>

<Confirmacion @ref="confirmacionCobro"
              Titulo="Confirmar cobro"
              textOk="Sí, cobrar"
              textCancelar="Volver"
              onConfirm="ConfirmarCobro"
              onCancel="() => confirmacionCobro!.Ocultar()">
    @if (cuentaSeleccionada != null)
    {
        var cobro = CobroActual;

        <p>
            Vas a cerrar la cuenta de
            @(cuentaSeleccionada.NumeroMesa != null ? $"Mesa {cuentaSeleccionada.NumeroMesa}" : cuentaSeleccionada.TipoServicio.ToString())
            por <strong>$@cuentaSeleccionada.Total.ToString("0.00")</strong>:
        </p>
        <ul class="detalle-cobro">
            @foreach (var linea in cobro.Lineas)
            {
                <li>@TiposPagoCaja.Nombre(linea.TipoPago): $@linea.Monto.ToString("0.00")</li>
            }
        </ul>
        @if (cobro.Vuelto > 0)
        {
            <p>Vuelto a entregar: <strong>$@cobro.Vuelto.ToString("0.00")</strong></p>
        }
        <p>Una vez confirmado, la mesa queda libre para un nuevo grupo.</p>
    }
</Confirmacion>

<Confirmacion @ref="confirmacionCerrarSinCobro"
              Titulo="Cerrar mesa sin cobro"
              textOk="Sí, cerrar"
              textCancelar="Volver"
              onConfirm="ConfirmarCerrarSinCobro"
              onCancel="() => confirmacionCerrarSinCobro!.Ocultar()">
    @if (cuentaSeleccionada != null)
    {
        <p>
            Esta cuenta no tiene productos cargados. Vas a cerrarla sin registrar ningún cobro
            y a liberar
            @(cuentaSeleccionada.NumeroMesa != null ? $"la Mesa {cuentaSeleccionada.NumeroMesa}" : "este pedido")
            para un nuevo grupo.
        </p>
    }
</Confirmacion>

<style>
    .caja-pagina {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
    }

    /* ---- Estado de la caja ---- */
    .estado-caja {
        background: white;
        border-radius: 8px;
        padding: .75rem 1rem;
        border-left: 5px solid #ccc;
        color: #222;
    }

    .estado-caja-abierta {
        border-left-color: #2e7d32;
    }

    .estado-caja-cerrada {
        border-left-color: #d32f2f;
    }

    .estado-caja-cabecera {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .4rem .6rem;
    }

    .estado-caja-punto {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #2e7d32;
        flex: 0 0 auto;
    }

    .estado-caja-punto-cerrada {
        background: #d32f2f;
    }

    .estado-caja-detalle {
        font-size: .85rem;
        color: #666;
    }

    .estado-caja-cifras {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: .5rem .75rem;
        margin-top: .6rem;
    }

    .cifra {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

        .cifra span {
            font-size: .8rem;
            color: #666;
        }

        .cifra strong {
            font-size: 1.1rem;
            overflow-wrap: anywhere;
        }

    .cifra-principal strong {
        color: #2e7d32;
        font-size: 1.3rem;
    }

    .apertura-caja {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: .6rem .75rem;
        margin-top: .6rem;
    }

    .apertura-campo {
        display: flex;
        flex-direction: column;
        gap: .2rem;
        flex: 1 1 220px;
        max-width: 320px;
        min-width: 0;
