        align-items: center;
        gap: .4rem;
        padding: .55rem 1.1rem;
        border: 1px solid #ccc;
        border-bottom: 0;
        border-radius: 8px 8px 0 0;
        background: #f4f4f4;
        color: #333;
        cursor: pointer;
    }

    .caja-tab-activa {
        background: white;
        color: #1f6feb;
        font-weight: 700;
        border-color: #1f6feb;
        margin-bottom: -2px;
        border-bottom: 2px solid white;
    }

    .caja-tab-contador {
        min-width: 1.4rem;
        padding: 0 .4rem;
        border-radius: 999px;
        background: #d32f2f;
        color: white;
        font-size: .75rem;
        font-weight: 700;
        text-align: center;
    }

    /* ---- Cobro ---- */
    .caja-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 1rem;
    }

    .lista-cuentas {
        background: #f4f4f4;
        border-radius: 8px;
        padding: 0.75rem;
        max-height: 85vh;
        overflow-y: auto;
    }

    .cuenta-card {
        display: block;
        width: 100%;
        text-align: left;
        background: white;
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 0.6rem 0.75rem;
        margin-bottom: 0.6rem;
        cursor: pointer;
    }

    .cuenta-card-activa {
        border-color: #1f6feb;
        box-shadow: 0 0 0 2px rgba(31, 111, 235, .2);
