@page "/roles"
@using PericoOnFire_2026.Servicio.ServicioHttp
@using PericoOnFire_2026.Shared.DTOs
@using PericoOnFire_2026.Shared.ENUM
@rendermode InteractiveAuto
@inject IHttpServicio http

<div class="page-wrapper">
    <h3>Administrar Roles</h3>
    <br>
    <AuthorizeView Roles="Administracion" Context="authContext">
        <Authorized>
            @if (usuarios == null)
            {
                <p class="text-white">Buscando usuarios...</p>
            }
            else
            {
                <div class="filtros-row">
                    <input class="form-control buscador" placeholder="Buscar por email..."
                           @bind="filtro" @bind:event="oninput" />
                    <select class="form-select filtro-estado" @bind="filtroEstado">
                        <option value="todos">Todos</option>
                        <option value="activos">Activos</option>
                        <option value="inactivos">Inactivos</option>
                    </select>
                </div>

                <div class="tabla-card">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Estado</th>
                                <th>Roles actuales</th>
                                <th>Asignar rol</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in UsuariosFiltrados)
                            {
                                <tr>
                                    <td>@usuario.Email</td>
                                    <td>
                                        @if (usuario.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        @if (usuario.Roles.Count == 0)
                                        {
                                            <span class="text-muted">Sin rol</span>
                                        }
                                        else
                                        {
                                            @foreach (var rol in usuario.Roles)
                                            {
                                                <span class="badge bg-dark me-1">
                                                    @rol
                                                    <button class="btn btn-sm btn-link text-white p-0 ms-1"
                                                            @onclick="() => RemoverRol(usuario, rol)">
                                                        x
                                                    </button>
                                                </span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm"
                                                value="@rolSeleccionado[usuario.Email]"
                                                @onchange="e => rolSeleccionado[usuario.Email] = e.Value!.ToString()!">
                                            @foreach (var rol in rolesDisponibles)
                                            {
                                                <option value="@rol">@rol</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="acciones-col">
                                        <button class="btn btn-sm btn-primary"
                                                @onclick="() => AsignarRol(usuario)">
                                            Asignar
                                        </button>
                                        @if (usuario.Activo)
                                        {
                                            <button class="btn btn-sm btn-warning"
                                                    @onclick="() => CambiarEstado(usuario, false)">
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-success"
                                                    @onclick="() => CambiarEstado(usuario, true)">
                                                Activar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <div class="alert alert-success mt-3">@mensajeExito</div>
            }
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger mt-3">@mensajeError</div>
            }
        </Authorized>
        <NotAuthorized>
            <p class="text-white">No tenés permiso para ver esta página.</p>
        </NotAuthorized>
    </AuthorizeView>
</div>

<style>
    .page-wrapper {
        padding: 1.5rem;
        color: white;
    }

        .page-wrapper h3 {
            font-weight: bold;
            color: white;
        }

    .filtros-row {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        max-width: 600px;
    }

    .buscador {
        flex: 1;
        border-radius: .6rem;
    }

    .filtro-estado {
        width: 160px;
        border-radius: .6rem;
    }

    .tabla-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 5px 20px rgba(0,0,0,.3);
        overflow-x: auto;
    }

        .tabla-card table {
            margin-bottom: 0;
        }

    .acciones-col {
        display: flex;
        gap: .4rem;
        align-items: center;
    }
</style>

@code {
    List<UsuarioRolDTO>? usuarios;
    List<string> rolesDisponibles = Enum.GetNames(typeof(EnumRolSistema)).ToList();
    Dictionary<string, string> rolSeleccionado = new();
    string mensajeExito = "";
    string mensajeError = "";
    string filtro = "";
    string filtroEstado = "todos";

    IEnumerable<UsuarioRolDTO> UsuariosFiltrados => (usuarios ?? new())
        .Where(u => string.IsNullOrEmpty(filtro) || u.Email.Contains(filtro, StringComparison.OrdinalIgnoreCase))
        .Where(u => filtroEstado == "todos" ||
                    (filtroEstado == "activos" && u.Activo) ||
                    (filtroEstado == "inactivos" && !u.Activo));

    protected override async Task OnInitializedAsync()
    {
        await ObtenerUsuarios();
    }

    private async Task ObtenerUsuarios()
    {
        var resp = await http.Get<List<UsuarioRolDTO>>("api/seguridad/usuarios");
        if (!resp.Error)
        {
            usuarios = resp.Respuesta;
            if (usuarios != null)
                foreach (var u in usuarios)
                    if (!rolSeleccionado.ContainsKey(u.Email))
                        rolSeleccionado[u.Email] = rolesDisponibles.First();
        }
        else
        {
            mensajeError = resp.ObtenerError();
        }
    }

    private async Task AsignarRol(UsuarioRolDTO usuario)
    {
        mensajeExito = ""; mensajeError = "";
        var dto = new AsignarRolDTO { Email = usuario.Email, Rol = rolSeleccionado[usuario.Email] };
        var resp = await http.Post<AsignarRolDTO>("api/seguridad/asignar-rol", dto);
        if (!resp.Error) { mensajeExito = $"Rol {dto.Rol} asignado a {dto.Email}."; await ObtenerUsuarios(); }
        else mensajeError = resp.ObtenerError();
    }

    private async Task RemoverRol(UsuarioRolDTO usuario, string rol)
    {
        mensajeExito = ""; mensajeError = "";
        var dto = new AsignarRolDTO { Email = usuario.Email, Rol = rol };
        var resp = await http.Post<AsignarRolDTO>("api/seguridad/remover-rol", dto);
        if (!resp.Error) { mensajeExito = $"Rol {rol} removido de {usuario.Email}."; await ObtenerUsuarios(); }
        else mensajeError = resp.ObtenerError();
    }

    private async Task CambiarEstado(UsuarioRolDTO usuario, bool activar)
    {
        mensajeExito = ""; mensajeError = "";
        var dto = new AsignarRolDTO { Email = usuario.Email, Rol = "" };
        var endpoint = activar ? "api/seguridad/activar-usuario" : "api/seguridad/desactivar-usuario";
        var resp = await http.Post<AsignarRolDTO>(endpoint, dto);
        if (!resp.Error) { mensajeExito = $"Usuario {usuario.Email} {(activar ? "activado" : "desactivado")}."; await ObtenerUsuarios(); }
        else mensajeError = resp.ObtenerError();
    }
}