@if (Mostrar)
{
    <div class="conf-backdrop" @onclick="onCancel"></div>
    <div class="conf-modal" role="dialog" aria-modal="true">
        <div class="conf-header">
            <h5 class="conf-title">@Titulo</h5>
            <button @onclick="onCancel" type="button" class="conf-close" aria-label="Cerrar">&times;</button>
        </div>
        <div class="conf-body">
            @ChildContent
        </div>
        <div class="conf-footer">
            @if (verCancelar)
            {
                <button @onclick="onCancel" type="button" class="conf-btn conf-btn-secondary">
                    @textCancelar
                </button>
            }
            @if (verOk)
            {
                <button @onclick="onConfirm" type="button" class="conf-btn conf-btn-primary">
                    @textOk
                </button>
            }
        </div>
    </div>
}

<style>
    .conf-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1040;
        animation: confFadeIn 0.15s ease-out;
    }

    .conf-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        border-radius: 10px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
        z-index: 1050;
        width: min(420px, 90vw);
        max-height: 85vh;
        overflow-y: auto;
        animation: confPopIn 0.18s ease-out;
    }

    .conf-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #eee;
    }

    .conf-title {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 600;
        color: #222;
    }

    .conf-close {
        border: none;
        background: none;
        font-size: 1.5rem;
        line-height: 1;
        color: #888;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        transition: background 0.15s, color 0.15s;
    }

        .conf-close:hover {
            background: #f2f2f2;
            color: #333;
        }

    .conf-body {
        padding: 1.1rem 1.25rem;
        color: #444;
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .conf-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
        padding: 0.9rem 1.25rem;
        border-top: 1px solid #eee;
    }

    .conf-btn {
        border: none;
        border-radius: 6px;
        padding: 0.5rem 1.1rem;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: filter 0.15s;
    }

        .conf-btn:hover {
            filter: brightness(0.92);
        }

    .conf-btn-secondary {
        background: #eee;
        color: #333;
    }

    .conf-btn-primary {
        background: #1f6feb;
        color: white;
    }

</style>

@code {
    private bool Mostrar = false;
    [Parameter] public string Titulo { get; set; } = "Confirmar";
    [Parameter] public string textOk { get; set; } = "OK";
    [Parameter] public string textCancelar { get; set; } = "Cancelar";

    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback onConfirm { get; set; }

    [Parameter] public bool verOk { get; set; } = true;
    [Parameter] public bool verCancelar { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    public void Ver()
    {
        Mostrar = true;
        StateHasChanged();
    }

    public void Ocultar()
    {
        Mostrar = false;
        StateHasChanged();
    }
}