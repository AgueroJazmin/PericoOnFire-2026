@inherits LayoutComponentBase

<div class="perico-layout">

    <header class="perico-topbar">

        <button class="hamburger" @onclick="ToggleMenu">
            <i class="bi bi-list"></i>
        </button>

        <nav class="perico-menu @(menuAbierto ? "menu-visible" : "")">
            <AuthorizeView>
                <Authorized Context="navContext">
                    @if (navContext.User.IsInRole("Administracion") || navContext.User.IsInRole("Mozo"))
                    {
                        <NavLink href="/" Match="NavLinkMatch.All" class="perico-link" @onclick="CerrarMenu">Mesas</NavLink>
                    }
                    @if (navContext.User.IsInRole("Administracion"))
                    {
                        <NavLink href="/caja" class="perico-link" @onclick="CerrarMenu">Caja</NavLink>
                    }
                    @if (navContext.User.IsInRole("Administracion") || navContext.User.IsInRole("Cocina"))
                    {
                        <NavLink href="/cocina" class="perico-link" @onclick="CerrarMenu">Cocina</NavLink>
                    }
                    @if (navContext.User.IsInRole("Administracion"))
                    {
                        <NavLink href="/barra" class="perico-link" @onclick="CerrarMenu">Barra</NavLink>
                    }
                    @if (navContext.User.IsInRole("Administracion") || navContext.User.IsInRole("Mozo"))
                    {
                        <NavLink href="/pedidos" class="perico-link" @onclick="CerrarMenu">Pedidos</NavLink>
                    }
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="perico-actions">
            <AuthorizeView>
                <NotAuthorized>
                    <NavLink href="/Account/Login" class="perico-link">Login</NavLink>
                </NotAuthorized>
                <Authorized>
                    <!-- Fecha y hora -->
                    <span class="fecha-hora">@fechaHora</span>

                    <span class="usuario-nombre">
                        @(context.User.FindFirst("nombre")?.Value ?? context.User.Identity?.Name)
                    </span>

                    <form action="Account/Logout" method="post" style="display:inline;">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/Account/Login" />
                        <button type="submit" class="btn-salir" title="Finalizar sesión">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </Authorized>
            </AuthorizeView>

            <!-- Config a la izquierda del logo -->
            <NavLink href="/configuracion" class="config-link" title="Configuración">
                <i class="bi bi-gear-fill"></i>
            </NavLink>

            <!-- Logo siempre de fondo-->
            <img src="img/perico-logo.jpg" class="perico-logo" alt="Perico On Fire" />
        </div>
    </header>

    <main class="perico-main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .perico-layout {
        min-height: 100vh;
        background: #1f1f1f;
        padding: 0;
        margin: 0;
    }

    .perico-topbar {
        height: 64px;
        background: #f10b0b;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.2rem;
        width: 100%;
        box-sizing: border-box;
        position: relative;
    }

    /* ── NAV ── */
    .perico-menu {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: nowrap;
    }

    .perico-link {
        color: black;
        text-decoration: none;
        font-weight: bold;
        padding: 0.5rem 0.9rem;
        border-radius: 2rem;
        white-space: nowrap;
        font-size: clamp(0.78rem, 1.2vw, 1rem);
    }

        .perico-link.active {
            background: rgba(0,0,0,.25);
        }

        .perico-link:hover {
            background: rgba(0,0,0,.18);
            color: black;
        }

    .perico-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-shrink: 0;
    }

    .usuario-nombre {
        color: black;
        font-weight: bold;
        font-size: clamp(0.75rem, 1.1vw, 0.95rem);
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn-salir {
        background: none;
        border: none;
        cursor: pointer;
        color: black;
        font-size: 1.4rem;
        padding: 0.3rem 0.4rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        position: relative;
    }

        .btn-salir:hover {
            background: rgba(0,0,0,.18);
        }

        .btn-salir::after {
            content: attr(title);
            position: absolute;
            top: calc(100% + 6px);
            right: 0;
            background: #222;
            color: white;
            font-size: 0.72rem;
            padding: 0.25rem 0.5rem;
            border-radius: 0.4rem;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity .15s;
            z-index: 999;
        }

        .btn-salir:hover::after {
            opacity: 1;
        }

    /* ── CONFIG (separado, a la izquierda del logo) ── */
    .config-link {
        display: flex;
        align-items: center;
        justify-content: center;
        color: black;
        text-decoration: none;
        font-size: 1.4rem;
        padding: 0.3rem 0.4rem;
        border-radius: 50%;
        flex-shrink: 0;
    }

        .config-link:hover {
            background: rgba(0,0,0,.18);
            color: black;
        }

    .perico-logo {
        width: 50px;
        height: 50px;
        object-fit: contain;
        border-radius: 4px;
        flex-shrink: 0;
        pointer-events: none;
    }

    .hamburger {
        display: none;
        background: none;
        border: none;
        color: black;
        font-size: 1.8rem;
        cursor: pointer;
        padding: 0.2rem 0.4rem;
        border-radius: .4rem;
        flex-shrink: 0;
    }

        .hamburger:hover {
            background: rgba(0,0,0,.15);
        }

    .perico-main-content {
        width: 100%;
        min-height: calc(100vh - 64px);
        background: #1f1f1f;
    }

    /* ══ RESPONSIVEE ══ */
    @@media (max-width: 860px) {
        .perico-link {
            padding: 0.5rem 0.6rem;
            font-size: 0.8rem;
        }

        .usuario-nombre {
            max-width: 100px;
        }
    }

    @@media (max-width: 650px) {
        .hamburger {
            display: block;
        }

        .perico-menu {
            display: none;
            position: absolute;
            top: 64px;
            left: 0;
            width: 100%;
            background: #f10b0b;
            flex-direction: column;
            align-items: flex-start;
            padding: .5rem 0 1rem 0;
            z-index: 100;
            box-shadow: 0 4px 12px rgba(0,0,0,.3);
        }

            .perico-menu.menu-visible {
                display: flex;
            }

            .perico-menu .perico-link {
                width: 100%;
                border-radius: 0;
                padding: .75rem 1.5rem;
                font-size: 1rem;
            }

        .usuario-nombre {
            display: none;
        }
    }

    /* ── Fecha y hora── */
    .fecha-hora {
        color: #fff;
        background: #1c1c1c;

        .fecha-hora {
            color: #fff;
            background: #1c1c1c;
            padding: 0.6rem 1rem;
            border-radius: 12px;
            font-weight: bold;
            font-size: clamp(0.9rem, 1vw, 1rem);
            letter-spacing: 1px;
            box-shadow: inset 0 0 10px rgba(255,255,255,0.1), 0 4px 10px rgba(0,0,0,0.3);
        }

        padding: 0.6rem 1rem;
        border-radius: 12px;
        font-weight: bold;
        font-size: clamp(0.9rem, 1vw, 1rem);
        letter-spacing: 1px;
        box-shadow: inset 0 0 10px rgba(255,255,255,0.1), 0 4px 10px rgba(0,0,0,0.3);
    }

    @@media (max-width: 650px) {
        .fecha-hora {
            display: none;
        }
    }

</style>

@code {
    private bool menuAbierto = false;
    private void ToggleMenu() => menuAbierto = !menuAbierto;
    private void CerrarMenu() => menuAbierto = false;

    //fecha y hora
    private string fechaHora = "";
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        ActualizarFechaHora();
        timer = new System.Threading.Timer(_ =>
        {
            ActualizarFechaHora();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void ActualizarFechaHora()
    {
        var ahora = DateTime.Now;
        fechaHora = ahora.ToString("dd/MM/yyyy  HH:mm");
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}