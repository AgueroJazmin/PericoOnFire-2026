@inherits LayoutComponentBase

<div class="perico-layout">

    <header class="perico-topbar">
        <nav class="perico-menu">
            <AuthorizeView>
                <Authorized Context="navContext">
                    @if (navContext.User.IsInRole("Administracion") || navContext.User.IsInRole("Mozo"))
                    {
                        <NavLink href="/" Match="NavLinkMatch.All" class="perico-link">
                            Mesas
                        </NavLink>
                    }
                    @if (navContext.User.IsInRole("Administracion"))
                    {
                        <NavLink href="/caja" class="perico-link">
                            Caja
                        </NavLink>
                    }
                    @if (navContext.User.IsInRole("Administracion") || navContext.User.IsInRole("Cocina"))
                    {
                        <NavLink href="/cocina" class="perico-link">
                            Cocina
                        </NavLink>
                    }
                    @if (navContext.User.IsInRole("Administracion"))
                    {
                        <NavLink href="/barra" class="perico-link">
                            Barra
                        </NavLink>
                    }
                    @if (navContext.User.IsInRole("Administracion") || navContext.User.IsInRole("Mozo"))
                    {
                        <NavLink href="/pedidos" class="perico-link">
                            Pedidos
                        </NavLink>
                    }
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="perico-actions">

            <AuthorizeView>
                <NotAuthorized>
                    <NavLink href="/Account/Login" class="perico-link">
                        Login
                    </NavLink>
                </NotAuthorized>
                <Authorized>
                    <span class="perico-link" style="cursor:default;">
                        @context.User.Identity?.Name
                    </span>
                    <form action="Account/Logout" method="post" style="display:inline;">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/Account/Login" />
                        <button type="submit" class="perico-link" style="border:none; background:none; cursor:pointer;">
                            Logout
                        </button>
                    </form>
                </Authorized>
            </AuthorizeView>

            <img src="img/perico-logo.jpg"
                 class="perico-logo"
                 alt="Perico On Fire" />

            <NavLink href="/configuracion" class="config-link">
                <i class="bi bi-gear-fill"></i>
            </NavLink>


        </div>
    </header>

    <main class="perico-main-content">
        @Body
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .perico-layout {
        min-height: 100vh;
        background: #1f1f1f;
        padding: 0;
        margin: 0;
    }

    .perico-topbar {
        height: 64px;
        background: #f10b0b;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
        width: 100%;
    }

    .perico-menu {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .perico-link {
        color: black;
        text-decoration: none;
        font-weight: bold;
        padding: 0.8rem 1.4rem;
        border-radius: 2rem;
    }

        .perico-link.active {
            background: rgba(0, 0, 0, 0.25);
        }

        .perico-link:hover {
            background: rgba(0, 0, 0, 0.18);
            color: black;
        }

    .perico-actions {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

        .perico-actions a {
            color: black;
            text-decoration: none;
            font-size: 1.6rem;
        }

    .perico-main-content {
        width: 100%;
        min-height: calc(100vh - 64px);
        background: #1f1f1f;
        padding: 1.5rem 2rem;
    }

    .perico-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .perico-logo {
        width: 55px;
        height: 55px;
        object-fit: contain;
    }

    .config-link {
        display: flex;
        align-items: center;
        gap: .5rem;
        text-decoration: none;
        color: black;
        font-weight: bold;
    }

        .config-link i {
            font-size: 1.4rem;
        }
</style>